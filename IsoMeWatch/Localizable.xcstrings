          "stringUnit": {
            "state": "translated",
            "value": "今すぐ同期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步"
          }
        }
      }
    },
    "Nothing to sync.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to sync."
          }
        },
        "es": {
          "stringUnit": {
