    "CAPTURING WATCH PATH": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "CAPTURING WATCH PATH"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ التقاط مسار الساعة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়াচ পাথ ক্যাপচার করা হচ্ছে"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CAPTURANDO LA RUTA DEL RELOJ"
          }
        },
        "fr": {
