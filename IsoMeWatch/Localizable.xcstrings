{
  "sourceLanguage": "en",
  "strings": {
    "Sync Now": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زامن الآن"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই সিঙ্ক করুন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync Now"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchroniser"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी सिंक करें"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ同期"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizuj"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизировать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即同步"
          }
        }
      }
    },
    "Nothing to sync.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء للمزامنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক করার কিছু নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to sync."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada que sincronizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à synchroniser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक को कुछ नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期するものはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic do synchronizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada a sincronizar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нечего синхронизировать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要同步的内容。"
          }
        }
      }
    },
    "iPhone sync is unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة iPhone غير متاحة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone সিঙ্ক উপলব্ধ নেই।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sync is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización con iPhone no disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchro iPhone indisponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone सिंक उपलब्ध नहीं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneと同期できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja z iPhone’em niedostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronização com iPhone indisponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхронизация с iPhone недоступна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 同步不可用。"
          }
        }
      }
    },
    "Connecting to iPhone…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جارٍ الاتصال بـ iPhone…"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone-এ সংযোগ হচ্ছে…"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting to iPhone…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando con iPhone…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à l’iPhone…"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone से जुड़ रहा है…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneに接続中…"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Łączenie z iPhone’em…"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectando ao iPhone…"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение к iPhone…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接 iPhone…"
          }
        }
      }
    },
    "Sync queued. Open Whereday on your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المزامنة في الانتظار. افتح Whereday على iPhone."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক অপেক্ষমাণ। iPhone-এ Whereday খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync queued. Open Whereday on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización en cola. Abre Whereday en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchro en attente. Ouvrez Whereday sur l’iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक कतार में। iPhone पर Whereday खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期を予約しました。iPhoneでWheredayを開いてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja w kolejce. Otwórz Whereday na iPhonie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila. Abra o Whereday no iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Синхр. в очереди. Откройте Whereday на iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入同步队列。请在 iPhone 上打开 Whereday。"
          }
        }
      }
    },
    "Sync failed. Please try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت المزامنة. حاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সিঙ্ক ব্যর্থ। আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync failed. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al sincronizar. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la synchro. Réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिंक विफल। फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期できませんでした。もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja nieudana. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao sincronizar. Tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ошибка синхронизации. Повторите."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步失败。请重试。"
          }
        }
      }
    },
