            "value": "Rien à synchroniser."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期するものはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有需要同步的内容。"
          }
        }
      }
    },
    "iPhone sync is unavailable.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone sync is unavailable."
          }
        },
