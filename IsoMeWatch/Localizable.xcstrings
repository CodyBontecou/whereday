    "Sync queued. Open Whereday on your iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync queued. Open Whereday on your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronización en cola. Abre Whereday en tu iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchro en attente. Ouvrez Whereday sur l’iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期を予約しました。iPhoneでWheredayを開いてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已加入同步队列。请在 iPhone 上打开 Whereday。"
          }
        }
      }
    },
    "Sync failed. Please try again.": {
      "localizations": {
        "en": {
