    "Open Whereday on iPhone to choose or restore a plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح Whereday على iPhone لاختيار خطة أو استعادتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্ল্যান বেছে নিতে বা পুনরুদ্ধার করতে iPhone-এ Whereday খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Whereday on iPhone to choose or restore a plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Whereday en el iPhone para elegir o restaurar un plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Whereday sur l’iPhone pour choisir ou restaurer une formule."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लान चुनने या बहाल करने के लिए iPhone पर Whereday खोलें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランを選択または復元するには、iPhoneでWheredayを開いてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz Whereday na iPhonie, aby wybrać lub przywrócić plan."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o Whereday no iPhone para escolher ou restaurar um plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Whereday на iPhone, чтобы выбрать или восстановить план."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 iPhone 上打开 Whereday 以选择或恢复方案。"
          }
        }
      }
    },
