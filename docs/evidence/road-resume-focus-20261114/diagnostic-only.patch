+package com.bontecou.whereday
+
+import com.bontecou.whereday.domain.RoadTransport
+import kotlin.coroutines.CoroutineContext
+
+/** Test-owned, no UI feedback. One lock serializes UI/render/provider observations;
+ * timestamps denote observation order, not a claim of cross-thread causal ordering.
+ * Only 256 formatted entries survive; no owner/source objects are retained. */
+internal class OrderedMapTrace:MapDiagnosticTrace {
+    private val lock=Any()
+    private val entries=java.util.ArrayDeque<String>(256)
+    private val started=System.nanoTime()
+    private var sequence=0L
+    private var dropped=0L
+    private var dumped=false
+    private var last:String?=null
+    override fun record(stage:String,owner:Any?,related:Any?,value:Int,flags:Int) {
+        synchronized(lock) {
+            val fields="$stage owner=${System.identityHashCode(owner)} related=${System.identityHashCode(related)} value=$value flags=$flags"
+            // Suppress identical adjacent observations, not transitions or provider ordinals.
+            if(last==fields) return
+            last=fields
+            if(entries.size==256) {entries.removeFirst();dropped++}
+            entries.addLast("${++sequence} +${System.nanoTime()-started}ns thread=${Thread.currentThread().id} $fields")
+        }
+    }
+    /** Stamp already exists in the real request context: no added context/wrapper/provider.
+     * Reflection is test-only and reads immutable Stamp fields, not mutable service/cache
+     * internals (which would require an additional production lock acquisition).
+     * Missing pinned implementation fields are explicit gaps, never inferred values. */
+    fun provider(stage:String,context:CoroutineContext,ordinal:Int,transport:RoadTransport,controller:Any) {
+        try {
+            val stamp=context.fold<Any?>(null) {found,element->
+                found ?: element.takeIf {it.javaClass.name.endsWith("RoadDisplayController\$Stamp")}
+            }
+            if(stamp==null) {record("$stage.stamp-unavailable",null,null,ordinal,transport.ordinal);return}
+            fun field(target:Any,name:String):Any?=target.javaClass.getDeclaredField(name).apply {isAccessible=true}.get(target)
+            val session=checkNotNull(field(stamp,"session"))
+            record(stage,stamp,session,ordinal,transport.ordinal)
+            record("provider.identity",field(controller,"provider"),stamp,ordinal,transport.ordinal)
+            record("provider.stamp-epoch",stamp,field(stamp,"epoch"),ordinal,transport.ordinal)
+        } catch(_:Exception) {record("$stage.ownership-unavailable",null,null,ordinal,transport.ordinal)}
+    }
+    fun dumpOnce():String=synchronized(lock) {
+        if(dumped) return@synchronized ""
+        dumped=true
+        "[DEBUG-android-ordered-trace] retained=${entries.size} dropped=$dropped\n"+entries.joinToString("\n")
+    }
+}
