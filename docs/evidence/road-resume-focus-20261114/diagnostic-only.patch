+package com.bontecou.whereday
+
+/** Optional observation only: implementations must be synchronous, bounded, thread-safe,
+ * non-throwing and must not feed UI state back into the producer. Call sites use safe
+ * calls so the default null path allocates no event, lambda or formatted message.
+ * Owners are ephemeral object identities, never coordinates, journal IDs or source text. */
+internal fun interface MapDiagnosticTrace {
+    fun record(stage:String,owner:Any?,related:Any?,value:Int,flags:Int)
+}
+
+/** Bit meanings are stage-specific; only booleans actually read at that stage are emitted. */
+internal object MapTraceFlags {
+    const val VISIBLE=1
+    const val FOCUSED=2
+    const val CONFIGURED=4
+    const val ENABLED=8
+    const val NETWORK=16
+    const val LOADING=32
+    const val CLEARING=64
+    const val UNAVAILABLE=128
+    const val JOURNAL_READY=256
+    const val RESUMED=512
+    const val ALIVE=1024
+    const val MAP_PRESENT=2048
+    const val SELECTED=4096
+    const val SOURCE_PRESENT=8192
+}
