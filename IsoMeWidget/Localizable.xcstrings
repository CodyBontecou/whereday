    "Today's places around a 24-hour dial.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكن اليوم حول قرص 24 ساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "২৪-ঘন্টার ডায়ালে আজকের জায়গা।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's places around a 24-hour dial."
          }
        },
