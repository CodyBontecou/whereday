    "Stop the current Whereday recording from the Live Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف تسجيل Whereday الحالي من النشاط المباشر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইভ অ্যাক্টিভিটি থেকে বর্তমান Whereday রেকর্ডিং থামান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the current Whereday recording from the Live Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén la grabación actual de Whereday desde la Actividad en Vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez l’enregistrement Whereday en cours depuis l’activité en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activity से वर्तमान Whereday रिकॉर्डिंग रोकें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブアクティビティから現在のWheredayの記録を停止します。"
          }
