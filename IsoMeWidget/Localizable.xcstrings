    "Check in at your current place from the Whereday Live Activity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الوصول إلى مكانك الحالي من النشاط المباشر لـ Whereday."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday লাইভ অ্যাক্টিভিটি থেকে আপনার বর্তমান জায়গায় চেক ইন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check in at your current place from the Whereday Live Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra la llegada a tu lugar actual desde la Actividad en Vivo de Whereday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre arrivée au lieu actuel depuis l’activité en direct Whereday."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday Live Activity से अपनी वर्तमान जगह पर चेक इन करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheredayのライブアクティビティから現在地にチェックインします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij wizytę w bieżącym miejscu z poziomu aktywności na żywo Whereday."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça check-in no lugar onde você está pela Atividade ao Vivo do Whereday."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отметьте прибытие в текущее место из Live Activity Whereday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Whereday 实时活动在你当前的地点签到。"
          }
        }
      }
    },
