<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@drawable/widget_background_ink">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/widget_live_dot" android:layout_width="10dp" android:layout_height="10dp"
            android:layout_marginEnd="8dp" android:src="@drawable/widget_live_dot" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:fontFamily="@font/plex_mono_regular" android:textSize="10sp" android:letterSpacing="0.12"
            android:textColor="@color/widget_on_primary_variant" android:text="@string/widget_not_recording" />
    </LinearLayout>
    <Chronometer android:id="@+id/widget_elapsed" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:fontFamily="@font/newsreader" android:textSize="28sp" android:textColor="@color/widget_on_primary" />
    <TextView android:id="@+id/widget_mode" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="@color/widget_on_primary_variant" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <Button android:id="@+id/widget_action" android:layout_width="match_parent" android:layout_height="40dp"
        android:background="@drawable/widget_pill" android:textAllCaps="false" android:textSize="14sp"
        android:textColor="@color/widget_primary" android:text="@string/widget_start" />
</LinearLayout>
