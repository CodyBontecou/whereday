<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetHour">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/plex_mono_regular</item>
        <item name="android:textSize">9sp</item>
        <item name="android:textColor">@color/widget_on_surface_variant</item>
    </style>
    <style name="WidgetStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
    </style>
    <style name="WidgetStatValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/newsreader</item>
        <item name="android:textSize">18sp</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_surface</item>
    </style>
    <style name="WidgetStatLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/plex_mono_regular</item>
        <item name="android:textSize">9sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/widget_on_surface_variant</item>
    </style>
</resources>
