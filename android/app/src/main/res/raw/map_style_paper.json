     "primary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#DDD5C4",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     5,
     1,
     16,
     13,
     20,
     30
    ]
   }
  },
  {
   "id": "road-major",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "motorway",
     "trunk",
     "primary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FFFDF7",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     5,
     0.6,
     16,
     9,
     20,
     24
    ]
   }
  },
  {
   "id": "rail",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "rail",
     "transit"
    ],
    true,
    false
   ],
   "paint": {
    "line-color": "#DDD5C4",
    "line-width": 1,
    "line-dasharray": [
     3,
     3
    ]
   }
  },
  {
   "id": "boundary",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "boundary",
   "filter": [
    "<=",
    [
     "get",
     "admin_level"
    ],
    4
   ],
   "paint": {
    "line-color": "#9A9585",
    "line-width": 0.8,
    "line-dasharray": [
     4,
     3
    ],
    "line-opacity": 0.5
   }
  },
  {
   "id": "water-name",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "water_name",
   "layout": {
    "text-field": [
     "upcase",
     [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 10,
    "text-letter-spacing": 0.2
   },
   "paint": {
    "text-color": "#9A9585",
    "text-halo-color": "#CFD8DF",
    "text-halo-width": 1.2
   }
  },
  {
   "id": "road-name",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "transportation_name",
   "minzoom": 14,
   "layout": {
    "symbol-placement": "line",
    "text-field": [
     "upcase",
     [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 9,
    "text-letter-spacing": 0.15
   },
   "paint": {
    "text-color": "#9A9585",
    "text-halo-color": "#ECE6D8",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "place-district",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "suburb",
      "neighbourhood",
      "quarter",
      "village",
      "hamlet"
     ]
    ]
   ],
   "minzoom": 11,
   "layout": {
    "text-field": [
     "upcase",
     [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 9,
    "text-letter-spacing": 0.22,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#9A9585",
    "text-halo-color": "#ECE6D8",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "place-city",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "city",
      "town"
     ]
    ]
   ],
   "layout": {
    "text-field": [
     "upcase",
     [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": [
     "interpolate",
     [
      "linear"
     ],
     [
      "zoom"
     ],
     4,
     9,
     12,
     13
    ],
    "text-letter-spacing": 0.2,
    "text-max-width": 8
   },
   "paint": {
    "text-color": "#9A9585",
    "text-halo-color": "#ECE6D8",
    "text-halo-width": 1.5
   }
  },
  {
   "id": "place-country",
   "type": "symbol",
   "source": "openmaptiles",
   "source-layer": "place",
   "filter": [
    "==",
    [
     "get",
     "class"
    ],
    "country"
   ],
   "maxzoom": 8,
   "layout": {
    "text-field": [
     "upcase",
     [
      "coalesce",
      [
       "get",
       "name:latin"
      ],
      [
       "get",
       "name"
      ]
     ]
    ],
    "text-font": [
     "Noto Sans Regular"
    ],
    "text-size": 11,
    "text-letter-spacing": 0.25
   },
   "paint": {
    "text-color": "#9A9585",
    "text-halo-color": "#ECE6D8",
    "text-halo-width": 1.5
   }
  }
 ]
}