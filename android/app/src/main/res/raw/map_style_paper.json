     16,
     9,
     20,
     22
    ]
   }
  },
  {
   "id": "road-secondary",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FBF9F4",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     9,
     0.6,
     16,
     6.5,
     20,
