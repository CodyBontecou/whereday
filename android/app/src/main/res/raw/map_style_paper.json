{
 "version": 8,
 "name": "Whereday paper",
 "sources": {
  "openmaptiles": {
   "type": "vector",
   "url": "https://tiles.openfreemap.org/planet",
   "attribution": "<a href=\"https://openfreemap.org\">OpenFreeMap</a> <a href=\"https://www.openmaptiles.org/\">\u00a9 OpenMapTiles</a> Data from <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>"
  }
 },
 "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
 "layers": [
  {
   "id": "background",
   "type": "background",
   "paint": {
    "background-color": "#ECE6D8"
   }
  },
  {
   "id": "landuse-residential",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landuse",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "residential",
      "suburb",
      "neighbourhood"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#E6DFCF",
    "fill-opacity": 0.6
   }
  },
  {
   "id": "park",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "park",
   "paint": {
    "fill-color": "#D6DCC6"
   }
  },
  {
   "id": "landcover-green",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "landcover",
   "filter": [
    "in",
    [
     "get",
     "class"
    ],
    [
     "literal",
     [
      "grass",
      "wood",
      "farmland"
     ]
    ]
   ],
   "paint": {
    "fill-color": "#D6DCC6",
    "fill-opacity": 0.7
   }
  },
  {
   "id": "water",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "water",
   "paint": {
    "fill-color": "#CFD8DF"
   }
  },
  {
   "id": "waterway",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "waterway",
   "paint": {
    "line-color": "#CFD8DF",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     8,
     0.5,
     16,
     3
    ]
   }
  },
  {
   "id": "building",
   "type": "fill",
   "source": "openmaptiles",
   "source-layer": "building",
   "minzoom": 14,
   "paint": {
    "fill-color": "#E6DFCF",
    "fill-outline-color": "#DDD5C4"
   }
  },
  {
   "id": "road-minor",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "minor",
     "service",
     "track",
     "path"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#FBF9F4",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     12,
     0.5,
     16,
     5,
     20,
     14
    ]
   }
  },
  {
   "id": "road-secondary-casing",
   "type": "line",
   "source": "openmaptiles",
   "source-layer": "transportation",
   "filter": [
    "match",
    [
     "get",
     "class"
    ],
    [
     "secondary",
     "tertiary"
    ],
    true,
    false
   ],
   "layout": {
    "line-cap": "round",
    "line-join": "round"
   },
   "paint": {
    "line-color": "#DDD5C4",
    "line-width": [
     "interpolate",
     [
      "exponential",
      1.4
     ],
     [
      "zoom"
     ],
     9,
