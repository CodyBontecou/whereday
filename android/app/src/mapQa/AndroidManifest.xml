<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.bontecou.whereday.automationclient" /></queries>
    <application>
        <activity android:name=".ForwardAutomationProbeActivity" android:exported="true" />
        <!-- QA-only demo journal for screenshots; never part of debug or release builds. -->
        <activity android:name=".DemoJournalActivity" android:exported="true" />
        <activity android:name=".SubscriptionPreviewActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="whereday-qa" android:host="subscription" />
            </intent-filter>
        </activity>
    </application>
</manifest>
