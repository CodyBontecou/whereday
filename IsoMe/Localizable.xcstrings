          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puntos GPS atípicos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Points GPS aberrants"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS आउटलायर"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS の外れ値"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstające punkty GPS"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos GPS fora da curva"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбросы GPS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPS 异常点"
          }
        }
      }
    },
    "Points far from the rest of the route, usually from a weak signal, are left off the map. Turn this on to draw them too.": {
      "comment": "Layer help.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستبعد من الخريطة النقاط البعيدة عن باقي المسار، وغالبًا ما تكون من إشارة ضعيفة. فعّل هذا لرسمها أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পথের বাকি অংশ থেকে দূরের পয়েন্ট, সাধারণত দুর্বল সিগন্যালের কারণে, মানচিত্রে দেখানো হয় না। সেগুলোও আঁকতে এটি চালু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Points far from the rest of the route, usually from a weak signal, are left off the map. Turn this on to draw them too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los puntos alejados del resto de la ruta, normalmente por mala señal, no se dibujan. Actívalo para mostrarlos también."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les points éloignés du reste du trajet, souvent dus à un signal faible, ne sont pas dessinés. Activez ceci pour les afficher aussi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रास्ते से दूर के पॉइंट, जो अक्सर कमज़ोर सिग्नल से आते हैं, मानचित्र पर नहीं दिखते। इन्हें भी दिखाने के लिए इसे चालू करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルートの他の部分から離れた点（多くは電波が弱いとき）は地図に表示しません。オンにすると表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkty daleko od reszty trasy, zwykle przez słaby sygnał, nie są rysowane. Włącz, aby je też pokazać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pontos longe do resto do trajeto, geralmente por sinal fraco, ficam fora do mapa. Ative para mostrá-los também."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Точки вдали от остального маршрута, обычно из-за слабого сигнала, не показываются. Включите, чтобы рисовать и их."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远离路线其余部分的点（通常因信号弱）不会显示。打开此项也会绘制它们。"
          }
        }
      }
    },
