    "Whereday is not currently recording an outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday لا يقوم حاليًا بتسجيل نزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday বর্তমানে একটি আউটিং রেকর্ড করছে না।"
          }
        },
        "en": {
