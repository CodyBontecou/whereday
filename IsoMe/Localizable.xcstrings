    "Places next door can be detected as one stop. Choose when you moved on and where you went next." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تُكتشف الأماكن المتجاورة كمحطة واحدة. اختر متى انتقلت وإلى أين ذهبت بعد ذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পাশাপাশি জায়গাগুলো একটি স্টপ হিসেবে শনাক্ত হতে পারে। কখন সরে গেলেন এবং এরপর কোথায় গেলেন তা বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Places next door can be detected as one stop. Choose when you moved on and where you went next."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los lugares contiguos pueden detectarse como una sola parada. Elige cuándo te fuiste y adónde fuiste después."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des lieux voisins peuvent être détectés comme un seul arrêt. Choisissez quand vous êtes reparti et où vous êtes allé ensuite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पास-पास की जगहें एक ही पड़ाव के रूप में पहचानी जा सकती हैं। चुनें कि आप कब आगे बढ़े और आगे कहाँ गए।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隣り合う場所は1つの立ち寄りとして検出されることがあります。移動した時刻と次に行った場所を選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sąsiednie miejsca mogą zostać wykryte jako jeden postój. Wybierz, kiedy przeszedłeś dalej i dokąd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares vizinhos podem ser detectados como uma única parada. Escolha quando você saiu e para onde foi em seguida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Соседние места могут определиться как одна остановка. Укажите, когда вы ушли и куда направились дальше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相邻的地点可能被识别为一次停留。请选择你离开的时间以及接下来去了哪里。"
          }
        }
      }
    },
