    "No visits or movement sessions were found for %@. Pick another day or enable inferred movement for older GPS history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على زيارات أو جلسات حركة لـ %@ . اختر يومًا آخر أو قم بتمكين الحركة المستنتجة لسجل GPS الأقدم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ এর জন্য কোনো ভিজিট বা আন্দোলন সেশন পাওয়া যায়নি। অন্য একটি দিন বেছে নিন বা পুরানো GPS ইতিহাসের জন্য অনুমানকৃত আন্দোলন সক্ষম করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No visits or movement sessions were found for %@. Pick another day or enable inferred movement for older GPS history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron visitas ni sesiones de movimiento para %@ . Elija otro día o habilite el movimiento inferido para el historial GPS más antiguo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune visite ou séance de mouvement n'a été trouvée pour %@ . Choisissez un autre jour ou activez les mouvements déduits pour un historique GPS plus ancien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ के लिए कोई मुलाक़ात या आंदोलन सत्र नहीं मिला। कोई अन्य दिन चुनें या पुराने GPS इतिहास के लिए अनुमानित गतिविधि सक्षम करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の訪問または移動セッションは見つかりませんでした。別の日を選択するか、古いGPS履歴の推定移動を有効にします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono wizyt ani przemieszczeń dla %@. Wybierz inny dzień lub włącz szacowanie przemieszczeń dla starszej historii GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma visita ou sessão de movimento foi encontrada para %@ . Escolha outro dia ou ative o movimento inferido para o histórico GPS mais antigo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для %@ не обнаружено посещений или сеансов движения. Выберите другой день или включите предполагаемое движение для более старой истории GPS ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到%@访问或移动会话。选择另一天或启用旧GPS历史记录的推断运动。"
          }
        }
      }
    },
    "No visits were detected during this outing.": {
      "localizations": {
        "ar": {
