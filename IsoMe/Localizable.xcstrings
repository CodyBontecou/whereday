    "Send location data to an external API or self-hosted server.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إرسال بيانات الموقع إلى واجهة برمجة API خارجية أو خادم مستضاف ذاتيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি বহিরাগত API বা স্ব-হোস্টেড সার্ভারে অবস্থান ডেটা পাঠান।"
          }
