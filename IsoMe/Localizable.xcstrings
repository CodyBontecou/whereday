    "Overlapping Visit" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "زيارة متداخلة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ওভারল্যাপ করা ভিজিট"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overlapping Visit"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita superpuesta"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visite simultanée"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ओवरलैप होती विज़िट"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪問時間の重複"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakładające się wizyty"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita sobreposta"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересечение посещений"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到访时间重叠"
          }
        }
      }
    },
    "Overlaps %@ by %lld min (from %@). Saving will start that visit at %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتداخل مع %@ بمقدار %lld د (من %@). سيؤدي الحفظ إلى بدء تلك الزيارة في %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এর সঙ্গে %lld মিনিট ওভারল্যাপ করে (%@ থেকে)। সংরক্ষণ করলে সেই ভিজিট %@-এ শুরু হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overlaps %@ by %lld min (from %@). Saving will start that visit at %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solapa con %@ durante %lld min (desde las %@). Al guardar, esa visita empezará a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chevauche %@ de %lld min (à partir de %@). L’enregistrement fera commencer cette visite à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से %lld मिनट ओवरलैप (%@ से)। सहेजने पर वह विज़िट %@ से शुरू होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@と%lld分重なっています（%@から）。保存すると、その訪問は%@に開始します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się na %@ o %lld min (od %@). Zapisanie rozpocznie tamtą wizytę o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepõe %@ em %lld min (a partir de %@). Ao salvar, essa visita começará às %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересекается с посещением %@ на %lld мин (с %@). При сохранении оно начнётся в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 %@ 重叠 %lld 分钟（从 %@ 起）。保存后，该到访将从 %@ 开始。"
          }
        }
      }
    },
    "Overlaps %@ by %lld min (until %@). Saving will end that visit at %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتداخل مع %@ بمقدار %lld د (حتى %@). سيؤدي الحفظ إلى إنهاء تلك الزيارة في %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এর সঙ্গে %lld মিনিট ওভারল্যাপ করে (%@ পর্যন্ত)। সংরক্ষণ করলে সেই ভিজিট %@-এ শেষ হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overlaps %@ by %lld min (until %@). Saving will end that visit at %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solapa con %@ durante %lld min (hasta las %@). Al guardar, esa visita terminará a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chevauche %@ de %lld min (jusqu’à %@). L’enregistrement terminera cette visite à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से %lld मिनट ओवरलैप (%@ तक)। सहेजने पर वह विज़िट %@ पर समाप्त होगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@と%lld分重なっています（%@まで）。保存すると、その訪問は%@に終了します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się na %@ o %lld min (do %@). Zapisanie zakończy tamtą wizytę o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepõe %@ em %lld min (até %@). Ao salvar, essa visita terminará às %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересекается с посещением %@ на %lld мин (до %@). При сохранении оно завершится в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与 %@ 重叠 %lld 分钟（直到 %@）。保存后，该到访将在 %@ 结束。"
          }
        }
      }
    },
    "Overlaps %@, which is still in progress. Saving will end that visit at %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتداخل مع %@، الذي لا يزال جاريًا. سيؤدي الحفظ إلى إنهاء تلك الزيارة في %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@-এর সঙ্গে ওভারল্যাপ করে, যা এখনো চলছে। সংরক্ষণ করলে সেই ভিজিট %@-এ শেষ হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overlaps %@, which is still in progress. Saving will end that visit at %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se solapa con %@, que sigue en curso. Al guardar, esa visita terminará a las %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chevauche %@, toujours en cours. L’enregistrement terminera cette visite à %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ से ओवरलैप होता है, जो अभी जारी है। सहेजने पर वह विज़िट %@ पर समाप्त हो जाएगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "進行中の%@と重なっています。保存すると、その訪問は%@に終了します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada się na %@ (wizyta wciąż trwa). Zapisanie zakończy tamtą wizytę o %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepõe %@, que ainda está em andamento. Ao salvar, essa visita terminará às %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пересекается с посещением %@, которое ещё продолжается. При сохранении оно завершится в %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与仍在进行中的 %@ 重叠。保存后，该到访将在 %@ 结束。"
          }
        }
      }
    },
    "Overlays the route for the tracking session that is currently running, separate from the historical date-range path." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتراكب المسار لجلسة التتبع الجاري تشغيلها حاليًا، بشكل منفصل عن مسار النطاق الزمني التاريخي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্র্যাকিং সেশনের জন্য রুট ওভারলে করে যা বর্তমানে চলছে, ঐতিহাসিক তারিখ-পরিসরের পথ থেকে আলাদা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overlays the route for the tracking session that is currently running, separate from the historical date-range path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superpone la ruta de la sesión de seguimiento que se está ejecutando actualmente, separada de la ruta histórica del rango de fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superpose l'itinéraire de la session de suivi en cours d'exécution, distinct du chemin de plage de dates historique."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐतिहासिक दिनांक-सीमा पथ से अलग, वर्तमान में चल रहे ट्रैकिंग सत्र के लिए रूट को ओवरले करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "履歴の日付範囲パスとは別に、現在実行中の追跡セッションのルートをオーバーレイします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakłada trasę aktualnie uruchomionej sesji śledzenia, oddzielnie od historycznej ścieżki zakresu dat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sobrepõe a rota da sessão de rastreamento que está em execução no momento, separada do caminho histórico do intervalo de datas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Накладывает маршрут текущего сеанса отслеживания отдельно от исторического пути диапазона дат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "覆盖当前正在运行的跟踪会话的路线，与历史日期范围路径分开。"
          }
        }
      }
    },
