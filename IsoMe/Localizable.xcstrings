    "Pins the stop where the map preview is centred.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يثبّت التوقف حيث يتمركز معاينة الخريطة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pins the stop where the map preview is centred."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija la parada donde está centrada la vista previa del mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Place l’arrêt au centre de l’aperçu de la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図プレビューの中心に立ち寄りのピンを置きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
