        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten format trasy eksportuje punkty trasy GPS podróży. Notatki i wiersze wizyt nie są reprezentowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este formato de rota exporta os pontos da rota GPS do passeio. As notas e as linhas de visita não são representadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот формат маршрута экспортирует точки GPS маршрута прогулки. Примечания и строки посещений не отображаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
