          }
        }
      }
    },
    "Previewing the %lld most recent file%@ with data. Export will process every selected file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معاينة أحدث ملف %1$lld %2$@ مع البيانات. سيقوم التصدير بمعالجة كل ملف محدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডেটা সহ %1$lld অতি সাম্প্রতিক ফাইল %2$@ এর পূর্বরূপ দেখা হচ্ছে৷ রপ্তানি প্রতিটি নির্বাচিত ফাইল প্রক্রিয়া করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Previewing the %1$lld most recent file%2$@ with data. Export will process every selected file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa del %1$lld archivo más reciente %2$@ con datos. La exportación procesará cada archivo seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu du fichier %1$lld le plus récent %2$@ avec les données. L'exportation traitera chaque fichier sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा के साथ %1$lld नवीनतम फ़ाइल %2$@ का पूर्वावलोकन किया जा रहा है। निर्यात प्रत्येक चयनित फ़ाइल को संसाधित करेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld最新ファイル%2$@データとともにプレビューしています。エクスポートでは、選択したすべてのファイルが処理されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd ostatnich plików z danymi: %1$lld%2$@. Eksport obejmie każdy wybrany plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizando o arquivo %1$lld mais recente %2$@ com dados. A exportação processará todos os arquivos selecionados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительный просмотр %1$lld самого последнего файла %2$@ с данными. Экспорт будет обрабатывать каждый выбранный файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在预览%1$lld包含数据的最新文件%2$@ 。导出将处理每个选定的文件。"
          }
        }
      }
    },
