    "Data is only sent when you tap \"Send Now\" below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم إرسال البيانات إلا عند النقر على \"إرسال الآن\" أدناه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি নীচে \"এখনই পাঠান\" ট্যাপ করলেই ডেটা পাঠানো হয়৷"
          }
        },
