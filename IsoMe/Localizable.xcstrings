    "Select one or many formats. OwnTracks and Overland only carry GPS fixes; other selected formats use the selected data type." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد تنسيقًا واحدًا أو أكثر. يحمل OwnTracks و Overland قراءات GPS فقط؛ تستخدم التنسيقات الأخرى المحددة نوع البيانات المحدد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক বা একাধিক ফরম্যাট নির্বাচন করুন। OwnTracks এবং Overland শুধুমাত্র GPS ফিক্স বহন করে; অন্যান্য নির্বাচিত বিন্যাস নির্বাচিত ডেটা প্রকার ব্যবহার করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select one or many formats. OwnTracks and Overland only carry GPS fixes; other selected formats use the selected data type."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione uno o varios formatos. OwnTracks y Overland solo contienen posiciones GPS; los demás formatos seleccionados utilizan el tipo de datos seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un ou plusieurs formats. OwnTracks et Overland ne proposent que des repères GPS ; les autres formats sélectionnés utilisent le type de données sélectionné."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक या अनेक प्रारूप चुनें. OwnTracks और Overland केवल GPS सुधार होते हैं; अन्य चयनित प्रारूप चयनित डेटा प्रकार का उपयोग करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つまたは複数の形式を選択します。OwnTracksとOverlandにはGPS測位データのみが含まれます。選択した他の形式では、選択したデータ型が使用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz jeden lub więcej formatów. OwnTracks i Overland zawierają tylko pozycje GPS; pozostałe formaty używają wybranego typu danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um ou vários formatos. OwnTracks e Overland levam apenas pontos GPS; os outros formatos selecionados usam o tipo de dados selecionado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите один или несколько форматов. OwnTracks и Overland содержат только координаты GPS ; другие выбранные форматы используют выбранный тип данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种或多种格式。 OwnTracks和Overland仅提供GPS定位；其他选定的格式使用选定的数据类型。"
          }
        }
      }
    },
    "Select one or many formats. OwnTracks and Overland outing exports contain the outing route's GPS fixes; visit rows and outing notes are not represented." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد تنسيقًا واحدًا أو أكثر. تحتوي ملفات OwnTracks وOverland المصدّرة للنزهات على قراءات GPS لمسار النزهة؛ لا يتم تمثيل صفوف الزيارة وملاحظات النزهة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক বা একাধিক ফরম্যাট নির্বাচন করুন। OwnTracks এবং Overland আউটিং এক্সপোর্ট আউটিং রুট এর GPS ফিক্স ধারণ করে; ভিজিট সারি এবং আউটিং নোট প্রতিনিধিত্ব করা হয় না."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select one or many formats. OwnTracks and Overland outing exports contain the outing route's GPS fixes; visit rows and outing notes are not represented."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleccione uno o varios formatos. Las exportaciones de salidas OwnTracks y Overland contienen las posiciones GPS de la ruta de salida; Las filas de visitas y las notas de salidas no están representadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez un ou plusieurs formats. Les exportations de sorties OwnTracks et Overland contiennent les coordonnées GPS de l'itinéraire de sortie ; les lignes de visite et les notes de sortie ne sont pas représentées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक या अनेक प्रारूप चुनें. OwnTracks और Overland आउटिंग निर्यात में आउटिंग रूट के GPS फिक्स शामिल हैं; विज़िट पंक्तियाँ और आउटिंग नोट्स प्रस्तुत नहीं किए गए हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1つまたは複数の形式を選択します。OwnTracksとOverlandの外出エクスポートには、外出ルートのGPS測位データが含まれます。訪問行や外出メモは含まれません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz jeden lub więcej formatów. Eksporty podróży OwnTracks i Overland zawierają pozycje GPS z trasy, bez wizyt i notatek."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione um ou vários formatos. As exportações de passeios OwnTracks e Overland contêm os pontos GPS do trajeto do passeio; as linhas de visita e as notas do passeio não são representadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите один или несколько форматов. Экспорт прогулок в OwnTracks и Overland содержит GPS-координаты маршрута прогулки; строки посещений и заметки о прогулках не включаются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择一种或多种格式。OwnTracks 和 Overland 出行导出包含出行路线的 GPS 定位点；不包含到访行和出行备注。"
          }
        }
      }
    },
