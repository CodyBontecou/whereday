          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminará la ubicación reutilizable. Tus visitas pasadas se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lieu réutilisable sera supprimé. Vos visites passées sont conservées."
