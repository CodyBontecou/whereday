    "New Yesterday filters make it easier to review or export the previous day’s visits and tracks.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسهل مرشحات الأمس الجديدة مراجعة أو تصدير زيارات ومسارات اليوم السابق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নতুন গতকালের ফিল্টারগুলি আগের দিনের ভিজিট এবং ট্র্যাকগুলি পর্যালোচনা বা রপ্তানি করা সহজ করে তোলে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New Yesterday filters make it easier to review or export the previous day’s visits and tracks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nuevos filtros de Ayer facilitan la revisión o exportación de las visitas y recorridos del día anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nouveaux filtres Hier facilitent la révision ou l'exportation des visites et des parcours de la veille."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नए कल के फ़िल्टर पिछले दिन की विज़िट और ट्रैक की समीक्षा या निर्यात करना आसान बनाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい昨日フィルターを使用すると、前日の訪問と追跡を簡単に確認またはエクスポートできるようになります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe filtry „Wczoraj” ułatwiają przeglądanie lub eksportowanie wizyt i śladów z poprzedniego dnia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os novos filtros de Ontem facilitam a revisão ou exportação das visitas e dos rastreamentos do dia anterior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новые фильтры «Вчера» упрощают просмотр или экспорт посещений и треков предыдущего дня."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新的昨天过滤器可以更轻松地查看或导出前一天的访问和跟踪。"
          }
        }
      }
    },
