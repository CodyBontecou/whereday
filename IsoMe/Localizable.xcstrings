    },
    "The tracker is free. Export CSV with your existing lifetime export purchase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التتبع مجاني. صدّر CSV بشراء التصدير مدى الحياة الذي تملكه."
