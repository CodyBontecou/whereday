{
  "sourceLanguage": "en",
  "strings": {
    "Day & recording options": {
      "comment": "Field notes journal interface heading or recording-options disclosure label.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خيارات اليوم والتسجيل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দিন ও রেকর্ডিংয়ের বিকল্প"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day & recording options"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opciones de día y grabación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Options du jour et d’enregistrement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन और रिकॉर्डिंग के विकल्प"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付と記録のオプション"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcje dnia i rejestrowania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opções de dia e gravação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки дня и записи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期与记录选项"
          }
        }
      }
    },
    "A life of places.\nYours to keep.": {
      "comment": "Illustrated paywall headline. Warm travel-journal voice; places become a personal history to keep. Adapt the line break naturally.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "أماكن تعيشها.\nذكريات تحتفظ بها."}},
        "bn": {"stringUnit": {"state": "translated", "value": "জীবন জুড়ে কত জায়গা।\nস্মৃতি থাকুক আপনার কাছে।"}},
        "en": {"stringUnit": {"state": "translated", "value": "A life of places.\nYours to keep."}},
        "es": {"stringUnit": {"state": "translated", "value": "Una vida de lugares.\nUna historia que conservar."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Tous ces lieux.\nVotre histoire à garder."}},
        "hi": {"stringUnit": {"state": "translated", "value": "जगहों से बनी ज़िंदगी।\nसहेजें अपनी कहानी।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "訪れた場所が、\nあなたの物語に。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Życie pełne miejsc.\nHistoria, która zostaje."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Lugares que marcam.\nHistórias para guardar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Места вашей жизни.\nИстория, которая с вами."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "走过的地方，\n都是你的故事。"}}
      }
    },
    "Your Whereday plan": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "خطتك في Whereday"}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার Whereday প্ল্যান"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your Whereday plan"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tu plan de Whereday"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre formule Whereday"}},
        "hi": {"stringUnit": {"state": "translated", "value": "आपका Whereday प्लान"}},
        "ja": {"stringUnit": {"state": "translated", "value": "ご利用中のWheredayプラン"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Twój plan Whereday"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu plano Whereday"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ваш план Whereday"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的 Whereday 方案"}}
      }
    },
    "Manage your purchase and Family Sharing.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "أدر مشترياتك والمشاركة العائلية."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার কেনাকাটা ও ফ্যামিলি শেয়ারিং পরিচালনা করুন।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Manage your purchase and Family Sharing."}},
        "es": {"stringUnit": {"state": "translated", "value": "Gestiona tu compra y En familia."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gérez votre achat et le partage familial."}},
        "hi": {"stringUnit": {"state": "translated", "value": "अपनी खरीदारी और फ़ैमिली शेयरिंग प्रबंधित करें।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "購入内容とファミリー共有を管理できます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zarządzaj zakupem i Chmurą rodzinną."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Gerencie sua compra e o Compartilhamento Familiar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Управляйте покупкой и Семейным доступом."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "管理购买项目和家人共享。"}}
      }
    },
    "Track your days. Revisit your places.\nKeep your history private and on-device.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "سجّل أيامك وعُد إلى أماكنك.\nتبقى سجلاتك خاصة وعلى جهازك."}},
        "bn": {"stringUnit": {"state": "translated", "value": "দিনের চলাফেরা লিখে রাখুন। ফিরে দেখুন আপনার জায়গাগুলো।\nআপনার ইতিহাস ব্যক্তিগত, আপনার ডিভাইসেই।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Track your days. Revisit your places.\nKeep your history private and on-device."}},
        "es": {"stringUnit": {"state": "translated", "value": "Registra tus días. Vuelve a tus lugares.\nTu historial, privado y en tu dispositivo."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Gardez une trace de vos journées. Retrouvez vos lieux.\nVotre historique reste privé, sur votre appareil."}},
        "hi": {"stringUnit": {"state": "translated", "value": "अपने दिन दर्ज करें। अपनी जगहों को फिर देखें।\nआपका इतिहास निजी है, आपके डिवाइस पर ही।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "日々を記録し、訪れた場所を振り返る。\n履歴はデバイスの中に、あなただけのもの。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zapisuj swoje dni. Wracaj do swoich miejsc.\nTwoja historia jest prywatna i zostaje na urządzeniu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Registre seus dias. Relembre seus lugares.\nSeu histórico fica privado, no seu dispositivo."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Записывайте дни. Возвращайтесь к своим местам.\nВаша история конфиденциальна и хранится на устройстве."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "记录日常，重温足迹。\n历史记录保存在设备上，私密由你掌握。"}}
      }
    },
    "Add Apple Family Sharing to your lifetime purchase.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "أضف المشاركة العائلية من Apple إلى شرائك مدى الحياة."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার আজীবনের কেনাকাটায় Apple ফ্যামিলি শেয়ারিং যোগ করুন।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Add Apple Family Sharing to your lifetime purchase."}},
        "es": {"stringUnit": {"state": "translated", "value": "Añade En familia de Apple a tu compra de por vida."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Ajoutez le partage familial Apple à votre achat à vie."}},
        "hi": {"stringUnit": {"state": "translated", "value": "अपनी आजीवन खरीदारी में Apple फ़ैमिली शेयरिंग जोड़ें।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "買い切りプランにAppleのファミリー共有を追加できます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Dodaj Chmurę rodzinną Apple do swojego dożywotniego zakupu."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Adicione o Compartilhamento Familiar da Apple à sua compra vitalícia."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Добавьте Семейный доступ Apple к своей бессрочной покупке."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "为终身版购买项目添加 Apple 家人共享。"}}
      }
    },
    "Share with up to 5 family members using Apple Family Sharing": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "شارك مع ما يصل إلى ٥ من أفراد العائلة عبر المشاركة العائلية من Apple"}},
        "bn": {"stringUnit": {"state": "translated", "value": "Apple ফ্যামিলি শেয়ারিং দিয়ে পরিবারের সর্বোচ্চ ৫ জন সদস্যের সঙ্গে শেয়ার করুন"}},
        "en": {"stringUnit": {"state": "translated", "value": "Share with up to 5 family members using Apple Family Sharing"}},
        "es": {"stringUnit": {"state": "translated", "value": "Comparte con hasta 5 familiares mediante En familia de Apple"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Partagez avec jusqu’à 5 membres de votre famille grâce au partage familial Apple"}},
        "hi": {"stringUnit": {"state": "translated", "value": "Apple फ़ैमिली शेयरिंग से परिवार के अधिकतम 5 सदस्यों के साथ साझा करें"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Appleのファミリー共有で最大5人の家族と共有"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Udostępnij maksymalnie 5 członkom rodziny przez Chmurę rodzinną Apple"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Compartilhe com até 5 familiares pelo Compartilhamento Familiar da Apple"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Делитесь через Семейный доступ Apple не более чем с 5 членами семьи"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "通过 Apple 家人共享，与最多 5 位家庭成员共享"}}
      }
    },
    "Your existing records remain available to view and export if your subscription ends.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تبقى سجلاتك الحالية متاحة للعرض والتصدير إذا انتهى اشتراكك."}},
        "bn": {"stringUnit": {"state": "translated", "value": "সাবস্ক্রিপশন শেষ হলেও আপনার আগের রেকর্ডগুলো দেখা ও এক্সপোর্ট করা যাবে।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your existing records remain available to view and export if your subscription ends."}},
        "es": {"stringUnit": {"state": "translated", "value": "Si tu suscripción termina, podrás seguir viendo y exportando tus registros existentes."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Si votre abonnement prend fin, vos données existantes restent consultables et exportables."}},
        "hi": {"stringUnit": {"state": "translated", "value": "सदस्यता समाप्त होने पर भी आपके मौजूदा रिकॉर्ड देखने और एक्सपोर्ट करने के लिए उपलब्ध रहेंगे।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "サブスクリプションが終了しても、これまでの記録は閲覧・書き出しができます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Po zakończeniu subskrypcji nadal możesz przeglądać i eksportować dotychczasowe zapisy."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Se sua assinatura terminar, seus registros existentes continuarão disponíveis para consulta e exportação."}},
        "ru": {"stringUnit": {"state": "translated", "value": "После окончания подписки ваши существующие записи останутся доступны для просмотра и экспорта."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "即使订阅结束，你仍可查看和导出现有记录。"}}
      }
    },
    "No active purchase found. For a Family plan, check your Family Sharing settings.": {
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "لم يتم العثور على شراء نشط. إذا كانت لديك خطة عائلية، فتحقق من إعدادات المشاركة العائلية."}},
        "bn": {"stringUnit": {"state": "translated", "value": "কোনো সক্রিয় কেনাকাটা পাওয়া যায়নি। পারিবারিক প্ল্যানের জন্য ফ্যামিলি শেয়ারিং সেটিংস দেখুন।"}},
        "en": {"stringUnit": {"state": "translated", "value": "No active purchase found. For a Family plan, check your Family Sharing settings."}},
        "es": {"stringUnit": {"state": "translated", "value": "No se ha encontrado ninguna compra activa. Si tienes un plan Familiar, revisa los ajustes de En familia."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Aucun achat actif trouvé. Pour une formule Famille, vérifiez vos réglages de partage familial."}},
        "hi": {"stringUnit": {"state": "translated", "value": "कोई सक्रिय खरीदारी नहीं मिली। पारिवारिक प्लान के लिए अपनी फ़ैमिली शेयरिंग सेटिंग्स जाँचें।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "有効な購入が見つかりませんでした。ファミリープランの場合は、ファミリー共有の設定をご確認ください。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Nie znaleziono aktywnego zakupu. W przypadku planu rodzinnego sprawdź ustawienia Chmury rodzinnej."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Nenhuma compra ativa encontrada. Para um plano Familiar, verifique os ajustes do Compartilhamento Familiar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Активная покупка не найдена. Для семейного плана проверьте настройки Семейного доступа."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "未找到有效购买。如果使用家庭方案，请检查家人共享设置。"}}
      }
    },
    "Cancel in Apple subscription settings at least 24 hours before renewal.": {
      "comment": "Subscription cancellation instruction. Preserve Apple subscription settings and the at-least-24-hours-before-renewal requirement.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "ألغِ الاشتراك من إعدادات اشتراكات Apple قبل موعد التجديد بـ٢٤ ساعة على الأقل."}},
        "bn": {"stringUnit": {"state": "translated", "value": "নবায়নের অন্তত ২৪ ঘণ্টা আগে Apple-এর সাবস্ক্রিপশন সেটিংস থেকে বাতিল করুন।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Cancel in Apple subscription settings at least 24 hours before renewal."}},
        "es": {"stringUnit": {"state": "translated", "value": "Cancela en los ajustes de suscripciones de Apple al menos 24 horas antes de la renovación."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Annulez dans les réglages des abonnements Apple au moins 24 heures avant le renouvellement."}},
        "hi": {"stringUnit": {"state": "translated", "value": "नवीनीकरण से कम से कम 24 घंटे पहले Apple की सदस्यता सेटिंग्स में रद्द करें।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "更新の24時間前までに、Appleのサブスクリプション設定でキャンセルしてください。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Anuluj w ustawieniach subskrypcji Apple co najmniej 24 godziny przed odnowieniem."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cancele nos ajustes de assinaturas da Apple pelo menos 24 horas antes da renovação."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Отмените подписку в настройках подписок Apple не менее чем за 24 часа до продления."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "请至少在续订前 24 小时于 Apple 订阅设置中取消。"}}
      }
    },
    "%@ charged once to your Apple Account. No subscription.": {
      "comment": "Lifetime or Family-upgrade charge. %@ is StoreKit's localized price, inserted unchanged. One payment, no recurring subscription.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تُخصم %@ مرة واحدة من حساب Apple الخاص بك. دون اشتراك."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার Apple অ্যাকাউন্টে একবারই %@ চার্জ করা হবে। কোনো সাবস্ক্রিপশন নেই।"}},
        "en": {"stringUnit": {"state": "translated", "value": "%@ charged once to your Apple Account. No subscription."}},
        "es": {"stringUnit": {"state": "translated", "value": "Se cargarán %@ una sola vez a tu cuenta de Apple. Sin suscripción."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Un paiement unique de %@ sera débité de votre compte Apple. Sans abonnement."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आपके Apple खाते से एक बार %@ लिए जाएँगे। कोई सदस्यता नहीं।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "Apple Accountに%@を一度だけ請求します。サブスクリプションではありません。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Jednorazowa opłata %@ zostanie pobrana z Twojego konta Apple. Bez subskrypcji."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cobrança única de %@ na sua Conta Apple. Sem assinatura."}},
        "ru": {"stringUnit": {"state": "translated", "value": "С вашего Аккаунта Apple однократно спишется %@. Без подписки."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "将向你的 Apple 账户一次性收取 %@。无需订阅。"}}
      }
    },
    "%@ per week, automatically renewing until canceled.": {
      "comment": "Weekly subscription with no trial. %@ is StoreKit's localized price; preserve weekly billing and automatic renewal until cancellation.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "%@ أسبوعيًا، مع تجديد تلقائي حتى الإلغاء."}},
        "bn": {"stringUnit": {"state": "translated", "value": "প্রতি সপ্তাহে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"}},
        "en": {"stringUnit": {"state": "translated", "value": "%@ per week, automatically renewing until canceled."}},
        "es": {"stringUnit": {"state": "translated", "value": "%@ por semana, con renovación automática hasta que canceles."}},
        "fr": {"stringUnit": {"state": "translated", "value": "%@ par semaine, avec renouvellement automatique jusqu’à résiliation."}},
        "hi": {"stringUnit": {"state": "translated", "value": "प्रति सप्ताह %@, रद्द करने तक अपने-आप नवीनीकरण होगा।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "週額%@。キャンセルするまで自動更新されます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "%@ za tydzień, z automatycznym odnawianiem do czasu anulowania."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "%@ por semana, com renovação automática até o cancelamento."}},
        "ru": {"stringUnit": {"state": "translated", "value": "%@ в неделю с автоматическим продлением до отмены."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "每周 %@，自动续订，直至取消。"}}
      }
    },
    "%@ per year, automatically renewing until canceled.": {
      "comment": "Yearly subscription with no trial. %@ is StoreKit's localized price; preserve annual billing and automatic renewal until cancellation.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "%@ سنويًا، مع تجديد تلقائي حتى الإلغاء."}},
        "bn": {"stringUnit": {"state": "translated", "value": "প্রতি বছরে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"}},
        "en": {"stringUnit": {"state": "translated", "value": "%@ per year, automatically renewing until canceled."}},
