    "Stay somewhere for a few minutes and it becomes your first stop. Moves between stops fill the ring as you go.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابقَ في مكان ما بضع دقائق ليصبح أول توقف لك. ويملأ التنقّل بين التوقفات الحلقة أثناء يومك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay somewhere for a few minutes and it becomes your first stop. Moves between stops fill the ring as you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quédate en un sitio unos minutos y se convertirá en tu primera parada. Los trayectos entre paradas van llenando el anillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez quelque part quelques minutes et ce sera votre premier arrêt. Les déplacements entre les arrêts remplissent l’anneau au fil de la journée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どこかに数分間とどまると、最初の立ち寄りになります。立ち寄りの間の移動が、リングを少しずつ埋めていきます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fique em algum lugar por alguns minutos e ele vira sua primeira parada. Os deslocamentos entre paradas preenchem o anel conforme você anda."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某处停留几分钟，就会成为你的第一个停留点。停留点之间的移动会随行程逐渐填满圆环。"
          }
        }
      }
    },
    "Save Home so days start there": {
      "localizations": {
        "ar": {
