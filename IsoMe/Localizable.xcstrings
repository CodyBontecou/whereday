    "Analyze saved locations or add a manual stay. Try All time to see older records." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلّل المواقع المحفوظة أو أضف إقامة يدوية. جرّب «كل الوقت» لرؤية السجلات الأقدم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত অবস্থান বিশ্লেষণ করুন বা ম্যানুয়াল অবস্থানকাল যোগ করুন। পুরনো রেকর্ড দেখতে “সব সময়” বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze saved locations or add a manual stay. Try All time to see older records."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza las ubicaciones guardadas o añade una estancia manual. Prueba con «Todo el tiempo» para ver registros más antiguos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez les positions enregistrées ou ajoutez un séjour manuel. Choisissez Tout le temps pour voir les données plus anciennes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजे गए स्थानों का विश्लेषण करें या मैन्युअल ठहराव जोड़ें। पुराने रिकॉर्ड देखने के लिए \"पूरे समय\" आज़माएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した位置を分析するか、手動で滞在を追加してください。古い記録を見るには「すべての期間」をお試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeanalizuj zapisane lokalizacje lub dodaj pobyt ręcznie. Wybierz „Cały okres”, aby zobaczyć starsze wpisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analise os locais salvos ou adicione uma estadia manual. Experimente Todo o tempo para ver registros mais antigos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проанализируйте сохранённые места или добавьте пребывание вручную. Выберите «Все время», чтобы увидеть старые записи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析已保存的位置或手动添加停留。尝试“所有时间”以查看更早的记录。"
          }
        }
      }
    },
    "Analyze saved locations with saved progress, stopping and resuming, and clearer messages when country lookup is unavailable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حلّل المواقع المحفوظة مع حفظ التقدّم، وإمكانية الإيقاف والاستئناف، ورسائل أوضح عند تعذّر البحث عن الدولة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত অবস্থান বিশ্লেষণ — অগ্রগতি সংরক্ষণ, থামিয়ে আবার চালু করার সুবিধা, আর দেশ খোঁজা না গেলে আরও স্পষ্ট বার্তা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analyze saved locations with saved progress, stopping and resuming, and clearer messages when country lookup is unavailable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza las ubicaciones guardadas con progreso guardado, pausa y reanudación, y mensajes más claros cuando la búsqueda de países no está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysez les positions enregistrées avec progression sauvegardée, possibilité d’interrompre et de reprendre, et des messages plus clairs quand la recherche de pays est indisponible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजे गए स्थानों का विश्लेषण, सहेजी गई प्रगति के साथ, रोकने और फिर शुरू करने की सुविधा, और देश की जानकारी न मिलने पर ज़्यादा साफ़ संदेश।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した位置の分析で進捗が保存され、停止と再開ができるようになりました。国の特定ができないときのメッセージもわかりやすくなりました。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analizuj zapisane lokalizacje z zapisywaniem postępu, zatrzymywaniem i wznawianiem oraz czytelniejszymi komunikatami, gdy ustalanie kraju jest niedostępne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analise os locais salvos com progresso salvo, pausa e retomada, e mensagens mais claras quando a busca de país não estiver disponível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Анализ сохранённых мест с сохранением прогресса, остановкой и продолжением, а также более понятными сообщениями, когда определение страны недоступно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分析已保存的位置时可保存进度、随时停止和继续，国家查询不可用时提示也更清晰。"
          }
        }
      }
    },
