    "Finish signing in on myself.md, then sign in with the same account in the myself.md app on iOS or Android." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أكمل تسجيل الدخول على myself.md، ثم سجّل الدخول بالحساب نفسه في تطبيق myself.md على iOS أو Android."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "myself.md-এ সাইন ইন শেষ করুন, তারপর iOS বা Android-এর myself.md অ্যাপে একই অ্যাকাউন্ট দিয়ে সাইন ইন করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
