        "fr": {"stringUnit": {"state": "translated", "value": "%@ par an, avec renouvellement automatique jusqu’à résiliation."}},
        "hi": {"stringUnit": {"state": "translated", "value": "प्रति वर्ष %@, रद्द करने तक अपने-आप नवीनीकरण होगा।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "年額%@。キャンセルするまで自動更新されます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "%@ za rok, z automatycznym odnawianiem do czasu anulowania."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "%@ por ano, com renovação automática até o cancelamento."}},
        "ru": {"stringUnit": {"state": "translated", "value": "%@ в год с автоматическим продлением до отмены."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "每年 %@，自动续订，直至取消。"}}
      }
    },
    "7 days free, then %@ per week, automatically renewing until canceled.": {
