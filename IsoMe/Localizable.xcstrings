    "Export Whereday visits, points, or outings for a chosen date range as a file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّر زيارات Whereday أو نقاطه أو نزهاته لنطاق زمني تختاره في ملف."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বেছে নেওয়া তারিখ ব্যাপ্তির Whereday ভিজিট, পয়েন্ট বা আউটিং একটি ফাইল হিসেবে রপ্তানি করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export Whereday visits, points, or outings for a chosen date range as a file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta las visitas, los puntos o las salidas de Whereday de un rango de fechas elegido como archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporte les visites, points ou sorties d'Whereday d'une plage de dates choisie, dans un fichier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनी गई तिथि सीमा के Whereday विज़िट, पॉइंट या आउटिंग को एक फ़ाइल के रूप में एक्सपोर्ट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択した日付範囲のWheredayの訪問、位置情報、外出をファイルとして書き出します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuj wizyty, punkty lub podróży Whereday dla wybranego zakresu dat jako plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exporta visitas, pontos ou passeios do Whereday de um período escolhido como um arquivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует посещения, точки или прогулки Whereday за выбранный диапазон дат в файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将选定日期范围内的 Whereday 访问、位置点或郊游导出为文件。"
          }
        }
      }
    },
