    "Ends this manual visit at the current time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينهي هذه الزيارة اليدوية في الوقت الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান সময়ে এই ম্যানুয়াল পরিদর্শন শেষ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends this manual visit at the current time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Finaliza esta visita manual a la hora actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine cette visite manuelle à l’heure actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मैन्युअल विज़िट को वर्तमान समय पर समाप्त करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この手動の訪問を現在の時刻で終了します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kończy tę ręcznie dodaną wizytę o bieżącej godzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra esta visita manual no horário atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершает это посещение, добавленное вручную, в текущее время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以当前时间结束此次手动添加的到访。"
          }
        }
      }
    },
    "Enter a location name.": {
      "localizations": {
        "ar": {
