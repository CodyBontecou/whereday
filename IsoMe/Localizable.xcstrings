    "Distance filter controls how often points are saved while moving. Stop After auto-stops as a safety net.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم مرشح المسافة في عدد مرات حفظ النقاط أثناء الحركة. يتوقف «الإيقاف بعد» تلقائيًا كشبكة أمان."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance filter controls how often points are saved while moving. Stop After auto-stops as a safety net."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtro de distancia controla cada cuánto se guardan puntos en movimiento. Detener después detiene la grabación automáticamente como medida de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtre de distance détermine la fréquence d’enregistrement des points en mouvement. Arrêter après coupe automatiquement l’enregistrement, par sécurité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "距離フィルターは、移動中にポイントを保存する頻度を決めます。「次の時間後に停止」は安全策として自動で停止します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O filtro de distância controla com que frequência os pontos são salvos em movimento. Parar depois de encerra a gravação automaticamente, por segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离过滤器控制移动时保存位置点的频率。“停止时间”会作为安全措施自动停止记录。"
          }
        }
      }
    },
    "OUTINGS FROM SAVED POINTS": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نزهات من النقاط المحفوظة"
