    "Whereday needs location permission. Open the app to enable it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Whereday إلى إذن الموقع. افتح التطبيق لتمكينه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday-এর লোকেশনের অনুমতি প্রয়োজন। এটি সক্ষম করতে অ্যাপটি খুলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday needs location permission. Open the app to enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday necesita permiso de ubicación. Abra la aplicación para habilitarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday a besoin d'une autorisation de localisation. Ouvrez l'application pour l'activer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday को स्थान अनुमति की आवश्यकता है. इसे सक्षम करने के लिए ऐप खोलें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday には位置情報の許可が必要です。アプリを開いて有効にします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday potrzebuje pozwolenia na lokalizację. Otwórz aplikację, aby ją włączyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday precisa de permissão de localização. Abra o aplicativo para habilitá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday требуется разрешение на определение местоположения. Откройте приложение, чтобы включить его."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday 需要位置权限。打开应用程序以启用它。"
          }
        }
      }
    },
