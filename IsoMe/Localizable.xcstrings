    "Preview is free. Unlock export with a one-time purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المعاينة مجانية. فتح التصدير مع عملية شراء لمرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বরূপ বিনামূল্যে. এককালীন কেনাকাটার মাধ্যমে রপ্তানি আনলক করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview is free. Unlock export with a one-time purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vista previa es gratuita. Desbloquee la exportación con una compra única."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'aperçu est gratuit. Débloquez l’exportation avec un achat unique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्वावलोकन निःशुल्क है. एक बार की खरीदारी से निर्यात अनलॉक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プレビューは無料です。 1 回の購入でエクスポートのロックを解除します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd jest bezpłatny. Odblokuj eksport za pomocą jednorazowego zakupu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A visualização é gratuita. Desbloqueie a exportação com uma compra única."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предварительный просмотр бесплатен. Разблокируйте экспорт с помощью единоразовой покупки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
