    "Start a manual visit at a saved place or coordinates" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ زيارة يدوية في مكان محفوظ أو عند إحداثيات"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত জায়গা বা স্থানাঙ্কে একটি ম্যানুয়াল ভিজিট শুরু করুন"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a manual visit at a saved place or coordinates"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una visita manual en un lugar guardado o unas coordenadas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrer une visite manuelle dans un lieu enregistré ou à des coordonnées"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई जगह या निर्देशांक पर मैन्युअल विज़िट शुरू करें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所や座標で手動の訪問を開始"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij ręczną wizytę w zapisanym miejscu lub pod współrzędnymi"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciar uma visita manual em um lugar salvo ou em coordenadas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начать посещение вручную в сохранённом месте или по координатам"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已保存的地点或坐标开始一次手动到访"
          }
        }
      }
    },
    "Start a manual visit at a saved place or coordinates, then finish it with Check Out. Choose the visit when more than one is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ زيارة يدوية في مكان محفوظ أو عند إحداثيات، ثم أنهِها بـ«تسجيل المغادرة». اختر الزيارة عند وجود أكثر من زيارة مفتوحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত জায়গা বা স্থানাঙ্কে একটি ম্যানুয়াল ভিজিট শুরু করুন, তারপর চেক আউট দিয়ে শেষ করুন। একাধিক চলমান থাকলে ভিজিটটি বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a manual visit at a saved place or coordinates, then finish it with Check Out. Choose the visit when more than one is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una visita manual en un lugar guardado o unas coordenadas y termínala con Registrar salida. Elige la visita si hay más de una abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez une visite manuelle dans un lieu enregistré ou à des coordonnées, puis terminez-la avec Enregistrer le départ. Choisissez la visite lorsque plusieurs sont ouvertes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी सहेजी गई जगह या निर्देशांक पर मैन्युअल विज़िट शुरू करें, फिर चेक आउट से उसे पूरा करें। एक से ज़्यादा खुली हों तो विज़िट चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所や座標で手動の訪問を開始し、「チェックアウト」で終了します。複数の訪問が進行中のときは訪問を選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij ręczną wizytę w zapisanym miejscu lub pod współrzędnymi, a potem zakończ ją akcją Zakończ wizytę. Jeśli otwartych jest kilka, wybierz właściwą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie uma visita manual em um lugar salvo ou em coordenadas e encerre com Registrar saída. Escolha a visita quando houver mais de uma aberta."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните посещение вручную в сохранённом месте или по координатам, затем завершите его через «Завершить посещение». Если открыто несколько посещений, выберите нужное."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已保存的地点或坐标开始一次手动到访，然后用“签退”结束。若有多个进行中的到访，请选择其中一个。"
          }
        }
      }
    },
    "Start a manual visit at a saved place, coordinates, or your current location. Overlaps require Allow Overlap to be explicitly enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ زيارة يدوية في مكان محفوظ أو عند إحداثيات أو في موقعك الحالي. يتطلب التداخل تفعيل «السماح بالتداخل» صراحةً."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত জায়গা, স্থানাঙ্ক বা আপনার বর্তমান অবস্থানে একটি ম্যানুয়াল ভিজিট শুরু করুন। ওভারল্যাপের জন্য “ওভারল্যাপ করতে দিন” স্পষ্টভাবে চালু করতে হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start a manual visit at a saved place, coordinates, or your current location. Overlaps require Allow Overlap to be explicitly enabled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una visita manual en un lugar guardado, unas coordenadas o tu ubicación actual. Para solapar visitas hay que activar explícitamente Permitir solapamiento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarrez une visite manuelle dans un lieu enregistré, à des coordonnées ou à votre position actuelle. Les chevauchements nécessitent d’activer explicitement Autoriser le chevauchement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी सहेजी गई जगह, निर्देशांक या अपने वर्तमान स्थान पर मैन्युअल विज़िट शुरू करें। ओवरलैप के लिए \"ओवरलैप की अनुमति दें\" को स्पष्ट रूप से चालू करना ज़रूरी है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所、座標、または現在地で手動の訪問を開始します。重複させるには「重複を許可」を明示的にオンにする必要があります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozpocznij ręczną wizytę w zapisanym miejscu, pod współrzędnymi lub w bieżącej lokalizacji. Nakładanie się wizyt wymaga jawnego włączenia opcji Zezwól na nakładanie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicie uma visita manual em um lugar salvo, em coordenadas ou na sua localização atual. Sobreposições exigem que Permitir sobreposição esteja ativado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начните посещение вручную в сохранённом месте, по координатам или в текущем местоположении. Для пересечений нужно явно включить «Разрешить пересечение»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在已保存的地点、坐标或你的当前位置开始一次手动到访。如有重叠，需明确启用“允许重叠”。"
          }
        }
      }
    },
