          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background tracking"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguimiento en segundo plano"
          }
        },
        "fr": {
          "stringUnit": {
