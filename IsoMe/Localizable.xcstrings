    "Your existing records weren't touched. Try importing the file again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُمسّ سجلاتك الحالية. حاول استيراد الملف مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing records weren't touched. Try importing the file again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus registros existentes no se han modificado. Vuelve a intentar importar el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données existantes n’ont pas été modifiées. Réessayez d’importer le fichier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の記録は変更されていません。もう一度ファイルをインポートしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus registros existentes não foram alterados. Tente importar o arquivo novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现有的记录未受影响。请再次尝试导入该文件。"
          }
        }
      }
    },
    "Try a Google Timeline JSON export, or a Whereday JSON, CSV or Markdown file. Your existing records weren't touched.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جرّب ملف Google Timeline JSON مُصدَّرًا، أو ملف Whereday بتنسيق JSON أو CSV أو Markdown. لم تُمسّ سجلاتك الحالية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a Google Timeline JSON export, or a Whereday JSON, CSV or Markdown file. Your existing records weren't touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con una exportación JSON de Google Timeline o con un archivo JSON, CSV o Markdown de Whereday. Tus registros existentes no se han modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un export JSON Google Timeline, ou un fichier JSON, CSV ou Markdown de Whereday. Vos données existantes n’ont pas été modifiées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GoogleタイムラインのJSON書き出しファイル、またはWheredayのJSON、CSV、Markdownファイルをお試しください。既存の記録は変更されていません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimente uma exportação JSON do Google Timeline ou um arquivo JSON, CSV ou Markdown do Whereday. Seus registros existentes não foram alterados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请尝试 Google Timeline JSON 导出文件，或 Whereday 的 JSON、CSV 或 Markdown 文件。你现有的记录未受影响。"
          }
        }
      }
    },
