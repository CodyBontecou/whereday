    "Location access is off. Turn it on in iPhone Settings → Whereday → Location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوصول إلى الموقع متوقف. فعّله من إعدادات iPhone‏ ← Whereday ← الموقع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লোকেশন অ্যাক্সেস বন্ধ। iPhone সেটিংস → Whereday → লোকেশন থেকে এটি চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Location access is off. Turn it on in iPhone Settings → Whereday → Location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El acceso a la ubicación está desactivado. Actívalo en Ajustes del iPhone → Whereday → Ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’accès à la position est désactivé. Activez-le dans Réglages de l’iPhone → Whereday → Position."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्थान एक्सेस बंद है। इसे iPhone सेटिंग्स → Whereday → स्थान में चालू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報へのアクセスがオフです。iPhoneの設定 → Whereday → 位置情報でオンにしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostęp do lokalizacji jest wyłączony. Włącz go w Ustawieniach iPhone → Whereday → Lokalizacja."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O acesso à localização está desativado. Ative em Ajustes do iPhone → Whereday → Localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Доступ к местоположению выключен. Включите его в Настройках iPhone → Whereday → Геопозиция."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
