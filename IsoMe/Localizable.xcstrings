    "Install Whereday from the Watch app on this iPhone to record from your wrist." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ثبّت Whereday من تطبيق Watch على هذا الـ iPhone للتسجيل من معصمك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কবজি থেকে রেকর্ড করতে এই iPhone-এর Watch অ্যাপ থেকে Whereday ইনস্টল করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Install Whereday from the Watch app on this iPhone to record from your wrist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instala Whereday desde la app Watch de este iPhone para grabar desde tu muñeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installez Whereday depuis l’app Watch de cet iPhone pour enregistrer depuis votre poignet."
