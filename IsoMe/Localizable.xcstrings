    "Overlaps %@, which is still in progress. Saving will end that visit at %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتداخل مع %@، الذي لا يزال جاريًا. سيؤدي الحفظ إلى إنهاء تلك الزيارة في %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlaps %@, which is still in progress. Saving will end that visit at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solapa con %@, que sigue en curso. Al guardar, esa visita terminará a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chevauche %@, toujours en cours. L’enregistrement terminera cette visite à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "進行中の%@と重なっています。保存すると、その訪問は%@に終了します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe %@, que ainda está em andamento. Ao salvar, essa visita terminará às %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与仍在进行中的 %@ 重叠。保存后，该到访将在 %@ 结束。"
          }
        }
      }
    },
    "Overlaps %@ by %lld min (until %@). Saving will end that visit at %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتداخل مع %@ بمقدار %lld د (حتى %@). سيؤدي الحفظ إلى إنهاء تلك الزيارة في %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlaps %@ by %lld min (until %@). Saving will end that visit at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solapa con %@ durante %lld min (hasta las %@). Al guardar, esa visita terminará a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chevauche %@ de %lld min (jusqu’à %@). L’enregistrement terminera cette visite à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と%lld分重なっています（%@まで）。保存すると、その訪問は%@に終了します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sobrepõe %@ em %lld min (até %@). Ao salvar, essa visita terminará às %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 %@ 重叠 %lld 分钟（直到 %@）。保存后，该到访将在 %@ 结束。"
          }
        }
      }
    },
    "Overlaps %@ by %lld min (from %@). Saving will start that visit at %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتداخل مع %@ بمقدار %lld د (من %@). سيؤدي الحفظ إلى بدء تلك الزيارة في %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Overlaps %@ by %lld min (from %@). Saving will start that visit at %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solapa con %@ durante %lld min (desde las %@). Al guardar, esa visita empezará a las %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chevauche %@ de %lld min (à partir de %@). L’enregistrement fera commencer cette visite à %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と%lld分重なっています（%@から）。保存すると、その訪問は%@に開始します。"
