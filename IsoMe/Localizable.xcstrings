    "Webhook is part of a plan. Choose a Whereday plan to unlock export features.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook جزء من خطة. اختر خطة Whereday لفتح ميزات التصدير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook is part of a plan. Choose a Whereday plan to unlock export features."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El webhook forma parte de un plan. Elige un plan de Whereday para desbloquear las funciones de exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le webhook est inclus dans une formule. Choisissez une formule Whereday pour débloquer les fonctions d’exportation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhookはプランに含まれます。書き出し機能を使うには、Wheredayのプランを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O webhook faz parte de um plano. Escolha um plano Whereday para liberar os recursos de exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Webhook 包含在方案中。选择 Whereday 方案以解锁导出功能。"
          }
        }
      }
    },
    "Delivery sends your location data to a server you configure.": {
      "localizations": {
