    "We send your App Store purchase proof to myself.md. Your health and location data stay on your device." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نرسل إثبات شرائك من App Store إلى myself.md. تبقى بياناتك الصحية وبيانات موقعك على جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমরা আপনার App Store কেনাকাটার প্রমাণ myself.md-এ পাঠাই। আপনার স্বাস্থ্য ও অবস্থানের ডেটা আপনার ডিভাইসেই থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We send your App Store purchase proof to myself.md. Your health and location data stay on your device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos el justificante de tu compra en el App Store a myself.md. Tus datos de salud y ubicación se quedan en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous envoyons la preuve de votre achat App Store à myself.md. Vos données de santé et de localisation restent sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हम आपकी App Store ख़रीदारी का प्रमाण myself.md को भेजते हैं। आपका स्वास्थ्य और स्थान डेटा आपके डिवाइस पर ही रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Storeの購入証明をmyself.mdに送信します。健康データと位置データはデバイスに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłamy potwierdzenie zakupu z App Store do myself.md. Twoje dane o zdrowiu i lokalizacji pozostają na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviamos o comprovante da sua compra na App Store ao myself.md. Seus dados de saúde e localização ficam no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы отправляем подтверждение покупки в App Store в myself.md. Данные о здоровье и местоположении остаются на вашем устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
