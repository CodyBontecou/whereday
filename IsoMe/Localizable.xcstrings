    },
    "File": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملف"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件"
          }
        }
      }
    },
    "File path templates now support folders, more date tokens, and a dated-folder preset for tidy daily archives.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تدعم قوالب مسار الملف الآن المجلدات والمزيد من الرموز المميزة للتاريخ وإعداد مسبق للمجلد التاريخي للأرشيفات اليومية المرتبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফাইল পাথ টেমপ্লেটগুলি এখন ফোল্ডার, আরও তারিখের টোকেন এবং পরিপাটি দৈনিক সংরক্ষণাগারগুলির জন্য একটি তারিখ-ফোল্ডার প্রিসেট সমর্থন করে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File path templates now support folders, more date tokens, and a dated-folder preset for tidy daily archives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las plantillas de ruta de archivo ahora admiten carpetas, más tokens de fecha y un ajuste preestablecido de carpeta con fecha para archivos diarios ordenados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modèles de chemin de fichier prennent désormais en charge les dossiers, davantage de jetons de date et un préréglage de dossier daté pour des archives quotidiennes bien rangées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल पथ टेम्प्लेट अब व्यवस्थित दैनिक संग्रह के लिए फ़ोल्डर, अधिक दिनांक टोकन और दिनांकित-फ़ोल्डर प्रीसेट का समर्थन करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイル パス テンプレートは、フォルダー、より多くの日付トークン、毎日のアーカイブを整理するための日付フォルダー プリセットをサポートするようになりました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablony ścieżek plików obsługują teraz foldery, więcej tokenów dat i gotowe ustawienia folderów z datą, umożliwiające codzienne porządkowanie archiwów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os modelos de caminho de arquivo agora suportam pastas, mais tokens de data e uma predefinição de pasta com data para arquivos diários organizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны путей к файлам теперь поддерживают папки, больше маркеров даты и предустановку датированных папок для аккуратных ежедневных архивов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件路径模板现在支持文件夹、更多日期标记以及用于整洁日常存档的预设日期文件夹。"
          }
        }
      }
    },
    "File paths using {title} or {name} now show a sensible data-type fallback for Visits, Points, and All exports when no outing title exists.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُظهر الآن مسارات الملفات التي تستخدم {title} أو {name} احتياطيًا معقولاً لنوع البيانات للزيارات والنقاط وجميع الصادرات في حالة عدم وجود عنوان للنزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "{title} বা {name} ব্যবহার করে ফাইল পাথগুলি এখন ভিজিট, পয়েন্ট এবং সমস্ত এক্সপোর্টের জন্য একটি বুদ্ধিমান ডেটা-টাইপ ফলব্যাক দেখায় যখন কোনো আউটিং শিরোনাম নেই৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "File paths using {title} or {name} now show a sensible data-type fallback for Visits, Points, and All exports when no outing title exists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las rutas de archivo que usan {title} o {name} ahora muestran un tipo de datos alternativo sensible para Visitas, Puntos y Todas las exportaciones cuando no existe ningún título de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chemins de fichiers utilisant {title} ou {name} affichent désormais un type de données de secours judicieux pour les exportations Visites, Points et Toutes lorsqu'aucun titre de sortie n'existe."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "{title} या {name} का उपयोग करने वाले फ़ाइल पथ अब विज़िट, पॉइंट और सभी निर्यातों के लिए एक समझदार डेटा-प्रकार फ़ॉलबैक दिखाते हैं, जब कोई आउटिंग शीर्षक मौजूद नहीं होता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "{title}または{name}を使用したファイル パスでは、外出タイトルが存在しない場合、訪問数、ポイント、およびすべてのエクスポートに対して適切なデータ型フォールバックが表示されるようになりました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ścieżki plików używające {title} lub {name} pokazują teraz rozsądne zastępcze typy danych dla eksportów Wizyty, Punkty i Wszystkie, gdy nie istnieje żaden tytuł podróży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminhos de arquivo usando {title} ou {name} agora mostram um substituto de tipo de dados sensato para visitas, pontos e todas as exportações quando não existe título de saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пути к файлам, использующие {title} или {name} теперь отображают разумный резервный тип данных для экспорта «Посещения», «Точки» и «Все», когда заголовок выхода не существует."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在，当不存在外出标题时，使用{title}或{name}的文件路径会显示访问、积分和全部导出的合理数据类型后备。"
          }
        }
      }
    },
