      }
    },
    "Outing exports now plan filenames more accurately, preserve visit correction details, and present sharing more reliably." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقوم عمليات التصدير الآن بتخطيط أسماء الملفات بشكل أكثر دقة، والحفاظ على تفاصيل تصحيح الزيارة، وتقديم المشاركة بشكل أكثر موثوقية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আউটিং এক্সপোর্টগুলি এখন ফাইলের নামগুলি আরও সঠিকভাবে পরিকল্পনা করে, ভিজিট সংশোধনের বিশদ সংরক্ষণ করে এবং আরও নির্ভরযোগ্যভাবে শেয়ারিং উপস্থাপন করে৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Outing exports now plan filenames more accurately, preserve visit correction details, and present sharing more reliably."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las exportaciones de salidas ahora planifican los nombres de los archivos con mayor precisión, conservan los detalles de corrección de las visitas y presentan el uso compartido de manera más confiable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportations de sorties planifient désormais les noms de fichiers avec plus de précision, préservent les détails de correction des visites et présentent le partage de manière plus fiable."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आउटिंग एक्सपोर्ट अब अधिक सटीक रूप से फ़ाइल नामों की योजना बनाते हैं, विज़िट सुधार विवरण संरक्षित करते हैं, और अधिक विश्वसनीय रूप से साझाकरण प्रस्तुत करते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出エクスポートでは、ファイル名がより正確に計画され、訪問修正の詳細が保存され、共有がより確実に行われるようになりました。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport podróży lepiej dobiera nazwy plików, zachowuje szczegóły korekt wizyt i sprawniej otwiera udostępnianie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações de passeios agora planejam nomes de arquivos com mais precisão, preservam detalhes de correção de visitas e apresentam compartilhamento de forma mais confiável."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При экспорте прогулок имена файлов теперь формируются точнее, сведения об исправлениях посещений сохраняются, а меню «Поделиться» открывается надёжнее."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出导出现在可以更准确地规划文件名，保留访问更正详细信息，并更可靠地呈现共享。"
          }
        }
      }
    },
