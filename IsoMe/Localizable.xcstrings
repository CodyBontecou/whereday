    "The place you pick is removed. Its visits, kind, address and note join %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُزال المكان الذي تختاره. تنضم زياراته ونوعه وعنوانه وملاحظته إلى %@."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বেছে নেওয়া জায়গাটি সরানো হবে। এর ভিজিট, ধরন, ঠিকানা ও নোট %@-এর সঙ্গে যুক্ত হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The place you pick is removed. Its visits, kind, address and note join %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El lugar que elijas se eliminará. Sus visitas, tipo, dirección y nota se unirán a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lieu choisi est supprimé. Ses visites, son type, son adresse et sa note rejoignent %@."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जो जगह चुनेंगे वह हट जाएगी। उसकी विज़िट, प्रकार, पता और नोट %@ में जुड़ जाएँगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ場所は削除されます。その訪問、種類、住所、メモは%@に統合されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrane miejsce zostanie usunięte. Jego wizyty, rodzaj, adres i notatka zostaną połączone z: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O lugar escolhido será removido. As visitas, o tipo, o endereço e a nota dele passam para %@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранное место будет удалено. Его посещения, тип, адрес и заметка перейдут к месту %@."
          }
