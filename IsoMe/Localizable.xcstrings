    "Manual visits require a saved location or a current location from the last 5 minutes with accuracy under 100 meters.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الزيارات اليدوية موقعًا محفوظًا أو موقعًا حاليًا من آخر 5 دقائق بدقة أقل من 100 متر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ম্যানুয়াল ভিজিটের জন্য 100 মিটারের নিচে নির্ভুলতার সাথে শেষ 5 মিনিটের একটি সংরক্ষিত অবস্থান বা একটি বর্তমান অবস্থান প্রয়োজন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manual visits require a saved location or a current location from the last 5 minutes with accuracy under 100 meters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las visitas manuales requieren una ubicación guardada o una ubicación actual de los últimos 5 minutos con una precisión inferior a 100 metros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les visites manuelles nécessitent un emplacement enregistré ou un emplacement actuel des 5 dernières minutes avec une précision inférieure à 100 mètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैन्युअल विज़िट के लिए 100 मीटर से कम सटीकता के साथ पिछले 5 मिनट से सहेजे गए स्थान या वर्तमान स्थान की आवश्यकता होती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手動による訪問には、保存された場所、または 100 メートル未満の精度で過去 5 分間の現在の場所が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wizyty ręczne wymagają zapisanej lokalizacji lub aktualnej lokalizacji z ostatnich 5 minut z dokładnością poniżej 100 metrów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As visitas manuais requerem uma localização salva ou uma localização atual dos últimos 5 minutos com precisão inferior a 100 metros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для посещений вручную требуется сохранение местоположения или текущее местоположение за последние 5 минут с точностью до 100 метров."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手动访问需要保存的位置或最近 5 分钟的当前位置，精度在 100 米以下。"
          }
        }
      }
    },
