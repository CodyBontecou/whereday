    "You can also enter coordinates directly instead of using the map." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك أيضًا إدخال الإحداثيات مباشرةً بدلًا من استخدام الخريطة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মানচিত্র ব্যবহারের বদলে সরাসরি স্থানাঙ্কও লিখতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can also enter coordinates directly instead of using the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También puedes introducir coordenadas directamente en lugar de usar el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez aussi saisir directement des coordonnées au lieu d’utiliser la carte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "मानचित्र की जगह आप सीधे निर्देशांक भी दर्ज कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図を使わずに座標を直接入力することもできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz też wpisać współrzędne bezpośrednio zamiast używać mapy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você também pode digitar as coordenadas diretamente em vez de usar o mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Координаты можно также ввести напрямую, без карты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你也可以直接输入坐标，而不使用地图。"
          }
        }
      }
    },
