    "Too much data to sample here. Tap to open the full preview." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البيانات كثيرة جدًا لأخذ عيّنة هنا. اضغط لفتح المعاينة الكاملة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখানে নমুনা দেখানোর জন্য ডেটা অনেক বেশি। পূর্ণ পূর্বরূপ খুলতে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too much data to sample here. Tap to open the full preview."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hay demasiados datos para mostrar una muestra aquí. Toca para abrir la vista previa completa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trop de données pour un échantillon ici. Touchez pour ouvrir l’aperçu complet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यहाँ नमूना दिखाने के लिए बहुत ज़्यादा डेटा है। पूरा पूर्वावलोकन खोलने के लिए टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データが多すぎてここでは抽出できません。タップして完全なプレビューを開きます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zbyt dużo danych na próbkę. Dotknij, aby otworzyć pełny podgląd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dados demais para amostrar aqui. Toque para abrir a prévia completa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Слишком много данных для выборки. Коснитесь, чтобы открыть полный предпросмотр."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数据过多，无法在此取样。轻点以打开完整预览。"
          }
        }
      }
    },
