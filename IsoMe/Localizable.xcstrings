    "Search Apple Maps or drop a pin to correct this visit.": {
      "comment": "Accessibility hint for Not here.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في Apple Maps أو ضع دبوسًا لتصحيح هذه الزيارة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভিজিট ঠিক করতে Apple Maps-এ খুঁজুন বা পিন ফেলুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Apple Maps or drop a pin to correct this visit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca en Apple Maps o suelta un pin para corregir esta visita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cherchez dans Apple Plans ou placez une épingle pour corriger cette visite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस विज़िट को ठीक करने के लिए Apple Maps में खोजें या पिन लगाएँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple マップで検索するかピンを置いてこの訪問を修正します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj w Apple Maps lub upuść pinezkę, by poprawić tę wizytę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque no Apple Mapas ou solte um alfinete para corrigir esta visita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите в Apple Картах или поставьте метку, чтобы исправить визит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple 地图中搜索或放置图钉以更正此到访。"
          }
        }
      }
    },
