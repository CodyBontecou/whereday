    "Your yearly plan begins. Cancel before then in Apple settings and you won't be charged." : {
      "comment" : "Carousel paywall.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ خطتك السنوية. ألغِ قبل ذلك من إعدادات Apple ولن يتم تحصيل أي مبلغ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বার্ষিক প্ল্যান শুরু হয়। এর আগে Apple সেটিংসে বাতিল করলে কোনো চার্জ হবে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your yearly plan begins. Cancel before then in Apple settings and you won't be charged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza tu plan anual. Cancela antes en los ajustes de Apple y no se te cobrará."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre formule annuelle commence. Annulez avant dans les réglages Apple et vous ne serez pas facturé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका वार्षिक प्लान शुरू होता है। उससे पहले Apple सेटिंग में रद्द करें, कोई शुल्क नहीं लगेगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年額プランが始まります。それまでにAppleの設定で解約すれば請求されません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaczyna się Twój plan roczny. Anuluj wcześniej w ustawieniach Apple, a nie zostaniesz obciążony."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano anual começa. Cancele antes nos ajustes da Apple e você não será cobrado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начинается годовая подписка. Отмените заранее в настройках Apple — и плата не спишется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "年订阅开始。在此之前于 Apple 设置中取消，就不会扣费。"
          }
        }
      }
    },
    "Zooms to everything in the range. Hold for more options." : {
      "comment" : "Accessibility hint for Fit.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يكبّر لعرض كل ما في النطاق. اضغط مطولًا لمزيد من الخيارات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সময়সীমার সবকিছু দেখাতে জুম করে। আরও বিকল্পের জন্য চেপে ধরুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zooms to everything in the range. Hold for more options."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta el zoom a todo el rango. Mantén pulsado para más opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoome sur tout le contenu de la période. Maintenez pour plus d'options."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अवधि की हर चीज़ तक ज़ूम करता है। और विकल्पों के लिए दबाकर रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期間内のすべてに合わせてズームします。長押しで他のオプション。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przybliża do całego zakresu. Przytrzymaj, aby zobaczyć więcej opcji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusta o zoom a tudo no período. Toque e segure para mais opções."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Масштабирует к содержимому периода. Удерживайте для других вариантов."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "缩放以显示范围内的全部内容。按住可查看更多选项。"
          }
        }
      }
    }
  },
  "version" : "1.0"
