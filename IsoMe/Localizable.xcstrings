    "Family Sharing is included. Existing lifetime owners have been grandfathered into this plan.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المشاركة العائلية مشمولة. تمت ترقية مالكي الشراء مدى الحياة الحاليين إلى هذه الخطة دون رسوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্যামিলি শেয়ারিং অন্তর্ভুক্ত। বর্তমান লাইফটাইম মালিকদের বিনা খরচে এই প্ল্যানে অন্তর্ভুক্ত করা হয়েছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family Sharing is included. Existing lifetime owners have been grandfathered into this plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En familia está incluido. Los propietarios actuales de la compra de por vida han pasado a este plan sin coste adicional."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le partage familial est inclus. Les détenteurs actuels de l’achat à vie bénéficient de cette formule sans frais supplémentaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ैमिली शेयरिंग शामिल है। मौजूदा लाइफ़टाइम मालिकों को बिना अतिरिक्त शुल्क इस प्लान में शामिल किया गया है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファミリー共有が含まれます。既存の買い切り版ユーザーは追加料金なしでこのプランに移行されています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chmura rodzinna jest wliczona w cenę. Osoby, które wcześniej kupiły dożywotni dostęp, otrzymały ten plan automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Compartilhamento Familiar está incluído. Quem já tinha a compra vitalícia foi incluído neste plano sem custo adicional."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семейный доступ включён. Владельцы прежней бессрочной покупки получили этот план без доплаты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已包含家人共享。现有终身版用户已免费升级至此方案。"
          }
        }
      }
    },
    "Family Upgrade requires an Individual Lifetime purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب الترقية العائلية شراء «مدى الحياة للفرد»."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফ্যামিলি আপগ্রেডের জন্য ইন্ডিভিজুয়াল লাইফটাইম কেনা থাকতে হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family Upgrade requires an Individual Lifetime purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mejora familiar requiere una compra Individual de por vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La mise à niveau Famille nécessite un achat Individuel à vie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ैमिली अपग्रेड के लिए इंडिविजुअल लाइफ़टाइम खरीद आवश्यक है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファミリーアップグレードには個人向け買い切り版の購入が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejście na plan rodzinny wymaga zakupu dożywotniego planu indywidualnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O upgrade Família exige uma compra Individual vitalícia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для семейного улучшения требуется покупка «Индивидуальный навсегда»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家庭升级需要先购买个人终身版。"
          }
