    "Install Whereday from the Watch app on this iPhone to record from your wrist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت Whereday من تطبيق Watch على هذا الـ iPhone للتسجيل من معصمك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install Whereday from the Watch app on this iPhone to record from your wrist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala Whereday desde la app Watch de este iPhone para grabar desde tu muñeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez Whereday depuis l’app Watch de cet iPhone pour enregistrer depuis votre poignet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首から記録するには、このiPhoneのWatchアプリからWheredayをインストールしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale o Whereday pelo app Watch neste iPhone para gravar do seu pulso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 的 Watch 应用中安装 Whereday，即可从手腕记录。"
          }
        }
      }
    },
    "Pair an Apple Watch to record outings from your wrist.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اقرن Apple Watch لتسجيل النزهات من معصمك."
