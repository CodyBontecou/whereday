    "Route points about every 5 m. For hikes and rides. Stops on its own after 2 h." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقاط الطريق حوالي كل 5 م. للمشي لمسافات طويلة وركوب الخيل. يتوقف من تلقاء نفسه بعد ساعتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রুট পয়েন্ট প্রায় প্রতি 5 মি. হাইক এবং রাইডের জন্য। 2 ঘন্টা পরে নিজেই থেমে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Route points about every 5 m. For hikes and rides. Stops on its own after 2 h."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puntos de ruta aproximadamente cada 5 m. Para caminatas y paseos. Se detiene por sí solo después de 2 h."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points d'itinéraire tous les 5 m environ. Pour randonnées et balades. S'arrête tout seul au bout de 2 h."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक 5 मीटर पर मार्ग बिंदु। लंबी पैदल यात्रा और सवारी के लिए. 2 घंटे के बाद अपने आप रुक जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ルートポイントは約5mごと。ハイキングや乗り物に。 2 時間後に自動的に停止します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty trasy mniej więcej co 5 m. Na wędrówki i przejażdżki. Zatrzymuje się samoczynnie po 2 godz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontos de rota aproximadamente a cada 5 m. Para caminhadas e passeios. Pára sozinho após 2 horas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точки маршрута примерно через каждые 5 м. Для походов и поездок. Прекращается самостоятельно через 2 часа."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约每 5 m 有一个路线点。适合远足和骑行。 2小时后自行停止。"
          }
        }
      }
    },
