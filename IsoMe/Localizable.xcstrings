    "Future automatic visits inside this radius use the saved name. Choose 25–10,000 meters. Editing a saved location does not change past visits." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزيارات التلقائية المستقبلية داخل هذا النطاق تستخدم الاسم المحفوظ. اختر بين 25 و10,000 متر. تعديل موقع محفوظ لا يغيّر الزيارات السابقة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ব্যাসার্ধের ভেতরের ভবিষ্যৎ স্বয়ংক্রিয় ভিজিট সংরক্ষিত নামটি ব্যবহার করবে। 25–10,000 মিটার বেছে নিন। সংরক্ষিত অবস্থান সম্পাদনা করলে আগের ভিজিট বদলায় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future automatic visits inside this radius use the saved name. Choose 25–10,000 meters. Editing a saved location does not change past visits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las futuras visitas automáticas dentro de este radio usarán el nombre guardado. Elige entre 25 y 10.000 metros. Editar una ubicación guardada no cambia las visitas pasadas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futures visites automatiques dans ce rayon utilisent le nom enregistré. Choisissez entre 25 et 10 000 mètres. Modifier un lieu enregistré ne change pas les visites passées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस दायरे के अंदर भविष्य की स्वचालित विज़िट सहेजे गए नाम का उपयोग करेंगी। 25–10,000 मीटर चुनें। सहेजे गए स्थान को बदलने से पिछली विज़िट नहीं बदलतीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後この半径内で自動検出される訪問には、保存した名前が使われます。25〜10,000メートルで指定してください。保存した場所を編集しても過去の訪問は変わりません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyszłe automatyczne wizyty w tym promieniu użyją zapisanej nazwy. Wybierz od 25 do 10 000 metrów. Edycja lokalizacji nie zmienia wcześniejszych wizyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futuras visitas automáticas dentro deste raio usam o nome salvo. Escolha entre 25 e 10.000 metros. Editar um local salvo não altera visitas anteriores."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будущие автоматические посещения в этом радиусе получат сохранённое название. Выберите от 25 до 10 000 метров. Изменение сохранённого места не меняет прошлые посещения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今后在此半径内的自动到访将使用已保存的名称。请选择 25–10,000 米。编辑已保存的地点不会更改过去的到访。"
          }
        }
      }
    },
    "Future automatic visits within this radius will use this name before network geocoding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ستستخدم الزيارات التلقائية المستقبلية داخل هذا النطاق هذا الاسم قبل الترميز الجغرافي للشبكة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ব্যাসার্ধের মধ্যে ভবিষ্যত স্বয়ংক্রিয় পরিদর্শনগুলি নেটওয়ার্ক জিওকোডিংয়ের আগে এই নামটি ব্যবহার করবে৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Future automatic visits within this radius will use this name before network geocoding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las visitas automáticas futuras dentro de este radio utilizarán este nombre antes de la codificación geográfica de la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les futures visites automatiques dans ce rayon utiliseront ce nom avant le géocodage du réseau."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस दायरे में भविष्य की स्वचालित विज़िट नेटवर्क जियोकोडिंग से पहले इस नाम का उपयोग करेंगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後、この半径内の自動訪問では、ネットワーク ジオコーディングの前にこの名前が使用されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyszłe automatyczne wizyty w tym promieniu użyją zapisanej nazwy przed geokodowaniem przez sieć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Futuras visitas automáticas dentro deste raio usarão este nome antes da geocodificação da rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Будущие автоматические посещения в этом радиусе будут использовать это имя перед сетевым геокодированием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未来在此半径内的自动访问将在网络地​​理编码之前使用此名称。"
          }
        }
      }
    },
