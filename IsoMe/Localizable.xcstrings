    "We’ll send your App Store purchase proof to myself.md to verify eligibility. Your health and location data stay on your device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنرسل إثبات شرائك من App Store إلى myself.md للتحقق من الأهلية. تبقى بياناتك الصحية وبيانات موقعك على جهازك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We’ll send your App Store purchase proof to myself.md to verify eligibility. Your health and location data stay on your device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos el justificante de tu compra en el App Store a myself.md para verificar que cumples los requisitos. Tus datos de salud y ubicación se quedan en tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous enverrons la preuve de votre achat App Store à myself.md pour vérifier votre éligibilité. Vos données de santé et de localisation restent sur votre appareil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受給資格の確認のため、App Storeの購入証明をmyself.mdに送信します。健康データと位置データはデバイスに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślemy dowód zakupu z App Store do myself.md, aby potwierdzić uprawnienia. Dane dotyczące zdrowia i lokalizacji pozostają na urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviaremos o comprovante da sua compra na App Store ao myself.md para verificar a elegibilidade. Seus dados de saúde e localização ficam no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会将你的 App Store 购买凭证发送给 myself.md 以验证资格。你的健康和位置数据仍保留在设备上。"
          }
        }
      }
    },
