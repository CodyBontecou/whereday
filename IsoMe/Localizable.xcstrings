    "No places yet today. Stops show up here once you've stayed somewhere for a few minutes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أماكن اليوم بعد. تظهر التوقفات هنا بعد بقائك في مكان ما بضع دقائق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজ এখনো কোনো জায়গা নেই। কোথাও কয়েক মিনিট থাকলে থামাগুলো এখানে দেখা যাবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No places yet today. Stops show up here once you've stayed somewhere for a few minutes."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay lugares hoy. Las paradas aparecen aquí cuando te quedas en un sitio unos minutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun lieu aujourd’hui pour l’instant. Les arrêts apparaissent ici dès que vous restez quelque part quelques minutes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज अभी कोई जगह नहीं। कहीं कुछ मिनट रुकने पर पड़ाव यहाँ दिखेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日はまだ場所がありません。どこかに数分間とどまると、立ち寄りがここに表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dziś jeszcze brak miejsc. Postoje pojawią się tutaj, gdy zostaniesz gdzieś przez kilka minut."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum lugar hoje ainda. As paradas aparecem aqui depois que você fica em algum lugar por alguns minutos."
          }
        },
