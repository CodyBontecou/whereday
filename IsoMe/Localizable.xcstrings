          }
        }
      }
    },
    "Recent files with data in this preview: %lld. Export will process every selected file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الملفات الحديثة التي تحتوي على بيانات في هذه المعاينة: %lld. سيعالج التصدير جميع الملفات المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রিভিউতে ডেটাসহ সাম্প্রতিক ফাইল: %lld। এক্সপোর্টে প্রতিটি নির্বাচিত ফাইল প্রক্রিয়া করা হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent files with data in this preview: %lld. Export will process every selected file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos recientes con datos en esta vista previa: %lld. La exportación procesará todos los archivos seleccionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers récents contenant des données dans cet aperçu : %lld. L’export traitera tous les fichiers sélectionnés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पूर्वावलोकन में डेटा वाली हाल की फ़ाइलें: %lld। निर्यात में हर चुनी गई फ़ाइल संसाधित होगी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプレビューに含まれるデータのある最新ファイル数：%lld。書き出しでは選択したすべてのファイルが処理されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najnowsze pliki z danymi w tym podglądzie: %lld. Eksport obejmie każdy wybrany plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos recentes com dados nesta prévia: %lld. A exportação processará todos os arquivos selecionados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Последние файлы с данными в этом предпросмотре: %lld. При экспорте будут обработаны все выбранные файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预览中包含数据的最新文件数：%lld。导出将处理所有选定的文件。"
