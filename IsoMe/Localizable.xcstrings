    "Limited Photos access is enabled, so only selected photos can appear.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تمكين الوصول المحدود إلى الصور، لذا يمكن أن تظهر الصور المحددة فقط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সীমিত ফটো অ্যাক্সেস সক্ষম করা হয়েছে, তাই শুধুমাত্র নির্বাচিত ফটো প্রদর্শিত হতে পারে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limited Photos access is enabled, so only selected photos can appear."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso limitado a Fotos está habilitado, por lo que solo pueden aparecer las fotos seleccionadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès limité aux photos est activé, de sorte que seules les photos sélectionnées peuvent apparaître."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीमित फ़ोटो एक्सेस सक्षम है, इसलिए केवल चयनित फ़ोटो ही दिखाई दे सकती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限された写真へのアクセスが有効になっているため、選択した写真のみが表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączono ograniczony dostęp do Zdjęć, więc mogą pojawić się tylko wybrane zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso limitado às fotos está ativado, portanto, apenas as fotos selecionadas podem aparecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включен ограниченный доступ к фотографиям, поэтому могут отображаться только выбранные фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用有限照片访问，因此只能显示选定的照片。"
          }
        }
      }
    },
    "Links can open Check In, Add Past Visit, or a visit's details. Review the place and times before saving.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للروابط فتح «تسجيل الوصول» أو «إضافة زيارة سابقة» أو تفاصيل زيارة. راجع المكان والأوقات قبل الحفظ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links can open Check In, Add Past Visit, or a visit's details. Review the place and times before saving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces pueden abrir Registrar llegada, Agregar visita anterior o los detalles de una visita. Revisa el lugar y las horas antes de guardar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens peuvent ouvrir Enregistrer l’arrivée, Ajouter une visite passée ou les détails d’une visite. Vérifiez le lieu et les heures avant d’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクから「チェックイン」「過去の訪問を追加」、または訪問の詳細を開けます。保存する前に場所と時刻を確認してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links podem abrir Check-in, Adicionar visita anterior ou os detalhes de uma visita. Revise o lugar e os horários antes de salvar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可以打开签到、添加过去的到访或某次到访的详情。保存前请检查地点和时间。"
          }
        }
      }
    },
    "Lists every matched place, including places outside the visible map area.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسرد كل مكان متطابق، بما فيها الأماكن خارج منطقة الخريطة الظاهرة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lists every matched place, including places outside the visible map area."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra todos los lugares asociados, incluidos los que están fuera de la zona visible del mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Liste tous les lieux associés, y compris ceux hors de la zone visible de la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の地図の外にある場所も含め、一致したすべての場所を一覧表示します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetla wszystkie dopasowane miejsca, także poza widocznym obszarem mapy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista todos os lugares associados, inclusive os que estão fora da área visível do mapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "列出所有匹配的地点，包括可见地图区域以外的地点。"
          }
        }
      }
    },
