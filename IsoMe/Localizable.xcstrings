    "Only include data captured between these hours each day. Wraps midnight if end is before start." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم فقط بتضمين البيانات التي تم التقاطها بين هذه الساعات كل يوم. يلتف منتصف الليل إذا كانت النهاية قبل البداية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র প্রতিদিন এই ঘন্টার মধ্যে ক্যাপচার করা ডেটা অন্তর্ভুক্ত করুন। শুরুর আগে শেষ হলে মধ্যরাতে মোড়ানো হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only include data captured between these hours each day. Wraps midnight if end is before start."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluya únicamente los datos capturados entre estas horas cada día. Pasa de la medianoche si el final es anterior al comienzo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incluez uniquement les données capturées entre ces heures chaque jour. La plage passe minuit si la fin est avant le début."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक दिन केवल इन घंटों के बीच कैप्चर किया गया डेटा शामिल करें। यदि अंत प्रारंभ से पहले है तो आधी रात को लपेटता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "毎日この時間帯に取得されたデータのみを含めます。終了が開始より前の場合は、午前0時をまたぎます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uwzględniaj tylko dane zarejestrowane codziennie w tych godzinach. Jeśli koniec poprzedza początek, zakres obejmuje północ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inclua apenas dados capturados entre esses horários todos os dias. Passa da meia-noite se o fim for antes do início."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включать только данные, полученные в эти часы каждого дня. Если конец раньше начала, интервал переходит через полночь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅包含每天这些时间之间捕获的数据。如果结束早于开始，则在午夜结束。"
          }
        }
      }
    },
    "Only photos you selected for Whereday can appear. Add more in iOS Photos privacy settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تظهر فقط الصور التي حددتها لـ Whereday أضف المزيد في إعدادات خصوصية iOS Photos."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র আপনি Whereday এর জন্য নির্বাচিত ফটোগুলি প্রদর্শিত হতে পারে৷ iOS ফটোর গোপনীয়তা সেটিংসে আরও যোগ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only photos you selected for Whereday can appear. Add more in iOS Photos privacy settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sólo pueden aparecer las fotos que hayas seleccionado para Whereday Agregue más en la configuración de privacidad de Fotos iOS ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les photos que vous avez sélectionnées pour Whereday peuvent apparaître. Ajoutez-en plus dans les paramètres de confidentialité iOS Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल आपके द्वारा Whereday के लिए चयनित फ़ोटो ही दिखाई दे सकती हैं। iOS फ़ोटो गोपनीयता सेटिंग्स में और जोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday用に選択した写真のみが表示されます。 iOS写真のプライバシー設定でさらに追加します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mogą pojawić się tylko zdjęcia wybrane dla Whereday. Dodaj kolejne w ustawieniach prywatności Zdjęć w iOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Somente as fotos que você selecionou para o Whereday podem aparecer. Adicione mais nas configurações de privacidade de Fotos do iOS."
          }
        },
        "ru" : {
          "stringUnit" : {
