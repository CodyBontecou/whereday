            "state": "translated",
            "value": "इस डिवाइस पर फ़ोटो उपलब्ध नहीं हैं."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイスでは写真を利用できません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdjęcia są niedostępne na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos não estão disponíveis neste dispositivo."
          }
        },
        "ru": {
