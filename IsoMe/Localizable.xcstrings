    "Connecting Photos lets Whereday show pictures taken during this outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح ربط الصور Whereday عرض الصور التي تم التقاطها أثناء هذه النزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কানেক্ট করা ফটোগুলি Whereday এই আউটিংয়ের সময় তোলা ছবিগুলি দেখাতে দেয়৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos lets Whereday show pictures taken during this outing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos permite Whereday mostrar fotografías tomadas durante esta excursión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecting Photos permet à Whereday d'afficher les photos prises lors de cette sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोटो कनेक्ट करने से Whereday इस सैर के दौरान ली गई तस्वीरें दिखा सकता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を接続すると、 Wheredayにこの外出中に撮影した写真が表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie z biblioteką Zdjęć pozwala Whereday wyświetlać zdjęcia z tej podróży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar fotos permite que Whereday mostre fotos tiradas durante este passeio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключение фотографий позволяет Whereday показывать фотографии, сделанные во время этой прогулки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接照片可让Whereday显示这次郊游期间拍摄的照片。"
          }
        }
      }
    },
