          }
        }
      }
    },
    "Search for the place, choose it on the map, or select a saved location.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن المكان، أو اختره على الخريطة، أو حدد موقعًا محفوظًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্থানটি অনুসন্ধান করুন, মানচিত্রে এটি চয়ন করুন বা একটি সংরক্ষিত অবস্থান নির্বাচন করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for the place, choose it on the map, or select a saved location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque el lugar, selecciónelo en el mapa o seleccione una ubicación guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez le lieu, choisissez-le sur la carte ou sélectionnez un emplacement enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थान खोजें, इसे मानचित्र पर चुनें, या कोई सहेजा गया स्थान चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所を検索するか、地図上で選択するか、保存した場所を選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj miejsce, wybierz je na mapie lub wybierz zapisaną lokalizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Procure o local, escolha-o no mapa ou selecione um local salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите место, выберите его на карте или выберите сохраненное местоположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索地点、在地图上选择它或选择已保存的位置。"
          }
        }
      }
    },
