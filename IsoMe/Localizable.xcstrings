    "Where you stop. Lightest on battery." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حيث تتوقف. الأخف على البطارية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেখানে থামেন। ব্যাটারিতে সবচেয়ে হালকা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Where you stop. Lightest on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dónde paras. El que menos batería gasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Là où vous vous arrêtez. Le plus économe en batterie."
