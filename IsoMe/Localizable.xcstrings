    "Add places you visit to reuse their names, including places missing from Maps." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف الأماكن التي تزورها لإعادة استخدام أسمائها، بما فيها الأماكن غير الموجودة في الخرائط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেসব জায়গায় যান সেগুলো যোগ করুন, যাতে নাম আবার ব্যবহার করা যায় — Maps-এ নেই এমন জায়গাও।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add places you visit to reuse their names, including places missing from Maps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade los lugares que visitas para reutilizar sus nombres, incluidos los que no aparecen en Mapas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez les lieux que vous visitez pour réutiliser leur nom, y compris ceux absents de Plans."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जिन जगहों पर आप जाते हैं उन्हें जोड़ें ताकि उनके नाम फिर काम आएँ, Maps में न मिलने वाली जगहें भी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れる場所を追加して名前を再利用できます。マップにない場所も追加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj odwiedzane miejsca, także te nieobecne w Mapach, aby ponownie używać ich nazw."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione os lugares que você visita para reutilizar seus nomes, inclusive lugares que não estão no Mapas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте места, которые посещаете, чтобы снова использовать их названия, — даже если их нет в Картах."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加你到访的地点以便重复使用其名称，包括地图中没有的地点。"
          }
        }
      }
    },
