    "Unauthorized (HTTP 401). Check your credentials.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مصرح به ( HTTP 401). تحقق من بيانات الاعتماد الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অননুমোদিত ( HTTP 401)। আপনার শংসাপত্র পরীক্ষা করুন."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unauthorized (HTTP 401). Check your credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No autorizado ( HTTP 401). Verifique sus credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non autorisé ( HTTP 401). Vérifiez vos informations d'identification."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनधिकृत ( HTTP 401). अपनी साख जांचें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可されていません ( HTTP 401)。資格情報を確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieautoryzowany (HTTP 401). Sprawdź swoje dane uwierzytelniające."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não autorizado ( HTTP 401). Verifique suas credenciais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Несанкционировано ( HTTP 401). Проверьте свои учетные данные."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未经授权（ HTTP 401）。检查您的凭据。"
          }
        }
      }
    },
