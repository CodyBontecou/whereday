        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी किसी सहेजे गए स्थान का विश्लेषण ज़रूरी नहीं। जो जानकारी नहीं मिली, उसे एक घंटे बाद फिर आज़माया जा सकता है।"
