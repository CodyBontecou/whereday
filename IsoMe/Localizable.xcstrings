    "Times come from the visit. Editing them here changes only the calendar event, not your record." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأوقات مأخوذة من الزيارة. تعديلها هنا يغيّر حدث التقويم فقط، لا سجلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সময় ভিজিট থেকে নেওয়া। এখানে বদলালে শুধু ক্যালেন্ডার ইভেন্ট বদলায়, আপনার রেকর্ড নয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Times come from the visit. Editing them here changes only the calendar event, not your record."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las horas proceden de la visita. Si las editas aquí, solo cambia el evento del calendario, no tu registro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les heures proviennent de la visite. Les modifier ici ne change que l’événement du calendrier, pas votre donnée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "समय विज़िट से लिया गया है। यहाँ बदलने से सिर्फ़ कैलेंडर इवेंट बदलेगा, आपका रिकॉर्ड नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時刻は訪問から取得しています。ここで編集しても変わるのはカレンダーのイベントだけで、記録は変わりません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Godziny pochodzą z wizyty. Zmiana ich tutaj dotyczy tylko wydarzenia w kalendarzu, a nie Twojego zapisu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os horários vêm da visita. Editá-los aqui muda apenas o evento do calendário, não o seu registro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Время берётся из посещения. Изменения здесь затрагивают только событие календаря, а не вашу запись."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时间来自此次到访。在此编辑只会更改日历事件，不会更改你的记录。"
          }
        }
      }
    },
    "Timestamp and coordinates are always included." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تضمين الطابع الزمني والإحداثيات دائمًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "টাইমস্ট্যাম্প এবং স্থানাঙ্ক সবসময় অন্তর্ভুক্ত করা হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Timestamp and coordinates are always included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marca de tiempo y las coordenadas siempre se incluyen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'horodatage et les coordonnées sont toujours inclus."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "टाइमस्टैम्प और निर्देशांक हमेशा शामिल होते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムスタンプと座標は常に含まれます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Znacznik czasu i współrzędne są zawsze uwzględniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O carimbo de data e hora e as coordenadas são sempre incluídos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
