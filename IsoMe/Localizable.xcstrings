          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta visita después de la confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime cette visite après confirmation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के बाद इस विज़िट को हटा देता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後にこの訪問を削除します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa tę wizytę po potwierdzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclui esta visita após confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет этот визит после подтверждения."
          }
        },
        "zh-Hans": {
