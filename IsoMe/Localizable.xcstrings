    "POST all data types (visits, points, or both) to an external API or self-hosted server in real-time or batches. Supports OwnTracks, Overland, Dawarich, and generic JSON endpoints." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشر جميع أنواع البيانات (الزيارات أو النقاط أو كليهما) إلى واجهة API خارجية أو خادم مستضاف ذاتيًا في الوقت الفعلي أو على دفعات. يدعم نقاط النهاية OwnTracks و Overland وDawarich و JSON العامة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিয়েল-টাইম বা ব্যাচগুলিতে একটি বহিরাগত API বা স্ব-হোস্টেড সার্ভারে সমস্ত ডেটা প্রকার (ভিজিট, পয়েন্ট বা উভয়) পোস্ট করুন৷ OwnTracks , Overland , Dawarich, এবং জেনেরিক JSON এন্ডপয়েন্ট সমর্থন করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POST all data types (visits, points, or both) to an external API or self-hosted server in real-time or batches. Supports OwnTracks, Overland, Dawarich, and generic JSON endpoints."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía por POST todos los tipos de datos (visitas, puntos o ambos) a una API externa o a un servidor autohospedado en tiempo real o por lotes. Admite endpoints de OwnTracks, Overland, Dawarich y JSON genéricos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POSTEZ tous les types de données (visites, points ou les deux) sur une API externe ou un serveur auto-hébergé en temps réel ou par lots. Prend en charge les points de terminaison OwnTracks , Overland , Dawarich et JSON génériques."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी डेटा प्रकारों (विज़िट, पॉइंट या दोनों) को वास्तविक समय या बैचों में किसी बाहरी API या स्वयं-होस्ट किए गए सर्वर पर पोस्ट करें। OwnTracks , Overland , डावरिच और जेनेरिक JSON एंडपॉइंट्स का समर्थन करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのデータ タイプ (訪問数、ポイント、またはその両方) を外部APIまたは自己ホスト型サーバーにリアルタイムまたはバッチで POST します。 OwnTracks 、 Overland 、 Dawarich 、および汎用のJSONエンドポイントをサポートします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj wszystkie typy danych (wizyty, punkty lub oba) metodą POST do zewnętrznego API lub własnego serwera, na bieżąco lub partiami. Obsługuje OwnTracks, Overland, Dawarich i standardowe endpointy JSON."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POST todos os tipos de dados (visitas, pontos ou ambos) para uma API externa ou servidor auto-hospedado em tempo real ou em lotes. Suporta OwnTracks, Overland, Dawarich e endpoints JSON genéricos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "POST все типы данных (посещения, точки или и то, и другое) на внешний API или локальный сервер в режиме реального времени или в пакетном режиме. Поддерживает OwnTracks , Overland , Dawarich и общие конечные точки JSON ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将所有数据类型（到访、位置点或两者）实时或批量 POST 到外部 API 或自托管服务器。支持 OwnTracks、Overland、Dawarich 和通用 JSON 端点。"
          }
        }
      }
    },
    "Precise Location is off, so stops and routes come from rough positions and some stretches go unrecorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الموقع الدقيق متوقف، لذا تأتي التوقفات والمسارات من مواضع تقريبية وتبقى بعض المقاطع غير مسجّلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সুনির্দিষ্ট লোকেশন বন্ধ, তাই থামা ও রুট মোটামুটি অবস্থান থেকে আসে এবং কিছু অংশ রেকর্ড হয় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Precise Location is off, so stops and routes come from rough positions and some stretches go unrecorded."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ubicación exacta está desactivada, así que las paradas y rutas proceden de posiciones aproximadas y algunos tramos no se registran."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La position exacte est désactivée : les arrêts et les trajets proviennent de positions approximatives et certains passages ne sont pas enregistrés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सटीक स्थान बंद है, इसलिए पड़ाव और रूट मोटे अनुमान से बनते हैं और कुछ हिस्से रिकॉर्ड नहीं होते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「正確な位置情報」がオフのため、立ち寄りやルートはおおよその位置から作られ、記録されない区間もあります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dokładna lokalizacja jest wyłączona, więc postoje i trasy powstają z przybliżonych pozycji, a niektóre odcinki nie są rejestrowane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Localização Precisa está desativada, então paradas e trajetos vêm de posições aproximadas e alguns trechos ficam sem registro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точная геопозиция выключена, поэтому остановки и маршруты строятся по приблизительным данным, а некоторые отрезки не записываются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确位置已关闭，因此停留和路线来自粗略位置，部分行程不会被记录。"
          }
        }
      }
    },
