    "Adjust arrival and departure times, mark a visit as still in progress, and keep the visit history accurate." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بضبط أوقات الوصول والمغادرة، ووضع علامة على الزيارة على أنها لا تزال جارية، وحافظ على دقة سجل الزيارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগমন এবং প্রস্থানের সময় সামঞ্জস্য করুন, একটি ভিজিট এখনও চলছে বলে চিহ্নিত করুন এবং পরিদর্শনের ইতিহাস সঠিক রাখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjust arrival and departure times, mark a visit as still in progress, and keep the visit history accurate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste los horarios de llegada y salida, marque una visita como aún en curso y mantenga preciso el historial de visitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez les heures d'arrivée et de départ, marquez une visite comme étant toujours en cours et maintenez l'historique des visites précis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगमन और प्रस्थान के समय को समायोजित करें, किसी यात्रा को अभी भी जारी के रूप में चिह्नित करें और यात्रा के इतिहास को सटीक रखें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到着時間と出発時間を調整し、訪問を進行中としてマークし、訪問履歴を正確に保ちます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj godziny przyjazdu i wyjazdu, oznacz wizytę jako wciąż trwającą i prowadź dokładną historię wizyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste os horários de chegada e partida, marque uma visita como ainda em andamento e mantenha o histórico de visitas preciso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Регулируйте время прибытия и отправления, отмечайте посещение как продолжающееся и сохраняйте точность истории посещений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "调整到达和出发时间，将访问标记为仍在进行中，并保持访问历史记录的准确性。"
          }
        }
      }
    },
