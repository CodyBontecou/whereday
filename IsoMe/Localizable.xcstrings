    "Scheduled exports now use iOS background wakes, server nudges, and a tap-to-retry fallback notification to run closer to your chosen time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم عمليات التصدير المجدولة الآن تنبيهات الخلفية لنظام التشغيل iOS ، ودفعات الخادم، وإشعارًا احتياطيًا بالضغط لإعادة المحاولة للتشغيل بالقرب من الوقت الذي اخترته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্ধারিত রপ্তানি এখন iOS ব্যাকগ্রাউন্ড ওয়েকস, সার্ভার নাজ, এবং আপনার নির্বাচিত সময়ের কাছাকাছি চলার জন্য একটি ট্যাপ-টু-রিট্রাই ফলব্যাক বিজ্ঞপ্তি ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scheduled exports now use iOS background wakes, server nudges, and a tap-to-retry fallback notification to run closer to your chosen time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones programadas ahora utilizan activaciones en segundo plano iOS , empujones del servidor y una notificación alternativa de tocar para reintentar para ejecutarse más cerca de la hora elegida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exportations planifiées utilisent désormais les réveils en arrière-plan iOS , les nudges du serveur et une notification de secours en appuyant pour réessayer pour s'exécuter plus près de l'heure choisie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शेड्यूल किए गए निर्यात अब आपके चुने हुए समय के करीब चलने के लिए iOS बैकग्राउंड वेक, सर्वर नज और टैप-टू-रीट्री फ़ॉलबैक अधिसूचना का उपयोग करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールされたエクスポートは、 iOSバックグラウンド ウェイク、サーバー ナッジ、およびタップして再試行するフォールバック通知を使用して、選択した時刻に近づいて実行されるようになりました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaplanowane eksporty korzystają teraz z wybudzania w tle iOS, podpowiedzi serwera i powiadomienia awaryjnego typu „dotknij, aby ponowić próbę”, aby działać bliżej wybranego czasu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exportações agendadas agora usam ativações em segundo plano iOS , alertas de servidor e uma notificação de fallback de toque para tentar novamente para serem executadas mais perto do horário escolhido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запланированный экспорт теперь использует фоновое пробуждение iOS , подталкивание сервера и резервное уведомление о повторной попытке, чтобы выполнить его ближе к выбранному вами времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "计划导出现在使用iOS后台唤醒、服务器微移和点击重试后备通知来运行更接近您选择的时间。"
          }
        }
      }
    },
    "Search Apple Maps for a place or address, confirm it on the map, and save the visit without using your current GPS location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث في Apple Maps عن مكان أو عنوان، وقم بتأكيده على الخريطة، واحفظ الزيارة دون استخدام موقع GPS الحالي الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি স্থান বা ঠিকানার জন্য Apple Maps অনুসন্ধান করুন, মানচিত্রে এটি নিশ্চিত করুন এবং আপনার বর্তমান GPS অবস্থান ব্যবহার না করে পরিদর্শনটি সংরক্ষণ করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search Apple Maps for a place or address, confirm it on the map, and save the visit without using your current GPS location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Busque en Apple Maps un lugar o dirección, confírmelo en el mapa y guarde la visita sin utilizar su ubicación GPS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherchez un lieu ou une adresse Apple Maps , confirmez-le sur la carte et enregistrez la visite sans utiliser votre position GPS actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी स्थान या पते के लिए Apple Maps खोजें, मानचित्र पर इसकी पुष्टि करें, और अपने वर्तमान GPS स्थान का उपयोग किए बिना विज़िट को सहेजें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のGPS位置情報を使用せずに、 Apple Mapsで場所や住所を検索し、地図上で確認し、訪問を保存します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukaj w Apple Maps miejsce lub adres, potwierdź je na mapie i zapisz wizytę bez korzystania z bieżącej lokalizacji GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquise um local ou endereço Apple Maps , confirme-o no mapa e salve a visita sem usar sua localização GPS atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найдите в Apple Maps место или адрес, подтвердите его на карте и сохраните посещение, не используя текущее местоположение GPS ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在Apple Maps中搜索地点或地址，在地图上确认，然后保存访问，而无需使用当前的GPS位置。"
          }
        }
      }
    },
