    "Start a manual visit at a saved place or coordinates, then finish it with Check Out. Choose the visit when more than one is open.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ زيارة يدوية في مكان محفوظ أو عند إحداثيات، ثم أنهِها بـ«تسجيل المغادرة». اختر الزيارة عند وجود أكثر من زيارة مفتوحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a manual visit at a saved place or coordinates, then finish it with Check Out. Choose the visit when more than one is open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una visita manual en un lugar guardado o unas coordenadas y termínala con Registrar salida. Elige la visita si hay más de una abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une visite manuelle dans un lieu enregistré ou à des coordonnées, puis terminez-la avec Enregistrer le départ. Choisissez la visite lorsque plusieurs sont ouvertes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した場所や座標で手動の訪問を開始し、「チェックアウト」で終了します。複数の訪問が進行中のときは訪問を選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma visita manual em um lugar salvo ou em coordenadas e encerre com Registrar saída. Escolha a visita quando houver mais de uma aberta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已保存的地点或坐标开始一次手动到访，然后用“签退”结束。若有多个进行中的到访，请选择其中一个。"
          }
        }
      }
    },
    "Start a manual visit at a saved place, coordinates, or your current location. Overlaps require Allow Overlap to be explicitly enabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ زيارة يدوية في مكان محفوظ أو عند إحداثيات أو في موقعك الحالي. يتطلب التداخل تفعيل «السماح بالتداخل» صراحةً."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start a manual visit at a saved place, coordinates, or your current location. Overlaps require Allow Overlap to be explicitly enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia una visita manual en un lugar guardado, unas coordenadas o tu ubicación actual. Para solapar visitas hay que activar explícitamente Permitir solapamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez une visite manuelle dans un lieu enregistré, à des coordonnées ou à votre position actuelle. Les chevauchements nécessitent d’activer explicitement Autoriser le chevauchement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した場所、座標、または現在地で手動の訪問を開始します。重複させるには「重複を許可」を明示的にオンにする必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma visita manual em um lugar salvo, em coordenadas ou na sua localização atual. Sobreposições exigem que Permitir sobreposição esteja ativado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在已保存的地点、坐标或你的当前位置开始一次手动到访。如有重叠，需明确启用“允许重叠”。"
          }
        }
      }
    },
