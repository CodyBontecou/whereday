    },
    "The shape\nof your day.": {
      "comment": "Features headline: the visits, paths, and details that form a picture of a day. Use a natural editorial metaphor, not a literal geometric shape.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملامح\nيومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দিনের\nরূপরেখা।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shape\nof your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu día\ntoma forma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre journée\nse dessine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दिन की\nएक झलक।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日の軌跡を、\nひと目で。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dzień\nnabiera kształtu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu dia\nganha forma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш день\nв деталях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一天，\n清晰呈现。"
          }
        }
      }
    },
    "The start date must be before the end date.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون تاريخ البدء قبل تاريخ الانتهاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুরুর তারিখ অবশ্যই শেষের তারিখের আগে হতে হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The start date must be before the end date."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fecha de inicio debe ser anterior a la fecha de fin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La date de début doit être antérieure à la date de fin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रारंभ तिथि अवश्य समाप्ति तिथि से पहले होनी चाहिए।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始日は終了日より前である必要があります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Data początkowa musi przypadać przed datą końcową."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A data de início deve ser anterior à data de término."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Дата начала должна быть раньше даты окончания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始日期必须早于结束日期。"
          }
        }
      }
    },
    "The tracker is free. Export CSV with your existing lifetime export purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع مجاني. صدّر CSV بشراء التصدير مدى الحياة الذي تملكه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The tracker is free. Export CSV with your existing lifetime export purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento es gratuito. Exporta a CSV con tu compra de exportación de por vida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi est gratuit. Exportez en CSV grâce à votre achat à vie de l’exportation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トラッカーは無料です。購入済みの買い切りの書き出しでCSVを書き出せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie jest bezpłatne. Eksportuj CSV w ramach zakupionego dożywotniego dostępu do eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreador é gratuito. Exporte em CSV com sua compra vitalícia de exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "追踪功能免费。使用你现有的终身导出购买项目即可导出 CSV。"
          }
        }
      }
    },
    "The visit could not be loaded. Please try again.": {
