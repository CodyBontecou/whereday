    "Tap several export formats at once — JSON, CSV, Markdown, GPX, KML, GeoJSON, OwnTracks, and Overland — and Whereday prepares a separate file for each." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على العديد من تنسيقات التصدير في وقت واحد - JSON و CSV و Markdown و GPX و KML GeoJSON و OwnTracks و Overland - ويقوم Whereday بإعداد ملف منفصل لكل منها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একসাথে একাধিক এক্সপোর্ট ফরম্যাটে আলতো চাপুন — JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks , এবং Overland — এবং Whereday প্রতিটির জন্য আলাদা ফাইল প্রস্তুত করে৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap several export formats at once — JSON, CSV, Markdown, GPX, KML, GeoJSON, OwnTracks, and Overland — and Whereday prepares a separate file for each."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque varios formatos de exportación a la vez ( JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks y Overland ) e Whereday preparará un archivo separado para cada uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur plusieurs formats d'exportation à la fois — JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks et Overland — et Whereday prépare un fichier distinct pour chacun."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक साथ कई निर्यात प्रारूपों को टैप करें - JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks , और Overland - और Whereday प्रत्येक के लिए एक अलग फ़ाइल तैयार करता है।"
