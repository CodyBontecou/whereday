    "Start location tracking from your wrist, watch the live timer, and review today’s visits, distance, points, and current location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ تتبع الموقع من معصمك، وشاهد المؤقت المباشر، وراجع زيارات اليوم، والمسافة، والنقاط، والموقع الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার কব্জি থেকে অবস্থান ট্র্যাকিং শুরু করুন, লাইভ টাইমার দেখুন এবং আজকের পরিদর্শন, দূরত্ব, পয়েন্ট এবং বর্তমান অবস্থান পর্যালোচনা করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start location tracking from your wrist, watch the live timer, and review today’s visits, distance, points, and current location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie el seguimiento de ubicación desde su muñeca, mire el cronómetro en vivo y revise las visitas, la distancia, los puntos y la ubicación actual de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le suivi de localisation depuis votre poignet, regardez la minuterie en direct et consultez les visites, la distance, les points et la position actuelle du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी कलाई से स्थान ट्रैकिंग शुरू करें, लाइव टाइमर देखें और आज की यात्राओं, दूरी, बिंदुओं और वर्तमान स्थान की समीक्षा करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首から位置追跡を開始し、ライブタイマーを見て、今日の訪問、距離、ポイント、現在の位置を確認します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij śledzenie lokalizacji na nadgarstku, oglądaj stoper na żywo i przeglądaj dzisiejsze wizyty, dystans, punkty i bieżącą lokalizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o rastreamento de localização no seu pulso, assista ao cronômetro ao vivo e revise as visitas, distância, pontos e localização atual de hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните отслеживание местоположения со своего запястья, следите за таймером в реальном времени и просматривайте сегодняшние посещения, расстояние, баллы и текущее местоположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从手腕开始位置跟踪，观看实时计时器，并查看今天的访问、距离、点数和当前位置。"
          }
        }
      }
    },
    "Start now, or fine-tune tracking behavior later in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ الآن، أو قم بضبط سلوك التتبع لاحقًا في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনই শুরু করুন, অথবা পরে সেটিংসে ট্র্যাকিং আচরণকে সূক্ষ্ম-টিউন করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start now, or fine-tune tracking behavior later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience ahora o ajuste el comportamiento de seguimiento más adelante en Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez maintenant ou affinez le comportement de suivi plus tard dans Paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी शुरू करें, या बाद में सेटिंग्स में ट्रैकिंग व्यवहार को ठीक करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ開始するか、後で [設定] で追跡動作を微調整してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zacznij teraz lub dostosuj zachowanie śledzenia później w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece agora ou ajuste o comportamento de rastreamento mais tarde em Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните сейчас или настройте поведение отслеживания позже в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即开始，或稍后在“设置”中微调跟踪行为。"
          }
        }
      }
    },
    "Start or stop Whereday tracking directly on Apple Watch without opening your iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ أو أوقف تتبع Whereday مباشرة على Apple Watch دون فتح جهاز iPhone الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone না খুলে সরাসরি Apple Watch এ Whereday ট্র্যাকিং শুরু বা বন্ধ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start or stop Whereday tracking directly on Apple Watch without opening your iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o detenga el seguimiento de Whereday directamente en Apple Watch sin abrir su iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez ou arrêtez le suivi Whereday directement sur Apple Watch sans ouvrir votre iPhone."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना iPhone खोले बिना सीधे Apple Watch पर Whereday ट्रैकिंग प्रारंभ या बंद करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone を開かずに、 Apple Watchで直接Whereday追跡を開始または停止できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij lub zatrzymaj śledzenie Whereday bezpośrednio na Apple Watch bez otwierania iPhone'a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie ou interrompa o rastreamento Whereday diretamente no Apple Watch sem abrir o iPhone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускайте или останавливайте отслеживание Whereday прямо на Apple Watch не открывая iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需打开 iPhone，即可直接在Apple Watch上启动或停止Whereday跟踪。"
          }
        }
      }
    },
    "Start tracking": {
      "localizations": {
        "ar": {
          "stringUnit": {
