    "Whereday quietly writes down where you were, so you can look back at any day, place or trip." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يدوّن Whereday بهدوء أين كنت، لتعود إلى أي يوم أو مكان أو رحلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি কোথায় ছিলেন Whereday নিঃশব্দে লিখে রাখে, যাতে যেকোনো দিন, জায়গা বা ভ্রমণে ফিরে তাকাতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday quietly writes down where you were, so you can look back at any day, place or trip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday anota en silencio dónde estuviste, para que puedas volver a cualquier día, lugar o viaje."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday note discrètement où vous étiez, pour que vous puissiez revoir n’importe quel jour, lieu ou voyage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday चुपचाप लिखता जाता है कि आप कहाँ थे, ताकि आप कोई भी दिन, जगह या यात्रा फिर से देख सकें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wheredayはあなたがいた場所を静かに書き留めます。どの日、どの場所、どの旅もいつでも振り返れます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday po cichu zapisuje, gdzie byłeś, abyś mógł wrócić do każdego dnia, miejsca lub wyjazdu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Whereday anota, em silêncio, onde você esteve, para você rever qualquer dia, lugar ou viagem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday тихо записывает, где вы были, чтобы вы могли вернуться к любому дню, месту или поездке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday 默默记下你去过的地方，让你可以回顾任何一天、任何地点或任何一次旅程。"
          }
        }
      }
    },
    "Whereday stores only this photo's local identifier, timestamp, and coordinates. The photo file stays in your Photos library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم Whereday بتخزين المعرف المحلي لهذه الصورة والطابع الزمني والإحداثيات فقط. يبقى ملف الصورة في مكتبة الصور الخاصة بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday শুধুমাত্র এই ছবির স্থানীয় শনাক্তকারী, টাইমস্ট্যাম্প এবং স্থানাঙ্ক সংরক্ষণ করে। ফটো ফাইলটি আপনার ফটো লাইব্রেরিতে থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday stores only this photo's local identifier, timestamp, and coordinates. The photo file stays in your Photos library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday almacena sólo el identificador local, la marca de tiempo y las coordenadas de esta foto. El archivo de la foto permanece en su biblioteca de Fotos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday stocke uniquement l'identifiant local, l'horodatage et les coordonnées de cette photo. Le fichier photo reste dans votre bibliothèque Photos."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday केवल इस फोटो के स्थानीय पहचानकर्ता, टाइमस्टैम्प और निर्देशांक को संग्रहीत करता है। फ़ोटो फ़ाइल आपकी फ़ोटो लाइब्रेरी में रहती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wheredayは、この写真のローカル識別子、タイムスタンプ、および座標のみを保存します。写真ファイルは写真ライブラリに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday przechowuje tylko lokalny identyfikator, znacznik czasu i współrzędne tego zdjęcia. Plik zdjęcia pozostanie w Twojej bibliotece Zdjęć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday armazena apenas o identificador local, carimbo de data/hora e coordenadas desta foto. O arquivo da foto permanece na sua biblioteca de fotos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday хранит только локальный идентификатор, временную метку и координаты этой фотографии. Файл фотографии останется в вашей библиотеке фотографий."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday仅存储该照片的本地标识符、时间戳和坐标。照片文件保留在您的照片库中。"
          }
        }
      }
    },
    "Whereday uses your location to detect places you visit and trace your daily path." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Whereday موقعك لاكتشاف الأماكن التي تزورها وتتبع مسارك اليومي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday আপনার লোকেশন ব্যবহার করে আপনি যেসব জায়গায় যান এবং আপনার প্রতিদিনের পথ খুঁজে বের করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday uses your location to detect places you visit and trace your daily path."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday utiliza tu ubicación para detectar los lugares que visitas y rastrear tu ruta diaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday utilise votre localisation pour détecter les lieux que vous visitez et tracer votre parcours quotidien."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday आपके स्थान का उपयोग उन स्थानों का पता लगाने के लिए करता है जहां आप जाते हैं और आपके दैनिक पथ का पता लगाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wheredayはあなたの位置情報を使用して、あなたが訪れた場所を検出し、毎日の経路を記録します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday wykorzystuje Twoją lokalizację do wykrywania odwiedzanych miejsc i śledzenia Twojej codziennej ścieżki."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday usa sua localização para detectar lugares que você visita e traçar sua trajetória diária."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday использует ваше местоположение, чтобы определять места, которые вы посещаете, и отслеживать ваш ежедневный путь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday使用您的位置来检测您访问的地点并追踪您的日常路径。"
          }
        }
      }
    },
    "Which visit should be checked out?" : {
