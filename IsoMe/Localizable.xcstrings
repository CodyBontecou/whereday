        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cuánto\ndebe recordar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que doit-il\nretenir ?"
          }
