    "%@ is removed and its %lld visits become %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُزال %@ وتصبح زياراته البالغة %lld ضمن %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is removed and its %lld visits become %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se elimina y sus %lld visitas pasan a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est supprimé et ses %lld visites deviennent %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は削除され、その%lld件の訪問は%@になります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ será removido e suas %lld visitas passarão a ser %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将被移除，其 %lld 次到访将归入 %@。"
          }
        }
      }
    },
    "The match radius grows to %@ to cover both.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتّسع نطاق المطابقة إلى %@ ليشمل كليهما."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The match radius grows to %@ to cover both."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El radio de coincidencia aumenta a %@ para abarcar ambos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rayon d’association passe à %@ pour couvrir les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方を含むように、照合半径が%@に広がります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O raio de associação aumenta para %@ para abranger os dois."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配半径将扩大到 %@ 以涵盖两者。"
          }
        }
      }
    },
    "The places are too far apart for one circle, so only visits named after %@ move.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المكانان متباعدان جدًا لدائرة واحدة، لذا لن تُنقل إلا الزيارات المسمّاة باسم %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The places are too far apart for one circle, so only visits named after %@ move."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los lugares están demasiado lejos para un solo círculo, así que solo se mueven las visitas con el nombre de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lieux sont trop éloignés pour un seul cercle : seules les visites nommées d’après %@ sont déplacées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所が離れすぎていて1つの円に収まらないため、%@の名前が付いた訪問のみが移動します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lugares estão longe demais para um único círculo, então só as visitas com o nome %@ serão movidas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些地点相距太远，无法用一个圆圈涵盖，因此只会移动以 %@ 命名的到访。"
          }
        }
      }
    },
    "This can't be undone.": {
