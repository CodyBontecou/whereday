    "Places you return to that aren't saved yet. Save one to name its future visits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكن تعود إليها ولم تُحفظ بعد. احفظ أحدها لتسمية زياراته المستقبلية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Places you return to that aren't saved yet. Save one to name its future visits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares a los que vuelves y que aún no has guardado. Guarda uno para poner nombre a sus próximas visitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des lieux où vous revenez mais pas encore enregistrés. Enregistrez-en un pour nommer ses futures visites."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ保存していない、何度も訪れている場所です。保存すると今後の訪問に名前が付きます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugares aos quais você volta e que ainda não foram salvos. Salve um para dar nome às próximas visitas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你常回来但尚未保存的地点。保存一个即可为其今后的到访命名。"
          }
        }
      }
    },
    "Shows this spot's visits and rhythm, with an option to save it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض زيارات هذه البقعة وإيقاعها، مع خيار لحفظها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows this spot's visits and rhythm, with an option to save it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las visitas y el ritmo de este sitio, con la opción de guardarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche les visites et le rythme de cet endroit, avec la possibilité de l’enregistrer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この場所の訪問とリズムを表示し、保存することもできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as visitas e o ritmo deste ponto, com a opção de salvá-lo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示此处的到访和规律，并可选择保存。"
          }
        }
      }
    },
