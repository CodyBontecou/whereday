    "Use inferred movement to fill older days from GPS points that were saved before exact start/stop sessions existed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الحركة المستنتجة لملء الأيام القديمة من نقاط GPS التي تم حفظها قبل وجود جلسات البدء/الإيقاف المحددة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঠিক স্টার্ট/স্টপ সেশন বিদ্যমান থাকার আগে সংরক্ষিত GPS পয়েন্ট থেকে পুরানো দিনগুলি পূরণ করতে অনুমানকৃত মুভমেন্ট ব্যবহার করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use inferred movement to fill older days from GPS points that were saved before exact start/stop sessions existed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice el movimiento inferido para completar días más antiguos a partir de puntos GPS que se guardaron antes de que existieran las sesiones exactas de inicio/parada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les mouvements déduits pour remplir les jours plus anciens à partir des points GPS enregistrés avant que les sessions de démarrage/arrêt exactes n'existent."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS पॉइंट से पुराने दिनों को भरने के लिए अनुमानित मूवमेंट का उपयोग करें, जो सटीक प्रारंभ/स्टॉप सत्र मौजूद होने से पहले सहेजे गए थे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "推定された動きを使用して、正確な開始/停止セッションが存在する前に保存されたGPSポイントから古い日数を埋めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz szacowanie przemieszczeń, aby uzupełnić starsze dni na podstawie punktów GPS zapisanych przed wprowadzeniem dokładnych sesji z początkiem i końcem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o movimento inferido para preencher dias mais antigos a partir de pontos GPS que foram salvos antes da existência de sessões exatas de início/parada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте предполагаемое движение для заполнения более старых дней на основе точек GPS , которые были сохранены до того, как существовали точные сеансы начала/остановки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用推断的运动来根据精确开始/停止会话存在之前保存的GPS点来填补过去的日子。"
          }
        }
      }
    },
