    "Deleting a visit now closes its details screen correctly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف زيارة يُغلق الآن شاشة تفاصيلها بشكل صحيح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভিজিট মুছলে এখন এর বিবরণ স্ক্রিন সঠিকভাবে বন্ধ হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting a visit now closes its details screen correctly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al eliminar una visita, su pantalla de detalles ahora se cierra correctamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer une visite ferme désormais correctement son écran de détails."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विज़िट हटाने पर अब उसकी विवरण स्क्रीन ठीक से बंद होती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪問を削除すると、詳細画面が正しく閉じるようになりました。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie wizyty prawidłowo zamyka teraz ekran jej szczegółów."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir uma visita agora fecha a tela de detalhes corretamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
