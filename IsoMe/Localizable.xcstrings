    "View app activity logs or chat with the community." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عرض سجلات نشاط التطبيق أو الدردشة مع المجتمع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ কার্যকলাপ লগ দেখুন বা সম্প্রদায়ের সাথে চ্যাট."
          }
        },
