          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्पष्टीकरण दिखाएँ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明を表示"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż wyjaśnienie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar explicação"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать объяснение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示说明"
          }
        }
      }
    },
    "Show an outing on the main map to focus the exact route, start and finish markers, and cleaned-up current visit state.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرض نزهة على الخريطة الرئيسية للتركيز على المسار الدقيق وعلامات البداية والنهاية وحالة الزيارة الحالية التي تم تنظيفها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সঠিক রুট ফোকাস করতে প্রধান মানচিত্রে একটি আউটিং দেখান, মার্কার শুরু এবং শেষ করুন এবং বর্তমান পরিদর্শন অবস্থা পরিষ্কার করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show an outing on the main map to focus the exact route, start and finish markers, and cleaned-up current visit state."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestre una excursión en el mapa principal para enfocar la ruta exacta, los marcadores de inicio y finalización y el estado actual de la visita limpio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez une sortie sur la carte principale pour vous concentrer sur l'itinéraire exact, les marqueurs de début et de fin et l'état actuel de la visite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सटीक मार्ग, प्रारंभ और समापन मार्करों और साफ-सुथरी वर्तमान यात्रा स्थिति पर ध्यान केंद्रित करने के लिए मुख्य मानचित्र पर एक सैर दिखाएं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メイン マップに外出を表示して、正確なルート、開始マーカーと終了マーカー、およびクリーンアップされた現在の訪問状態に焦点を当てます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż podróż na głównej mapie, aby skupić się na dokładnej trasie, znacznikach rozpoczęcia i zakończenia oraz uporządkowanym bieżącym stanie wizyty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre um passeio no mapa principal para focar a rota exata, marcadores de início e fim e estado atual da visita limpo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покажите прогулку на главной карте, чтобы указать точный маршрут, маркеры начала и окончания, а также очистить текущее состояние посещения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主地图上显示一次郊游，以关注确切的路线、起点和终点标记，并清理当前的访问状态。"
          }
        }
      }
    },
    "Show tracking progress on the Lock Screen and Dynamic Island. Your choice is saved for future tracking sessions.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إظهار تقدم التتبع على شاشة القفل والجزيرة الديناميكية. يتم حفظ اختيارك لجلسات التتبع المستقبلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লক স্ক্রীন এবং ডায়নামিক দ্বীপে ট্র্যাকিং অগ্রগতি দেখান। আপনার পছন্দ ভবিষ্যতের ট্র্যাকিং সেশনের জন্য সংরক্ষিত হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show tracking progress on the Lock Screen and Dynamic Island. Your choice is saved for future tracking sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el progreso del seguimiento en la pantalla de bloqueo y en la isla dinámica. Su elección se guarda para futuras sesiones de seguimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher la progression du suivi sur l'écran de verrouillage et Dynamic Island. Votre choix est enregistré pour les futures sessions de suivi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक स्क्रीन और डायनेमिक आइलैंड पर ट्रैकिंग प्रगति दिखाएं। आपकी पसंद भविष्य के ट्रैकिंग सत्रों के लिए सहेजी गई है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロック画面とダイナミックアイランドに追跡の進行状況を表示します。選択内容は、今後の追跡セッションのために保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyświetlaj postęp śledzenia na ekranie blokady i w Dynamic Island. Twój wybór zostanie zapamiętany dla kolejnych sesji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostre o progresso do rastreamento na tela de bloqueio e na ilha dinâmica. Sua escolha é salva para futuras sessões de rastreamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать прогресс отслеживания на экране блокировки и в динамическом острове. Ваш выбор сохраняется для будущих сеансов отслеживания."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在锁定屏幕和动态岛上显示跟踪进度。您的选择将被保存以供将来的跟踪会话使用。"
          }
        }
      }
    },
