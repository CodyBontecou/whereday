          "stringUnit" : {
            "state" : "translated",
            "value" : "কোথায় ছবি তুলেছেন তা আরও স্পষ্টভাবে দেখতে মানচিত্র ফিল্টারে “ছবির বিন্দু” চালু করুন। আপনার পছন্দ সংরক্ষিত থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Photo dots in the map filters for a clearer view of where you took your photos. Your choice is saved."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activa Puntos de fotos en los filtros del mapa para ver con más claridad dónde tomaste tus fotos. Tu elección se guarda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Points photo dans les filtres de la carte pour voir plus clairement où vous avez pris vos photos. Votre choix est enregistré."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपने फ़ोटो कहाँ लीं, यह साफ़ देखने के लिए मानचित्र फ़िल्टर में फ़ोटो बिंदु चालू करें। आपकी पसंद सहेज ली जाती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図のフィルターで「写真のドット」をオンにすると、写真を撮った場所が見やすくなります。選択内容は保存されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz punkty zdjęć w filtrach mapy, aby lepiej widzieć miejsca wykonania zdjęć. Twój wybór zostanie zapamiętany."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative Pontos de fotos nos filtros do mapa para ver com mais clareza onde você tirou suas fotos. Sua escolha fica salva."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите «Фото точками» в фильтрах карты, чтобы лучше видеть, где вы снимали. Выбор сохранится."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在地图筛选中打开“照片圆点”，更清楚地查看你在哪里拍了照片。你的选择会被保存。"
          }
        }
      }
    },
