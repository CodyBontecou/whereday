    "Track your days. Revisit your places.\nKeep your history private and on-device." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجّل أيامك وعُد إلى أماكنك.\nتبقى سجلاتك خاصة وعلى جهازك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দিনের চলাফেরা লিখে রাখুন। ফিরে দেখুন আপনার জায়গাগুলো।\nআপনার ইতিহাস ব্যক্তিগত, আপনার ডিভাইসেই।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track your days. Revisit your places.\nKeep your history private and on-device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra tus días. Vuelve a tus lugares.\nTu historial, privado y en tu dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gardez une trace de vos journées. Retrouvez vos lieux.\nVotre historique reste privé, sur votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने दिन दर्ज करें। अपनी जगहों को फिर देखें।\nआपका इतिहास निजी है, आपके डिवाइस पर ही।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々を記録し、訪れた場所を振り返る。\n履歴はデバイスの中に、あなただけのもの。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj swoje dni. Wracaj do swoich miejsc.\nTwoja historia jest prywatna i zostaje na urządzeniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registre seus dias. Relembre seus lugares.\nSeu histórico fica privado, no seu dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывайте дни. Возвращайтесь к своим местам.\nВаша история конфиденциальна и хранится на устройстве."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录日常，重温足迹。\n历史记录保存在设备上，私密由你掌握。"
          }
        }
      }
    },
