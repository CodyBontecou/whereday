    "Choose 25–10,000 meters; type a value above 500. Past visits keep their names." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر بين 25 و10,000 متر؛ اكتب القيمة إذا تجاوزت 500. تحتفظ الزيارات السابقة بأسمائها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25–10,000 মিটার বেছে নিন; 500-এর বেশি হলে মান টাইপ করুন। আগের ভিজিটের নাম অপরিবর্তিত থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose 25–10,000 meters; type a value above 500. Past visits keep their names."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige entre 25 y 10.000 metros; escribe el valor si supera 500. Las visitas pasadas conservan sus nombres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez entre 25 et 10 000 mètres ; saisissez une valeur au-delà de 500. Les visites passées gardent leur nom."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25–10,000 मीटर चुनें; 500 से ज़्यादा के लिए मान टाइप करें। पिछली विज़िट के नाम वही रहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "25〜10,000メートルで指定してください。500を超える値は直接入力してください。過去の訪問の名前は変わりません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz od 25 do 10 000 metrów; wartość powyżej 500 wpisz ręcznie. Wcześniejsze wizyty zachowują swoje nazwy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha de 25 a 10.000 metros; digite um valor acima de 500. As visitas anteriores mantêm seus nomes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите от 25 до 10 000 метров; значения больше 500 вводите вручную. Прошлые посещения сохранят свои названия."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请选择 25–10,000 米；超过 500 的值请手动输入。过去的到访会保留原名称。"
          }
        }
      }
    },
