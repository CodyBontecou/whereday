    "Deletes this outing and its GPS points after confirmation. Visits are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف هذه النزهة ونقاط GPS الخاصة بها بعد التأكيد. يتم الاحتفاظ بالزيارات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিতকরণের পরে এই আউটিং এবং এর GPS পয়েন্টগুলি মুছে দেয়। ভিজিট রাখা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deletes this outing and its GPS points after confirmation. Visits are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina esta salida y sus puntos GPS tras la confirmación. Se mantienen las visitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime cette sortie et ses points GPS après confirmation. Les visites sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुष्टि के बाद इस आउटिंग और इसके GPS पॉइंट को हटा देता है। दौरे होते रहते हैं."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認後、この外出とそのGPSポイントを削除します。訪問は維持されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po potwierdzeniu usuwa tę podróż i jej punkty GPS. Wizyty zostają zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga este passeio e seus pontos GPS após confirmação. As visitas estão mantidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет эту прогулку и ее точки GPS после подтверждения. Посещения сохраняются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后删除本次郊游及其GPS点。访问被保留。"
          }
        }
      }
    },
    "Deletes this visit after confirmation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف هذه الزيارة بعد التأكيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিতকরণের পরে এই দর্শন মুছে দেয়।"
          }
        },
        "en": {
