    "Grant location access in iPhone Settings → Whereday → Location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امنح الوصول إلى الموقع في إعدادات iPhone → Whereday → الموقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone সেটিংস → Whereday → অবস্থানে অবস্থান অ্যাক্সেস মঞ্জুর করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant location access in iPhone Settings → Whereday → Location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otorgue acceso a la ubicación en Configuración iPhone → Whereday → Ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez l'accès à la localisation dans Paramètres iPhone → Whereday → Localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone सेटिंग्स → Whereday → स्थान में स्थान पहुंच प्रदान करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone 「設定」→ Whereday 」→「位置情報」で位置情報へのアクセスを許可します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj dostęp do lokalizacji w Ustawieniach iPhone → Whereday → Lokalizacja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso à localização em Configurações iPhone → Whereday → Localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предоставьте доступ к местоположению в настройках iPhone → Whereday → Местоположение."
