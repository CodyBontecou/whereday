    "Glanceable, battery-aware, and deeply contextual when you need it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن إلقاء نظرة سريعة عليها، ومعرفة بالبطارية، وسياق عميق عندما تحتاج إليها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক নজরে দেখার মতো, ব্যাটারি-সচেতন, আর প্রয়োজনে গভীরভাবে প্রাসঙ্গিক।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glanceable, battery-aware, and deeply contextual when you need it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fácil de consultar de un vistazo, eficiente con la batería y con todo el contexto cuando lo necesitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultable, sensible à la batterie et profondément contextuel lorsque vous en avez besoin."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ज़रूरत पड़ने पर नज़र डालने योग्य, बैटरी के प्रति जागरूक और गहराई से प्रासंगिक।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一目でわかり、バッテリーを認識し、必要なときに詳細なコンテキストを把握できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Najważniejsze informacje pod ręką, z troską o baterię i szczegółami wtedy, gdy ich potrzebujesz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visível, com reconhecimento de bateria e profundamente contextual quando você precisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удобный для просмотра, с учетом заряда батареи и глубоко контекстуальный, когда вам это нужно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一目了然，电池感知，并在您需要时深入了解上下文。"
          }
        }
      }
    },
