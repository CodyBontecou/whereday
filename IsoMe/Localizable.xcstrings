    "No purchase found. For a Family plan, confirm that Purchase Sharing is enabled, then try again.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على عملية شراء. للخطة العائلية، تأكد من تفعيل مشاركة المشتريات ثم حاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোনো কেনাকাটা পাওয়া যায়নি। ফ্যামিলি প্ল্যানের জন্য পারচেজ শেয়ারিং চালু আছে কি না নিশ্চিত করে আবার চেষ্টা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No purchase found. For a Family plan, confirm that Purchase Sharing is enabled, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ninguna compra. Para un plan Familiar, confirma que Compartir compras esté activado y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun achat trouvé. Pour une formule Famille, vérifiez que le partage des achats est activé, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई खरीदारी नहीं मिली। फ़ैमिली प्लान के लिए पक्का करें कि परचेज़ शेयरिंग चालू है, फिर कोशिश करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入が見つかりません。ファミリープランの場合は「購入アイテムの共有」が有効か確認し、もう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono zakupu. W przypadku planu rodzinnego potwierdź, że udostępnianie zakupów jest włączone, a następnie spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma compra encontrada. Para um plano Família, confirme se o Compartilhamento de Compras está ativado e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Покупка не найдена. Для семейного плана включите общий доступ к покупкам и повторите попытку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到购买项目。若使用家庭方案，请确认已开启购买项目共享，然后重试。"
          }
        }
      }
    },
    "No saved locations need analysis right now. Unavailable lookups can be retried after an hour.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد مواقع محفوظة تحتاج إلى تحليل الآن. يمكن إعادة محاولة عمليات البحث غير المتاحة بعد ساعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No saved locations need analysis right now. Unavailable lookups can be retried after an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora no hay ubicaciones guardadas que analizar. Las búsquedas no disponibles se pueden reintentar al cabo de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune position enregistrée n’a besoin d’être analysée pour l’instant. Les recherches indisponibles pourront être relancées dans une heure."
          }
        },
        "ja": {
