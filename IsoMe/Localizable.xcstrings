    "Markdown exports this outing as a page with YAML front matter, visits, and route points." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم Markdown بتصدير هذه النزهة كصفحة تحتوي على واجهة YAML والزيارات ونقاط الطريق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown এই আউটিংটিকে YAML ফ্রন্ট ম্যাটার, ভিজিট এবং রুট পয়েন্ট সহ একটি পৃষ্ঠা হিসাবে রপ্তানি করে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown exports this outing as a page with YAML front matter, visits, and route points."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown exporta esta salida como una página con front matter YAML, visitas y puntos de ruta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown exporte cette sortie sous forme de page avec un en-tête YAML (front matter), des visites et des points d'itinéraire."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown इस आउटिंग को YAML फ्रंट मैटर, विज़िट और रूट पॉइंट वाले पेज के रूप में निर्यात करता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdownは、この外出をYAMLフロントマター、訪問、ルートポイントを含むページとしてエクスポートします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown eksportuje tę podróż jako stronę z nagłówkiem YAML, wizytami i punktami trasy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Markdown exporta este passeio como uma página com front matter YAML, visitas e pontos do trajeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown экспортирует эту прогулку в виде страницы с вступительной частью YAML, посещениями и точками маршрута."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown将此活动导出为包含YAML标题、访问和路由点的页面。"
          }
        }
      }
    },
    "Markdown outing exports include YAML front matter, notes, visits, and route points so they drop cleanly into a journal or PKM system." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشتمل ملفات Markdown المصدّرة للنزهات على مادة YAML الأمامية والملاحظات والزيارات ونقاط المسار بحيث يتم إسقاطها بشكل نظيف في دفتر اليومية أو نظام PKM."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown আউটিং এক্সপোর্টের মধ্যে YAML ফ্রন্ট ম্যাটার, নোট, ভিজিট এবং রুট পয়েন্ট অন্তর্ভুক্ত থাকে যাতে তারা পরিষ্কারভাবে একটি জার্নাল বা PKM সিস্টেমে চলে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown outing exports include YAML front matter, notes, visits, and route points so they drop cleanly into a journal or PKM system."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las exportaciones de salidas Markdown incluyen información preliminar YAML , notas, visitas y puntos de ruta para que se incluyan limpiamente en un diario o sistema PKM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les exportations de sorties Markdown incluent l'en-tête YAML (front matter), les notes, les visites et les points d'itinéraire afin qu'ils soient déposés proprement dans un journal ou un système PKM."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Markdown आउटिंग निर्यात में YAML फ्रंट मैटर, नोट्स, विज़िट और रूट पॉइंट शामिल होते हैं ताकि वे जर्नल या पीकेएम सिस्टम में आसानी से जुड़ जाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MarkdownでエクスポートしたファイルにはYAMLフロントマター、メモ、訪問、ルートポイントが含まれるため、ジャーナルやPKMシステムにそのまま取り込めます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport podróży w Markdown zawiera nagłówek YAML, notatki, wizyty i punkty trasy, dzięki czemu łatwo dodać go do dziennika lub systemu zarządzania wiedzą."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As exportações de passeios em Markdown incluem front matter YAML, notas, visitas e pontos do trajeto, para entrarem sem ajustes em um diário ou sistema PKM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспорт Markdown включает в себя вступительную часть YAML , заметки, посещения и точки маршрута, поэтому они легко попадают в журнал или систему PKM."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
