    "The visits Whereday logged in a chosen date range. Defaults to today." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الزيارات التي سجلها Whereday في نطاق زمني تختاره. الافتراضي هو اليوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বেছে নেওয়া তারিখ ব্যাপ্তিতে Whereday-এ লগ করা ভিজিট। ডিফল্ট হলো আজ।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The visits Whereday logged in a chosen date range. Defaults to today."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las visitas que Whereday registró en un rango de fechas elegido. El valor predeterminado es hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les visites consignées par Whereday dans une plage de dates choisie. Par défaut, aujourd'hui."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चुनी गई तिथि सीमा में Whereday द्वारा लॉग की गई विज़िट। डिफ़ॉल्ट रूप से आज।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した日付範囲にWheredayが記録した訪問。デフォルトは今日です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wizyty zarejestrowane przez Whereday w wybranym zakresie dat. Domyślnie: dzisiaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As visitas que o Whereday registrou em um período escolhido. O padrão é hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посещения, записанные Whereday за выбранный диапазон дат. По умолчанию — сегодня."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday 在选定日期范围内记录的访问。默认为今天。"
          }
        }
      }
    },
