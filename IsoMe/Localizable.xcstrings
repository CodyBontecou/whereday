    "Choose where the visit happened. Your current GPS location will not be used.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مكان حدوث الزيارة. لن يتم استخدام موقع GPS الحالي الخاص بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে পরিদর্শন ঘটেছে চয়ন করুন। আপনার বর্তমান GPS অবস্থান ব্যবহার করা হবে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose where the visit happened. Your current GPS location will not be used."
          }
        },
        "es": {
