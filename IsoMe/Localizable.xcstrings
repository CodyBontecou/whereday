    "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط أي صورة مصغّرة لعرضها بملء الشاشة، ثم استخدم الأسهم للتنقل بين كل الصور في هذه المجموعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca cualquier miniatura para verla a pantalla completa y usa las flechas para recorrer todas las fotos de este grupo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une miniature pour l’afficher en plein écran, puis utilisez les flèches pour parcourir toutes les photos du groupe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイルをタップすると全画面で表示され、矢印でこのグループのすべての写真を移動できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij miniaturę, aby wyświetlić zdjęcie na pełnym ekranie, a następnie użyj strzałek, aby przeglądać wszystkie zdjęcia z tej grupy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer miniatura para vê-la em tela cheia e use as setas para percorrer todas as fotos deste grupo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "轻点任意缩略图即可全屏查看，然后使用箭头浏览此组中的所有照片。"
          }
        }
      }
    },
    "Tap any thumbnail to view it full screen, then use the arrows to move through the photos from this place.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أي صورة مصغرة لمشاهدتها بملء الشاشة، ثم استخدم الأسهم للتنقل عبر الصور من هذا المكان."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেকোন থাম্বনেইলটিকে পূর্ণ স্ক্রীনে দেখতে আলতো চাপুন, তারপর এই স্থান থেকে ফটোগুলি সরাতে তীরগুলি ব্যবহার করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap any thumbnail to view it full screen, then use the arrows to move through the photos from this place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque cualquier miniatura para verla en pantalla completa, luego use las flechas para moverse por las fotos desde ese lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur n'importe quelle vignette pour l'afficher en plein écran, puis utilisez les flèches pour vous déplacer parmi les photos à partir de cet endroit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी भी थंबनेल को पूर्ण स्क्रीन पर देखने के लिए उस पर टैप करें, फिर इस स्थान से फ़ोटो में जाने के लिए तीरों का उपयोग करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サムネイルをタップして全画面表示し、矢印を使用してこの場所から写真間を移動します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dowolną miniaturę, aby wyświetlić ją na pełnym ekranie, a następnie użyj strzałek, aby poruszać się po zdjęciach z tego miejsca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em qualquer miniatura para visualizá-la em tela inteira e use as setas para percorrer as fotos deste local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь любой миниатюры, чтобы просмотреть ее в полноэкранном режиме, затем используйте стрелки для перемещения по фотографиям с этого места."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击任意缩略图即可全屏查看，然后使用箭头在此位置浏览照片。"
          }
        }
      }
    },
    "Tap more formats to export multiple files at once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على المزيد من التنسيقات لتصدير ملفات متعددة مرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে একাধিক ফাইল রপ্তানি করতে আরও ফর্ম্যাটে আলতো চাপুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap more formats to export multiple files at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque más formatos para exportar varios archivos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur plus de formats pour exporter plusieurs fichiers à la fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ अनेक फ़ाइलें निर्यात करने के लिए अधिक प्रारूप टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のファイルを一度にエクスポートするには、「その他の形式」をタップします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij więcej formatów, aby wyeksportować wiele plików jednocześnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em mais formatos para exportar vários arquivos de uma vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите другие форматы, чтобы экспортировать несколько файлов одновременно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击更多格式可一次导出多个文件。"
          }
        }
      }
    },
    "Tap several export formats at once — JSON, CSV, Markdown, GPX, KML, GeoJSON, OwnTracks, and Overland — and Whereday prepares a separate file for each.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على العديد من تنسيقات التصدير في وقت واحد - JSON و CSV و Markdown و GPX و KML GeoJSON و OwnTracks و Overland - ويقوم Whereday بإعداد ملف منفصل لكل منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসাথে একাধিক এক্সপোর্ট ফরম্যাটে আলতো চাপুন — JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks , এবং Overland — এবং Whereday প্রতিটির জন্য আলাদা ফাইল প্রস্তুত করে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap several export formats at once — JSON, CSV, Markdown, GPX, KML, GeoJSON, OwnTracks, and Overland — and Whereday prepares a separate file for each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque varios formatos de exportación a la vez ( JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks y Overland ) e Whereday preparará un archivo separado para cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur plusieurs formats d'exportation à la fois — JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks et Overland — et Whereday prépare un fichier distinct pour chacun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक साथ कई निर्यात प्रारूपों को टैप करें - JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks , और Overland - और Whereday प्रत्येक के लिए एक अलग फ़ाइल तैयार करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のエクスポート形式 ( JSON 、 CSV 、 Markdown 、 GPX 、 KML 、 GeoJSON 、 OwnTracks 、 Overland ) を一度にタップすると、 Wheredayそれぞれに個別のファイルを準備します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kilka formatów eksportu jednocześnie — JSON, CSV, Markdown, GPX, KML, GeoJSON, OwnTracks i Overland — a Whereday przygotuje dla każdego osobny plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em vários formatos de exportação ao mesmo tempo – JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks e Overland – e Whereday prepara um arquivo separado para cada um."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сразу несколько форматов экспорта — JSON , CSV , Markdown , GPX , KML , GeoJSON , OwnTracks и Overland — и Whereday подготовит для каждого отдельный файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次点击多种导出格式 - JSON 、 CSV 、 Markdown 、 GPX 、 KML 、 GeoJSON 、 OwnTracks和Overland - Whereday会为每种格式准备一个单独的文件。"
          }
        }
      }
    },
    "Tap the map to place the pin exactly where the visit happened.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على الخريطة لوضع الدبوس في المكان الذي تمت فيه الزيارة بالضبط."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে ভিজিট হয়েছিল ঠিক সেখানে পিন বসাতে ম্যাপে আলতো চাপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the map to place the pin exactly where the visit happened."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque el mapa para colocar el marcador exactamente donde ocurrió la visita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur la carte pour placer l'épingle exactement à l'endroit où la visite a eu lieu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन को ठीक उसी स्थान पर लगाने के लिए मानचित्र पर टैप करें जहां यात्रा हुई थी।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップして、訪問が行われた場所にピンを正確に配置します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij mapę, aby umieścić pinezkę dokładnie w miejscu, w którym miała miejsce wizyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque no mapa para colocar o alfinete exatamente onde a visita aconteceu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь карты, чтобы отметить место, где произошел визит."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击地图将图钉准确放置在访问发生的位置。"
          }
        }
      }
    },
    "Tap the map to place the pin exactly where you want it.": {
