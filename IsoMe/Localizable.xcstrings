    },
    "These times overlap your visit to %@. Review the times or save both visits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتداخل هذه الأوقات مع زيارتك إلى %@. راجع الأوقات أو احفظ الزيارتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সময়গুলি %@-এ আপনার পরিদর্শনের সঙ্গে মিলে যাচ্ছে। সময়গুলি পর্যালোচনা করুন অথবা উভয় পরিদর্শন সংরক্ষণ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These times overlap your visit to %@. Review the times or save both visits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas horas se superponen con tu visita a %@. Revisa las horas o guarda ambas visitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces horaires chevauchent votre visite à %@. Vérifiez les horaires ou enregistrez les deux visites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ये समय %@ की आपकी विज़िट से ओवरलैप होते हैं। समय जाँचें या दोनों विज़िट सहेजें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この時間は%@への訪問と重複しています。時間を確認するか、両方の訪問を保存してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te godziny nakładają się na wizytę w miejscu %@. Sprawdź godziny lub zapisz obie wizyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes horários se sobrepõem à sua visita a %@. Revise os horários ou salve as duas visitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это время пересекается с вашим посещением %@. Проверьте время или сохраните оба посещения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此时间与您到访%@的时间重叠。请检查时间或保存两次到访。"
          }
        }
      }
    },
