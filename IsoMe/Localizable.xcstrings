          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "App Storeの購入証明をmyself.mdに送信します。健康データと位置データはデバイスに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviamos o comprovante da sua compra na App Store ao myself.md. Seus dados de saúde e localização ficam no seu dispositivo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会将你的 App Store 购买凭证发送给 myself.md。你的健康和位置数据仍保留在设备上。"
          }
        }
      }
    },
    "Choose the account that gets it": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر الحساب الذي سيحصل عليه"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the account that gets it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige la cuenta que lo recibe"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le compte bénéficiaire"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取るアカウントを選ぶ"
          }
        },
        "pt-BR": {
