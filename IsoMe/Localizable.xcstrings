    "Background visit detection lets Whereday keep recording when the app is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتيح اكتشاف الزيارة في الخلفية Whereday الاستمرار في التسجيل عند إغلاق التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ড ভিজিট ডিটেকশন Whereday অ্যাপ বন্ধ হয়ে গেলে রেকর্ডিং রাখতে দেয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background visit detection lets Whereday keep recording when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de visitas en segundo plano permite Whereday seguir grabando cuando la aplicación está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des visites en arrière-plan permet à Whereday de continuer à enregistrer lorsque l'application est fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकग्राउंड विज़िट डिटेक्शन से ऐप बंद होने पर Whereday रिकॉर्डिंग जारी रखने की सुविधा मिलती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンド訪問検出により、 Wheredayアプリを閉じても記録を継続できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykrywanie wizyt w tle pozwala Whereday rejestrować dane, gdy aplikacja jest zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção de visitas em segundo plano permite que Whereday continue gravando quando o aplicativo é fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обнаружение фоновых посещений позволяет Whereday продолжать запись, когда приложение закрыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台访问检测让Whereday在应用程序关闭时继续记录。"
          }
        }
      }
    },
    "Background visit detection requires extended location access so Whereday keeps recording when the app is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب اكتشاف الزيارة في الخلفية وصولاً ممتدًا إلى الموقع، لذا يستمر Whereday في التسجيل عند إغلاق التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকগ্রাউন্ড ভিজিট ডিটেকশনের জন্য বর্ধিত লোকেশন অ্যাক্সেসের প্রয়োজন হয় তাই অ্যাপ বন্ধ থাকা অবস্থায় Whereday রেকর্ডিং রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Background visit detection requires extended location access so Whereday keeps recording when the app is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La detección de visitas en segundo plano requiere acceso extendido a la ubicación, por lo que Whereday sigue grabando cuando la aplicación está cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La détection des visites en arrière-plan nécessite un accès étendu à la localisation afin Whereday continue d'enregistrer lorsque l'application est fermée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पृष्ठभूमि विज़िट का पता लगाने के लिए विस्तारित स्थान पहुंच की आवश्यकता होती है, इसलिए ऐप बंद होने पर Whereday रिकॉर्डिंग करता रहता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドでの訪問検出には拡張位置アクセスが必要なため、アプリを閉じてもWhereday記録を継続します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykrywanie wizyt w tle wymaga rozszerzonego dostępu do lokalizacji, aby Whereday mogło rejestrować dane, gdy aplikacja jest zamknięta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A detecção de visitas em segundo plano requer acesso estendido à localização, portanto Whereday continua gravando quando o aplicativo é fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для обнаружения фоновых посещений требуется расширенный доступ к местоположению, поэтому Whereday продолжает запись, когда приложение закрыто."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台访问检测需要扩展位置访问权限，因此Whereday在应用程序关闭时会持续记录。"
          }
        }
      }
    },
    "Begin recording your route in Whereday.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ بتسجيل مسارك في Whereday."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday এ আপনার রুট রেকর্ড করা শুরু করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin recording your route in Whereday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience a grabar su ruta en Whereday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commencez à enregistrer votre itinéraire dans Whereday."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday में अपना मार्ग रिकॉर्ड करना प्रारंभ करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday でルートの記録を開始します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij rejestrowanie trasy w Whereday."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece a gravar sua rota no Whereday."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните записывать свой маршрут в Whereday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始在 Whereday 中记录您的路线。"
          }
        }
      }
    },
    "Both dates count, including a same-day visit. Recorded presence in other countries is kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب التاريخان، بما في ذلك زيارة اليوم نفسه. يُحتفظ بالحضور المسجّل في دول أخرى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both dates count, including a same-day visit. Recorded presence in other countries is kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuentan ambas fechas, incluida una visita en el mismo día. Se conserva la presencia registrada en otros países."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les deux dates comptent, y compris pour une visite d’un jour. La présence enregistrée dans d’autres pays est conservée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ日の訪問を含め、両方の日付を数えます。他の国で記録された滞在はそのまま残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obie daty są wliczane, także przy wizycie jednodniowej. Zarejestrowane pobyty w innych krajach zostają zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As duas datas contam, inclusive numa visita no mesmo dia. A presença registrada em outros países é mantida."
