    "The iPhone app refreshes when your Watch sends an outing's completion update.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحدّث تطبيق iPhone عندما ترسل ساعتك تحديث اكتمال نزهة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The iPhone app refreshes when your Watch sends an outing's completion update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app del iPhone se actualiza cuando tu Apple Watch envía la actualización de una salida completada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app iPhone se met à jour quand votre montre envoie la fin d’une sortie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchから外出の完了が送られると、iPhoneアプリが更新されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O app do iPhone é atualizado quando o Watch envia a conclusão de um passeio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当手表发送出行完成更新时，iPhone 应用会随之刷新。"
          }
        }
      }
    },
    "Smoother GPS maps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خرائط GPS أسلس"
          }
        },
        "en": {
