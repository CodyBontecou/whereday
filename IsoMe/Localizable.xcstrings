    "Opens options to save your current place or add a past visit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح خيارات لحفظ مكانك الحالي أو إضافة زيارة سابقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার বর্তমান স্থান সংরক্ষণ বা একটি অতীত পরিদর্শন যোগ করার বিকল্প খোলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens options to save your current place or add a past visit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre opciones para guardar su lugar actual o agregar una visita pasada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre des options pour enregistrer votre lieu actuel ou ajouter une visite passée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वर्तमान स्थान को सहेजने या पिछली यात्रा को जोड़ने के विकल्प खोलता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の場所を保存するか、過去の訪問を追加するオプションが開きます。"
