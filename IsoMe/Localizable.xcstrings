    "Country lookup is temporarily unavailable. Completed results are saved. Check your connection and try again in a minute.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البحث عن الدولة غير متاح مؤقتًا. حُفظت النتائج المكتملة. تحقّق من اتصالك وحاول مجددًا بعد دقيقة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Country lookup is temporarily unavailable. Completed results are saved. Check your connection and try again in a minute."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda de países no está disponible temporalmente. Los resultados completados se han guardado. Comprueba tu conexión y vuelve a intentarlo en un minuto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche de pays est temporairement indisponible. Les résultats obtenus sont enregistrés. Vérifiez votre connexion et réessayez dans une minute."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国の特定が一時的に利用できません。完了した結果は保存されています。接続を確認して、1分後にもう一度お試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustalanie kraju jest chwilowo niedostępne. Gotowe wyniki zostały zapisane. Sprawdź połączenie i spróbuj ponownie za minutę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca de país está temporariamente indisponível. Os resultados concluídos foram salvos. Verifique sua conexão e tente novamente em um minuto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家查询暂时不可用。已完成的结果已保存。请检查网络连接，一分钟后重试。"
          }
        }
      }
    },
    "Credentials are sent as HTTP headers and stored in the device keychain.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم إرسال بيانات الاعتماد كرؤوس HTTP ويتم تخزينها في سلسلة مفاتيح الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শংসাপত্রগুলি HTTP শিরোনাম হিসাবে পাঠানো হয় এবং ডিভাইস কীচেনে সংরক্ষণ করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credentials are sent as HTTP headers and stored in the device keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las credenciales se envían como encabezados HTTP y se almacenan en el llavero del dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les informations d'identification sont envoyées sous forme d'en-têtes HTTP et stockées dans le trousseau de l'appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रेडेंशियल HTTP हेडर के रूप में भेजे जाते हैं और डिवाइस कीचेन में संग्रहीत किए जाते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証情報はHTTPヘッダーとして送信され、デバイスのキーチェーンに保存されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poświadczenia są wysyłane jako nagłówki HTTP i przechowywane w pęku kluczy urządzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As credenciais são enviadas como cabeçalhos HTTP e armazenadas nas chaves do dispositivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учетные данные отправляются в виде HTTP заголовков и сохраняются в связке ключей устройства."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凭证作为HTTP标头发送并存储在设备钥匙串中。"
          }
        }
      }
    },
