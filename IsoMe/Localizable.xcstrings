    "Stored outing names and notes are included when the selected format supports them. Inferred outings export with source: inferred." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تضمين أسماء الرحلات والملاحظات المخزنة عندما يدعمها التنسيق المحدد. تصدير النزهات المستنتجة مع المصدر: مستنتج."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সঞ্চিত আউটিং নাম এবং নোট অন্তর্ভুক্ত করা হয় যখন নির্বাচিত বিন্যাস তাদের সমর্থন করে। উৎস সহ অনুমানকৃত আউটিং এক্সপোর্ট: অনুমান করা হয়েছে."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored outing names and notes are included when the selected format supports them. Inferred outings export with source: inferred."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los nombres y notas de las salidas almacenadas se incluyen cuando el formato seleccionado los admite. Las salidas inferidas se exportan con source: inferred."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les noms et notes de sorties stockés sont inclus lorsque le format sélectionné les prend en charge. Les sorties déduites sont exportées avec source: inferred."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "संग्रहीत आउटिंग नाम और नोट्स तब शामिल किए जाते हैं जब चयनित प्रारूप उनका समर्थन करता है। स्रोत के साथ अनुमानित सैर निर्यात: अनुमानित।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存された外出名とメモは、選択した形式がサポートしている場合に含まれます。推定された外出は、ソース: inferred でエクスポートされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
