          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mova, redimensione, mude o tipo ou exclua este lugar salvo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
