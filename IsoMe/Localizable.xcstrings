    "Choose a saved location for a past visit, or save a newly selected place so it is ready next time.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقعًا محفوظًا لزيارة سابقة، أو احفظ المكان المحدد حديثًا حتى يكون جاهزًا في المرة القادمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি অতীত পরিদর্শনের জন্য একটি সংরক্ষিত অবস্থান চয়ন করুন, বা একটি নতুন নির্বাচিত স্থান সংরক্ষণ করুন যাতে এটি পরের বার প্রস্তুত হয়৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a saved location for a past visit, or save a newly selected place so it is ready next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una ubicación guardada para una visita anterior o guarde un lugar recién seleccionado para que esté listo la próxima vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un emplacement enregistré pour une visite précédente ou enregistrez un lieu nouvellement sélectionné afin qu'il soit prêt la prochaine fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली यात्रा के लिए कोई सहेजा गया स्थान चुनें, या किसी नए चयनित स्थान को सहेजें ताकि वह अगली बार तैयार हो।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去に訪れたときに保存した場所を選択するか、新しく選択した場所を保存して次回使えるようにします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zapisaną lokalizację dla poprzedniej wizyty lub zapisz nowo wybrane miejsce, aby było gotowe następnym razem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um local salvo para uma visita anterior ou salve um local recém-selecionado para que esteja pronto na próxima vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сохраненное место для прошлого посещения или сохраните вновь выбранное место, чтобы оно было готово в следующий раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择过去访问的已保存位置，或保存新选择的地点以便下次使用。"
          }
        }
      }
    },
    "Choose a saved location or request a fresh accurate current location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر موقعًا محفوظًا أو اطلب موقعًا حاليًا دقيقًا وحديثًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি সংরক্ষিত অবস্থান চয়ন করুন বা একটি নতুন সঠিক বর্তমান অবস্থানের জন্য অনুরোধ করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a saved location or request a fresh accurate current location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una ubicación guardada o solicite una ubicación actual nueva y precisa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un emplacement enregistré ou demandez un nouvel emplacement actuel précis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई सहेजा गया स्थान चुनें या ताज़ा सटीक वर्तमान स्थान का अनुरोध करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された場所を選択するか、新しい正確な現在の場所を要求します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zapisaną lokalizację lub poproś o nową, dokładną aktualną lokalizację."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um local salvo ou solicite um local atual preciso e atualizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите сохраненное местоположение или запросите новое точное текущее местоположение."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择已保存的位置或请求新的准确当前位置。"
          }
        }
      }
    },
    "Choose a time between the visit's arrival and now.": {
      "localizations": {
