    "Saved recipes appear above the sentence. Tap one to load its choices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر الوصفات المحفوظة فوق الجملة. اضغط إحداها لتحميل اختياراتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত রেসিপি বাক্যের ওপরে দেখা যায়। কোনোটির পছন্দগুলো লোড করতে সেটিতে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
