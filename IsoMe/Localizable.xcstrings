    "Your existing free tracking access is preserved. Choose a plan to unlock data export." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُحتفظ بوصولك المجاني الحالي إلى التتبع. اختر خطة لفتح تصدير البيانات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার বিদ্যমান বিনামূল্যের ট্র্যাকিং অ্যাক্সেস বহাল আছে। ডেটা রপ্তানি চালু করতে একটি প্ল্যান বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your existing free tracking access is preserved. Choose a plan to unlock data export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conservas tu acceso gratuito al seguimiento. Elige un plan para desbloquear la exportación de datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre accès gratuit au suivi est conservé. Choisissez une formule pour débloquer l’exportation des données."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका मौजूदा मुफ़्त ट्रैकिंग एक्सेस बना रहेगा। डेटा निर्यात अनलॉक करने के लिए प्लान चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これまでの無料の追跡はそのまま使えます。データの書き出しを使うにはプランを選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój dotychczasowy bezpłatny dostęp do śledzenia zostaje zachowany. Wybierz plan, aby odblokować eksport danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu acesso gratuito ao rastreamento foi mantido. Escolha um plano para liberar a exportação de dados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш бесплатный доступ к отслеживанию сохраняется. Выберите план, чтобы открыть экспорт данных."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你现有的免费追踪权限会保留。选择方案以解锁数据导出。"
          }
        }
      }
    },
