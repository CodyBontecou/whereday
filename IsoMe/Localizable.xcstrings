    "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم / للمجلدات. الرموز: %@ . {title} / {name} استخدم عنوان النزهة عندما يكون متاحًا، وإلا نوع البيانات. تتم إضافة ملحق التنسيق إذا تم حذفه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফোল্ডারের জন্য / ব্যবহার করুন। টোকেন: %@ । {title} / {name} উপলভ্য হলে আউটিং শিরোনাম ব্যবহার করুন, অন্যথায় ডেটা টাইপ। বাদ দিলে ফরম্যাট এক্সটেনশন যোগ করা হয়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice / para carpetas. Fichas: %@ . {title} / {name} usa el título de la salida cuando esté disponible; de ​​lo contrario, el tipo de datos. La extensión de formato se agrega si se omite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez / pour les dossiers. Jetons : %@ . {title} / {name} utilise le titre de la sortie lorsqu'il est disponible, sinon le type de données. L'extension de format est ajoutée si elle est omise."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोल्डरों के लिए / का उपयोग करें. टोकन: %@ . {title} / {name} उपलब्ध होने पर आउटिंग शीर्षक का उपयोग करें, अन्यथा डेटा प्रकार का। यदि छोड़ा गया है तो प्रारूप एक्सटेंशन जोड़ा जाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダーには / を使用します。トークン: %@ 。 {title} / {name}利用可能な場合は外出のタイトルを使用し、それ以外の場合はデータ型を使用します。省略した場合はフォーマット拡張子が付加されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj / dla folderów. Tokeny: %@. {title} / {name} użyj tytułu podróży, jeśli jest dostępny, w przeciwnym razie typ danych. W przypadku pominięcia dodawane jest rozszerzenie formatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use / para pastas. Tokens: %@ . {title} / {name} use o título do passeio quando disponível, caso contrário, o tipo de dados. A extensão de formato é adicionada se for omitida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте / для папок. Токены: %@ . {title} / {name} использует заголовок выхода, если он доступен, в противном случае — тип данных. Расширение формата добавляется, если оно опущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 / 表示文件夹。代币： %@ 。 {title} / {name}使用郊游标题（如果可用），否则使用数据类型。如果省略，则会添加格式扩展名。"
          }
        }
      }
    },
    "Use System, Light, or Dark in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم «النظام» أو «فاتح» أو «داكن» في الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use System, Light, or Dark in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Sistema, Claro u Oscuro en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Système, Clair ou Sombre dans Paramètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定で「システム」「ライト」「ダーク」を選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz tryb systemowy, jasny lub ciemny w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Sistema, Claro ou Escuro nas Configurações."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在设置中选择跟随系统、浅色或深色。"
          }
        }
      }
    },
    "Use Test Connection to verify the endpoint URL and credentials without sending real data. Send Now posts all saved location data to the endpoint.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اختبار الاتصال للتحقق من URL لنقطة النهاية وبيانات الاعتماد دون إرسال بيانات حقيقية. يقوم تطبيق Send Now بنشر كافة بيانات الموقع المحفوظة إلى نقطة النهاية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আসল ডেটা না পাঠিয়ে শেষ পয়েন্ট URL এবং শংসাপত্র যাচাই করতে পরীক্ষা সংযোগ ব্যবহার করুন। Send Now সব সংরক্ষিত অবস্থানের ডেটা শেষ পয়েন্টে পোস্ট করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Test Connection to verify the endpoint URL and credentials without sending real data. Send Now posts all saved location data to the endpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice Test Connection para verificar la URL del punto final y las credenciales sin enviar datos reales. Enviar ahora publica todos los datos de ubicación guardados en el punto final."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Test Connection pour vérifier l’ URL et les informations d’identification du point de terminaison sans envoyer de données réelles. Envoyer maintenant publie toutes les données de localisation enregistrées sur le point de terminaison."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वास्तविक डेटा भेजे बिना एंडपॉइंट URL और क्रेडेंशियल्स को सत्यापित करने के लिए टेस्ट कनेक्शन का उपयोग करें। अभी भेजें सभी सहेजे गए स्थान डेटा को अंतिम बिंदु पर पोस्ट करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト接続を使用して、実際のデータを送信せずにエンドポイントURLと資格情報を検証します。 Send Now は、保存されているすべての位置データをエンドポイントに送信します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj połączenia testowego, aby zweryfikować URL punktu końcowego i poświadczenia bez wysyłania prawdziwych danych. Wyślij teraz wysyła wszystkie zapisane dane o lokalizacji do punktu końcowego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Test Connection para verificar o URL e as credenciais do endpoint sem enviar dados reais. Enviar agora publica todos os dados de localização salvos no endpoint."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте тестовое соединение, чтобы проверить URL конечной точки и учетные данные без отправки реальных данных. Функция «Отправить сейчас» отправляет все сохраненные данные о местоположении в конечную точку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用测试连接来验证端点URL和凭据，而无需发送真实数据。立即发送将所有保存的位置数据发布到端点。"
          }
        }
      }
    },
