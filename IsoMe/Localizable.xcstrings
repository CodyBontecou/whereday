    "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط أي صورة مصغّرة لعرضها بملء الشاشة، ثم استخدم الأسهم للتنقل بين كل الصور في هذه المجموعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পূর্ণ স্ক্রিনে দেখতে যেকোনো থাম্বনেইলে ট্যাপ করুন, তারপর তীরচিহ্ন দিয়ে এই গ্রুপের সব ছবি দেখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any thumbnail to view it full screen, then use the arrows to move through all photos in this group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca cualquier miniatura para verla a pantalla completa y usa las flechas para recorrer todas las fotos de este grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une miniature pour l’afficher en plein écran, puis utilisez les flèches pour parcourir toutes les photos du groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी थंबनेल पर टैप करके उसे पूरी स्क्रीन पर देखें, फिर इस समूह की सभी फ़ोटो देखने के लिए तीरों का उपयोग करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルをタップすると全画面で表示され、矢印でこのグループのすべての写真を移動できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij miniaturę, aby wyświetlić zdjęcie na pełnym ekranie, a następnie użyj strzałek, aby przeglądać wszystkie zdjęcia z tej grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em qualquer miniatura para vê-la em tela cheia e use as setas para percorrer todas as fotos deste grupo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь миниатюры, чтобы открыть её на весь экран, затем листайте стрелками все фото этой группы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点任意缩略图即可全屏查看，然后使用箭头浏览此组中的所有照片。"
          }
        }
      }
    },
    "Tap any thumbnail to view it full screen, then use the arrows to move through the photos from this place." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على أي صورة مصغرة لمشاهدتها بملء الشاشة، ثم استخدم الأسهم للتنقل عبر الصور من هذا المكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোন থাম্বনেইলটিকে পূর্ণ স্ক্রীনে দেখতে আলতো চাপুন, তারপর এই স্থান থেকে ফটোগুলি সরাতে তীরগুলি ব্যবহার করুন৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap any thumbnail to view it full screen, then use the arrows to move through the photos from this place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque cualquier miniatura para verla en pantalla completa, luego use las flechas para moverse por las fotos desde ese lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur n'importe quelle vignette pour l'afficher en plein écran, puis utilisez les flèches pour vous déplacer parmi les photos à partir de cet endroit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी थंबनेल को पूर्ण स्क्रीन पर देखने के लिए उस पर टैप करें, फिर इस स्थान से फ़ोटो में जाने के लिए तीरों का उपयोग करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サムネイルをタップして全画面表示し、矢印を使用してこの場所から写真間を移動します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij dowolną miniaturę, aby wyświetlić ją na pełnym ekranie, a następnie użyj strzałek, aby poruszać się po zdjęciach z tego miejsca."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em qualquer miniatura para visualizá-la em tela inteira e use as setas para percorrer as fotos deste local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коснитесь любой миниатюры, чтобы просмотреть ее в полноэкранном режиме, затем используйте стрелки для перемещения по фотографиям с этого места."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击任意缩略图即可全屏查看，然后使用箭头在此位置浏览照片。"
          }
        }
      }
    },
