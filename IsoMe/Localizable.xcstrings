    "Past visits need a departure time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزيارات السابقة تحتاج إلى وقت المغادرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতীত পরিদর্শন একটি প্রস্থান সময় প্রয়োজন."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past visits need a departure time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las visitas anteriores necesitan una hora de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les visites passées nécessitent une heure de départ."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली यात्राओं के लिए प्रस्थान समय की आवश्यकता होती है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の訪問には出発時間が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejsze wizyty wymagają godziny wyjścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Visitas anteriores precisam de um horário de partida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прошлые посещения требуют времени отправления."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去的访问需要出发时间。"
          }
        }
      }
    },
    "Past visits work without Location permission and never fall back to your current GPS position.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل الزيارات السابقة بدون إذن الموقع ولا تعود أبدًا إلى موقعك الحالي عبر نظام GPS ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অতীতের পরিদর্শনগুলি অবস্থানের অনুমতি ছাড়াই কাজ করে এবং কখনই আপনার বর্তমান GPS অবস্থানে ফিরে আসে না।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Past visits work without Location permission and never fall back to your current GPS position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las visitas anteriores funcionan sin permiso de ubicación y nunca vuelven a su posición GPS actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les visites passées fonctionnent sans autorisation de localisation et ne reviennent jamais à votre position GPS actuelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली विज़िट स्थान की अनुमति के बिना काम करती हैं और कभी भी आपकी वर्तमान GPS स्थिति पर वापस नहीं आती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の訪問は位置情報の許可なしで機能し、現在のGPS位置にフォールバックすることはありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzednie wizyty działają bez pozwolenia na lokalizację i nigdy nie wracają do bieżącej pozycji GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As visitas anteriores funcionam sem permissão de localização e nunca voltam à sua posição GPS atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущие посещения работают без разрешения на определение местоположения и никогда не возвращаются к текущему положению GPS ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "过去的访问无需位置许可即可进行，并且永远不会回退到您当前的GPS位置。"
          }
        }
      }
    },
