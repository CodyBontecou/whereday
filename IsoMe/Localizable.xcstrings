        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस सहेजी गई जगह को खिसकाएँ, उसका आकार या प्रकार बदलें, या उसे हटाएँ।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
