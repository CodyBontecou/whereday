    "A life of places.\nYours to keep." : {
      "comment" : "Illustrated paywall headline. Warm travel-journal voice; places become a personal history to keep. Adapt the line break naturally.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أماكن تعيشها.\nذكريات تحتفظ بها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "জীবন জুড়ে কত জায়গা।\nস্মৃতি থাকুক আপনার কাছে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A life of places.\nYours to keep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vida de lugares.\nUna historia que conservar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous ces lieux.\nVotre histoire à garder."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जगहों से बनी ज़िंदगी।\nसहेजें अपनी कहानी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れた場所が、\nあなたの物語に。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Życie pełne miejsc.\nHistoria, która zostaje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugares que marcam.\nHistórias para guardar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Места вашей жизни.\nИстория, которая с вами."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "走过的地方，\n都是你的故事。"
          }
        }
      }
    },
    "A point every 5 m, always. For hikes and rides. Stops on its own after 2 h." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نقطة كل 5 م، دائمًا. للمشي الجبلي وركوب الدراجات. يتوقف تلقائيًا بعد ساعتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবসময় প্রতি 5 m-এ একটি পয়েন্ট। হাইকিং ও রাইডের জন্য। 2 ঘন্টা পর নিজে থেকেই থেমে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A point every 5 m, always. For hikes and rides. Stops on its own after 2 h."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un punto cada 5 m, siempre. Para rutas a pie y en bici. Se detiene solo a las 2 h."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un point tous les 5 m, en permanence. Pour la randonnée et le vélo. S’arrête seul après 2 h."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हर 5 m पर एक पॉइंट, हमेशा। हाइक और राइड के लिए। 2 h बाद अपने-आप रुक जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "常に5 mごとに1点を記録。ハイキングやサイクリング向け。2時間後に自動で停止します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkt co 5 m, zawsze. Na wędrówki i przejażdżki. Wyłącza się sam po 2 godz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ponto a cada 5 m, sempre. Para trilhas e pedais. Para sozinho após 2 h."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точка каждые 5 м, всегда. Для походов и поездок. Отключается сама через 2 ч."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终每 5 米记录一个点。适合徒步和骑行。2 小时后自动停止。"
          }
        }
      }
    },
