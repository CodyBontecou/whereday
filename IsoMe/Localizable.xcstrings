    "Notes where you stop. No path between. Lightest on battery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسجّل أماكن توقفك. لا مسار بينها. الأخف على البطارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notes where you stop. No path between. Lightest on battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota dónde paras, sin el recorrido entre medias. El que menos batería gasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Note là où vous vous arrêtez. Aucun tracé entre deux. Le plus économe en batterie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち寄った場所を記録します。間の経路は記録しません。バッテリー消費が最も少ない設定です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota onde você para. Sem caminho entre as paradas. O mais leve para a bateria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你停留的地方，不记录之间的路径。最省电。"
          }
        }
      }
    },
    "Draws your path when you're out, sleeps when you're still.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسم مسارك عندما تخرج، ويهدأ عندما تسكن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Draws your path when you're out, sleeps when you're still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuja tu recorrido cuando sales y descansa cuando estás quieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace votre parcours quand vous sortez, se met en veille quand vous ne bougez pas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外出中は経路を描き、止まっている間は休みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desenha seu caminho quando você sai e descansa quando você está parado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外出时绘制路径，静止时休眠。"
          }
        }
      }
    },
    "A point every 5 m, always. For hikes and rides. Stops on its own after 2 h.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقطة كل 5 م، دائمًا. للمشي الجبلي وركوب الدراجات. يتوقف تلقائيًا بعد ساعتين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A point every 5 m, always. For hikes and rides. Stops on its own after 2 h."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto cada 5 m, siempre. Para rutas a pie y en bici. Se detiene solo a las 2 h."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point tous les 5 m, en permanence. Pour la randonnée et le vélo. S’arrête seul après 2 h."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に5 mごとに1点を記録。ハイキングやサイクリング向け。2時間後に自動で停止します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ponto a cada 5 m, sempre. Para trilhas e pedais. Para sozinho após 2 h."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "始终每 5 米记录一个点。适合徒步和骑行。2 小时后自动停止。"
          }
        }
      }
