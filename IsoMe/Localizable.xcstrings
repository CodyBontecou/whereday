    "A calm, private timeline of where your day takes you — always on-device and in your control.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جدول زمني هادئ وخاص للمكان الذي يأخذك إليه يومك - دائمًا على الجهاز وتحت سيطرتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দিনটি আপনাকে কোথায় নিয়ে যায় তার একটি শান্ত, ব্যক্তিগত টাইমলাইন — সর্বদা ডিভাইসে এবং আপনার নিয়ন্ত্রণে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calm, private timeline of where your day takes you — always on-device and in your control."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea de tiempo tranquila y privada de hacia dónde te lleva tu día, siempre en el dispositivo y bajo tu control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une chronologie calme et privée de l'endroit où votre journée vous mène, toujours sur l'appareil et sous votre contrôle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दिन आपको कहाँ ले जाता है इसकी एक शांत, निजी समयरेखा - हमेशा डिवाइस पर और आपके नियंत्रण में।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの一日がどこに行くのかを示す穏やかでプライベートなタイムライン - 常にデバイス上にあり、あなたのコントロール下にあります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojna, prywatna oś czasu pokazująca, dokąd zaprowadzi Cię dzień — zawsze na urządzeniu i pod Twoją kontrolą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha do tempo calma e privada de onde seu dia o leva, sempre no dispositivo e sob seu controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Спокойный, конфиденциальный график того, как проходит ваш день — всегда на устройстве и под вашим контролем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "平静、私密的时间表，记录您一天的行程 — 始终在设备上并由您掌控。"
          }
        }
      }
    },
    "A clearer view of your days": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رؤية أوضح لأيامك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার দিনগুলির একটি পরিষ্কার দৃশ্য"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clearer view of your days"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una visión más clara de tus días"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vision plus claire de vos journées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दिनों का एक स्पष्ट दृश्य"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日々の様子をより明確に把握"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyraźniejszy obraz swoich dni"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma visão mais clara dos seus dias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Более четкое представление о ваших днях"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更清晰地了解您的日子"
          }
        }
      }
    },
    "A day counts once per country, using the recorded location’s local date. A travel day can count in more than one country. Open visits and unverified departure times count only the arrival day; route points add further recorded days. Gaps are not filled automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتسب اليوم مرة واحدة لكل دولة، وفق التاريخ المحلي للموقع المسجّل. وقد يُحتسب يوم السفر في أكثر من دولة. الزيارات المفتوحة وأوقات المغادرة غير المؤكدة لا تُحتسب إلا في يوم الوصول؛ وتضيف نقاط المسار أيامًا مسجّلة أخرى. لا تُملأ الفجوات تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day counts once per country, using the recorded location’s local date. A travel day can count in more than one country. Open visits and unverified departure times count only the arrival day; route points add further recorded days. Gaps are not filled automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día cuenta una sola vez por país, según la fecha local de la ubicación registrada. Un día de viaje puede contar en más de un país. Las visitas abiertas y las horas de salida sin verificar solo cuentan el día de llegada; los puntos de ruta añaden más días registrados. Los huecos no se rellenan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour compte une seule fois par pays, selon la date locale de la position enregistrée. Un jour de voyage peut compter dans plusieurs pays. Les visites ouvertes et les heures de départ non vérifiées ne comptent que le jour d’arrivée ; les points de trajet ajoutent d’autres jours enregistrés. Les périodes sans données ne sont pas complétées automatiquement."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1日は国ごとに1回だけ数え、記録された位置の現地日付を使います。移動日は複数の国で数えられることがあります。進行中の訪問や出発時刻が未確認の訪問は到着日のみを数え、ルートポイントがあればその日も記録日に加わります。空白の日は自動では埋められません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy dzień jest liczony raz w danym kraju według lokalnej daty zarejestrowanego położenia. Dzień podróży może być liczony w kilku krajach. Dla trwających wizyt i niezweryfikowanych godzin wyjścia liczony jest tylko dzień przybycia; punkty trasy dodają kolejne zarejestrowane dni. Luki nie są uzupełniane automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia conta uma vez por país, usando a data local do local registrado. Um dia de viagem pode contar em mais de um país. Visitas em aberto e horários de partida não verificados contam apenas o dia de chegada; pontos do trajeto acrescentam outros dias registrados. Lacunas não são preenchidas automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个国家的同一天只计一次，按记录位置的当地日期计算。旅行日可能计入多个国家。未结束的到访和未经核实的离开时间只计到达当天；路线点会补充更多有记录的日期。空缺不会自动填补。"
          }
        }
      }
    },
    "A duplicate has the same name near an existing location or an earlier row. Invalid rows are skipped. Updates change future matching and keep past visits unchanged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التكرار هو موقع يحمل الاسم نفسه بالقرب من موقع موجود أو من صف سابق. تُتخطّى الصفوف غير الصالحة. تؤثر التحديثات في المطابقة المستقبلية وتُبقي الزيارات السابقة دون تغيير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A duplicate has the same name near an existing location or an earlier row. Invalid rows are skipped. Updates change future matching and keep past visits unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un duplicado tiene el mismo nombre y está cerca de una ubicación existente o de una fila anterior. Las filas no válidas se omiten. Las actualizaciones cambian la detección futura y no modifican las visitas pasadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un doublon porte le même nom qu’un lieu existant proche ou qu’une ligne précédente. Les lignes invalides sont ignorées. Les mises à jour modifient les associations futures sans toucher aux visites passées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既存の場所や前の行と同じ名前で近くにあるものは重複とみなします。無効な行はスキップされます。更新は今後の照合に反映され、過去の訪問は変わりません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Duplikat ma tę samą nazwę i znajduje się w pobliżu istniejącej lokalizacji lub miejsca z wcześniejszego wiersza. Nieprawidłowe wiersze są pomijane. Aktualizacje zmieniają przyszłe dopasowania, pozostawiając wcześniejsze wizyty bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma duplicata tem o mesmo nome perto de um local existente ou de uma linha anterior. Linhas inválidas são ignoradas. Atualizações mudam as associações futuras e mantêm as visitas anteriores inalteradas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重复项是指在现有地点或前面某行附近出现的同名地点。无效行将被跳过。更新会影响今后的匹配，过去的到访保持不变。"
          }
        }
      }
    },
    "A fresh accurate location is unavailable. Choose a saved place or provide coordinates.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتعذر الحصول على موقع حديث ودقيق. اختر مكانًا محفوظًا أو أدخل الإحداثيات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাম্প্রতিক নির্ভুল অবস্থান পাওয়া যাচ্ছে না। সংরক্ষিত জায়গা বেছে নিন বা স্থানাঙ্ক দিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A fresh accurate location is unavailable. Choose a saved place or provide coordinates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una ubicación reciente y precisa. Elige un lugar guardado o proporciona coordenadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Position récente et précise indisponible. Choisissez un lieu enregistré ou indiquez des coordonnées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताज़ा सटीक स्थान उपलब्ध नहीं है। सहेजी गई जगह चुनें या निर्देशांक दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい正確な位置情報を取得できません。保存済みの場所を選ぶか、座標を指定してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktualnej dokładnej lokalizacji. Wybierz zapisane miejsce lub podaj współrzędne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma localização recente e precisa não está disponível. Escolha um lugar salvo ou informe coordenadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить точное текущее местоположение. Выберите сохранённое место или укажите координаты."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法获取最新的准确位置。请选择已存地点或提供坐标。"
          }
        }
      }
    },
