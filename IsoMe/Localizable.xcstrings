    "Radius must be a number from 25 to 10,000 metres.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون النطاق رقمًا بين 25 و10,000 متر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Radius must be a number from 25 to 10,000 metres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El radio debe ser un número entre 25 y 10.000 metros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le rayon doit être un nombre compris entre 25 et 10 000 mètres."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "半径は25〜10,000メートルの数値で入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Promień musi być liczbą od 25 do 10 000 metrów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O raio deve ser um número de 25 a 10.000 metros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "半径必须是 25 到 10,000 米之间的数字。"
          }
        }
      }
    },
    "Raw location history contains points only. Visits are not inferred in this version.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتوي سجل المواقع الخام على نقاط فقط. لا تُستنتج الزيارات في هذا الإصدار."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Raw location history contains points only. Visits are not inferred in this version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de ubicaciones sin procesar solo contiene puntos. En esta versión no se infieren visitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique de localisation brut ne contient que des points. Les visites ne sont pas déduites dans cette version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生の位置履歴にはポイントのみが含まれます。このバージョンでは訪問は推定されません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O histórico de localização bruto contém apenas pontos. Visitas não são inferidas nesta versão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原始位置历史只包含位置点。此版本不会推断到访。"
          }
        }
      }
    },
