    "Everything unlocks. Recording starts with your first walk out the door." : {
      "comment" : "Carousel paywall.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفتح كل شيء. يبدأ التسجيل مع أول خروج لك من الباب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সবকিছু আনলক হয়। দরজার বাইরে প্রথম পা রাখতেই রেকর্ডিং শুরু।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everything unlocks. Recording starts with your first walk out the door."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo se desbloquea. La grabación empieza en cuanto sales por la puerta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout est débloqué. L’enregistrement commence dès votre première sortie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सब कुछ अनलॉक हो जाता है। घर से पहला कदम बाहर रखते ही रिकॉर्डिंग शुरू।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての機能が使えます。外へ出た瞬間から記録が始まります。"
          }
        },
        "pl" : {
