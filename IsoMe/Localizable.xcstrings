    "Duplicates are always skipped. Existing records are never changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُتخطّى التكرارات دائمًا. لا تُغيَّر السجلات الموجودة أبدًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডুপ্লিকেট সবসময় বাদ দেওয়া হয়। বিদ্যমান রেকর্ড কখনো বদলানো হয় না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicates are always skipped. Existing records are never changed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los duplicados siempre se omiten. Los registros existentes nunca se modifican."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les doublons sont toujours ignorés. Les données existantes ne sont jamais modifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डुप्लिकेट हमेशा छोड़ दिए जाते हैं। मौजूदा रिकॉर्ड कभी नहीं बदले जाते।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重複は常にスキップされます。既存の記録が変更されることはありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplikaty są zawsze pomijane. Istniejące rekordy nigdy nie są zmieniane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicatas são sempre ignoradas. Registros existentes nunca são alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дубликаты всегда пропускаются. Существующие записи никогда не изменяются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重复项始终会被跳过。现有记录绝不会被更改。"
          }
        }
      }
