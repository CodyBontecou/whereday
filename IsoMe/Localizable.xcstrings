    "Record your days around the clock, even when Whereday is closed. Allow Always location access for automatic background visit detection.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record your days around the clock, even when Whereday is closed. Allow Always location access for automatic background visit detection."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل أيامك على مدار الساعة، حتى عندما يكون Whereday مغلقًا. اسمح بالوصول الدائم إلى الموقع لاكتشاف الزيارات تلقائيًا في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday বন্ধ থাকলেও দিনরাত আপনার দিন রেকর্ড করুন। পটভূমিতে স্বয়ংক্রিয়ভাবে ভ্রমণ শনাক্ত করতে অবস্থানের অনুমতি সর্বদা চালু রাখুন।"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra tus días las 24 horas, incluso con Whereday cerrado. Permite el acceso a la ubicación Siempre para detectar visitas automáticamente en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez vos journées 24 h/24, même lorsque Whereday est fermé. Autorisez l’accès permanent à la position pour détecter automatiquement les visites en arrière-plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday बंद होने पर भी चौबीसों घंटे अपने दिन रिकॉर्ड करें। पृष्ठभूमि में स्वचालित रूप से यात्राओं का पता लगाने के लिए स्थान की अनुमति हमेशा दें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheredayを閉じていても、一日を24時間記録。位置情報を「常に許可」にすると、バックグラウンドで訪問を自動検出できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejestruj swoje dni przez całą dobę, nawet gdy Whereday jest zamknięty. Zezwól na dostęp do lokalizacji zawsze, aby automatycznie wykrywać wizyty w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre seus dias 24 horas por dia, mesmo com o Whereday fechado. Permita o acesso à localização Sempre para detectar visitas automaticamente em segundo plano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте свои дни круглосуточно, даже когда Whereday закрыт. Разрешите доступ к геопозиции «Всегда» для автоматического определения посещений в фоне."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使关闭 Whereday，也能全天候记录行程。请选择“始终”允许位置访问，以便在后台自动检测到访。"
          }
        }
      }
    },
    "Every day, recorded for you": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "كل يوم يُسجَّل لك"}},
        "bn": {"stringUnit": {"state": "translated", "value": "প্রতিটি দিন, আপনার জন্য রেকর্ড করা"}},
        "en": {"stringUnit": {"state": "translated", "value": "Every day, recorded for you"}},
        "es": {"stringUnit": {"state": "translated", "value": "Cada día, registrado por ti"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Chaque jour, enregistré pour vous"}},
        "hi": {"stringUnit": {"state": "translated", "value": "हर दिन, आपके लिए रिकॉर्ड"}},
        "ja": {"stringUnit": {"state": "translated", "value": "毎日を自動で記録"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Każdy dzień zapisany za Ciebie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Cada dia registrado para você"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Каждый день записывается сам"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "每一天，都为你记录"}}
      }
    },
    "Visits and routes log in the background. No check-ins.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تُسجَّل الزيارات والمسارات في الخلفية. دون تسجيل وصول يدوي."}},
        "bn": {"stringUnit": {"state": "translated", "value": "ভিজিট আর রুট ব্যাকগ্রাউন্ডে রেকর্ড হয়। চেক-ইন লাগে না।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Visits and routes log in the background. No check-ins."}},
        "es": {"stringUnit": {"state": "translated", "value": "Las visitas y rutas se registran en segundo plano. Sin check-ins."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Visites et trajets sont enregistrés en arrière-plan. Sans check-in."}},
        "hi": {"stringUnit": {"state": "translated", "value": "विज़िट और रूट बैकग्राउंड में रिकॉर्ड होते हैं। चेक-इन की ज़रूरत नहीं।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "訪問先とルートをバックグラウンドで記録。チェックインは不要です。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wizyty i trasy zapisują się w tle. Bez meldowania się."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Visitas e rotas são registradas em segundo plano. Sem check-ins."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Визиты и маршруты записываются в фоне. Без отметок вручную."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "到访和路线在后台记录，无需签到。"}}
      }
    },
    "Revisit any place, any date": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "عُد إلى أي مكان وأي تاريخ"}},
        "bn": {"stringUnit": {"state": "translated", "value": "যেকোনো জায়গা, যেকোনো তারিখ আবার দেখুন"}},
        "en": {"stringUnit": {"state": "translated", "value": "Revisit any place, any date"}},
        "es": {"stringUnit": {"state": "translated", "value": "Vuelve a cualquier lugar y fecha"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Retrouvez chaque lieu, chaque date"}},
        "hi": {"stringUnit": {"state": "translated", "value": "कोई भी जगह, कोई भी तारीख़ फिर से देखें"}},
        "ja": {"stringUnit": {"state": "translated", "value": "どの場所も、どの日も振り返れる"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Wracaj do każdego miejsca i dnia"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Reveja qualquer lugar e data"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Любое место, любая дата"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "随时回顾任何地点和日期"}}
      }
    },
    "Map, timeline and calendar of where you've been.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "خريطة وخط زمني وتقويم للأماكن التي زرتها."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনি যেখানে গেছেন তার মানচিত্র, টাইমলাইন আর ক্যালেন্ডার।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Map, timeline and calendar of where you've been."}},
        "es": {"stringUnit": {"state": "translated", "value": "Mapa, línea de tiempo y calendario de dónde has estado."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Carte, chronologie et calendrier de vos lieux."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आप जहाँ-जहाँ गए, उसका नक्शा, टाइमलाइन और कैलेंडर।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "訪れた場所をマップ、タイムライン、カレンダーで。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Mapa, oś czasu i kalendarz miejsc, w których byłeś."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Mapa, linha do tempo e calendário de onde você esteve."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Карта, хронология и календарь ваших мест."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "用地图、时间线和日历查看你去过的地方。"}}
      }
    },
    "Private, on your iPhone": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "خاص، على iPhone الخاص بك"}},
        "bn": {"stringUnit": {"state": "translated", "value": "ব্যক্তিগত, আপনার iPhone-এ"}},
        "en": {"stringUnit": {"state": "translated", "value": "Private, on your iPhone"}},
        "es": {"stringUnit": {"state": "translated", "value": "Privado, en tu iPhone"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Privé, sur votre iPhone"}},
        "hi": {"stringUnit": {"state": "translated", "value": "निजी, आपके iPhone पर"}},
        "ja": {"stringUnit": {"state": "translated", "value": "プライベートに、iPhoneの中だけで"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Prywatnie, na Twoim iPhonie"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Privado, no seu iPhone"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Приватно, на вашем iPhone"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "私密保存在你的 iPhone 上"}}
      }
    },
    "No account. Export to GPX, CSV, Markdown and more.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "دون حساب. صدّر إلى GPX وCSV وMarkdown وغيرها."}},
        "bn": {"stringUnit": {"state": "translated", "value": "অ্যাকাউন্ট লাগে না। GPX, CSV, Markdown ও আরও অনেক ফরম্যাটে এক্সপোর্ট করুন।"}},
        "en": {"stringUnit": {"state": "translated", "value": "No account. Export to GPX, CSV, Markdown and more."}},
        "es": {"stringUnit": {"state": "translated", "value": "Sin cuenta. Exporta a GPX, CSV, Markdown y más."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Sans compte. Export en GPX, CSV, Markdown et plus."}},
        "hi": {"stringUnit": {"state": "translated", "value": "कोई अकाउंट नहीं। GPX, CSV, Markdown और अन्य में एक्सपोर्ट करें।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "アカウント不要。GPX、CSV、Markdownなどに書き出せます。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Bez konta. Eksport do GPX, CSV, Markdown i innych."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Sem conta. Exporte para GPX, CSV, Markdown e mais."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Без аккаунта. Экспорт в GPX, CSV, Markdown и другие форматы."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "无需账户。可导出为 GPX、CSV、Markdown 等格式。"}}
      }
    },
    "Take your history\nanywhere.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "خذ سجلّك\nإلى أي مكان."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার ইতিহাস নিয়ে যান\nযেকোনো জায়গায়।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Take your history\nanywhere."}},
        "es": {"stringUnit": {"state": "translated", "value": "Lleva tu historial\na cualquier parte."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Emportez votre historique\npartout."}},
        "hi": {"stringUnit": {"state": "translated", "value": "अपना इतिहास ले जाएँ\nकहीं भी।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "あなたの記録を、\nどこへでも。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zabierz swoją historię\ngdziekolwiek."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Leve seu histórico\npara qualquer lugar."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Ваша история —\nгде угодно."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "你的足迹，\n随处可用。"}}
      }
    },
    "Every format, filtered your way": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "كل الصيغ، بالتصفية التي تريدها"}},
        "bn": {"stringUnit": {"state": "translated", "value": "প্রতিটি ফরম্যাট, আপনার মতো করে ফিল্টার"}},
        "en": {"stringUnit": {"state": "translated", "value": "Every format, filtered your way"}},
