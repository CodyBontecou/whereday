    "Set the name of the Whereday outing currently being recorded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتعيين اسم نزهة Whereday التي يتم تسجيلها حاليًا."
          }
