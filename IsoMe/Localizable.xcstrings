    "Record points" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسجيل النقاط"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পয়েন্ট রেকর্ড"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Record points"
          }
        },
        "es" : {
