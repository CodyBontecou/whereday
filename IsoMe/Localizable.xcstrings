            "value": "অ্যাপ, উইজেট এবং লাইভ অ্যাক্টিভিটি জুড়ে দেখানো দূরত্বের মান।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Distance values shown throughout the app, widgets, and Live Activity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores de distancia se muestran en toda la aplicación, los widgets y la actividad en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Valeurs de distance affichées dans l'application, les widgets et l'activité en direct."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दूरी के मान पूरे ऐप, विजेट और लाइव गतिविधि में दिखाए गए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ、ウィジェット、ライブ アクティビティ全体で表示される距離の値。"
