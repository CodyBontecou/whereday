    "Set a default folder to save exports without the share sheet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتعيين مجلد افتراضي لحفظ الصادرات بدون ورقة المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শেয়ার শীট ছাড়া রপ্তানি সংরক্ষণ করতে একটি ডিফল্ট ফোল্ডার সেট করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a default folder to save exports without the share sheet."
          }
        },
        "es": {
