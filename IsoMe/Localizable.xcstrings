        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैकर मुफ़्त है। अपनी मौजूदा लाइफ़टाइम एक्सपोर्ट ख़रीदारी से CSV निर्यात करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
