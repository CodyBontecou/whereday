    "Try a Google Timeline JSON export, or a Whereday JSON, CSV or Markdown file. Your existing records weren't touched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرّب ملف Google Timeline JSON مُصدَّرًا، أو ملف Whereday بتنسيق JSON أو CSV أو Markdown. لم تُمسّ سجلاتك الحالية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি Google Timeline JSON রপ্তানি, অথবা Whereday JSON, CSV বা Markdown ফাইল চেষ্টা করুন। আপনার বিদ্যমান রেকর্ডে হাত দেওয়া হয়নি।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Try a Google Timeline JSON export, or a Whereday JSON, CSV or Markdown file. Your existing records weren't touched."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prueba con una exportación JSON de Google Timeline o con un archivo JSON, CSV o Markdown de Whereday. Tus registros existentes no se han modificado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essayez un export JSON Google Timeline, ou un fichier JSON, CSV ou Markdown de Whereday. Vos données existantes n’ont pas été modifiées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Google Timeline JSON एक्सपोर्ट, या Whereday JSON, CSV या Markdown फ़ाइल आज़माएँ। आपके मौजूदा रिकॉर्ड को छुआ नहीं गया।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GoogleタイムラインのJSON書き出しファイル、またはWheredayのJSON、CSV、Markdownファイルをお試しください。既存の記録は変更されていません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spróbuj eksportu JSON z Google Timeline albo pliku JSON, CSV lub Markdown z Whereday. Istniejące zapisy nie zostały naruszone."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Experimente uma exportação JSON do Google Timeline ou um arquivo JSON, CSV ou Markdown do Whereday. Seus registros existentes não foram alterados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробуйте экспорт Google Timeline JSON или файл Whereday JSON, CSV или Markdown. Существующие записи не затронуты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请尝试 Google Timeline JSON 导出文件，或 Whereday 的 JSON、CSV 或 Markdown 文件。你现有的记录未受影响。"
          }
        }
      }
