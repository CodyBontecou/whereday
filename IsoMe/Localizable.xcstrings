    "How far you've moved today, according to Whereday.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إلى أي مدى انتقلت اليوم، وفقًا لـ Whereday."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday অনুসারে আপনি আজ কতটা এগিয়ে গেছেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How far you've moved today, according to Whereday."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Qué tan lejos has avanzado hoy, según Whereday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu'où vous avez parcouru aujourd'hui, selon Whereday."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday के अनुसार, आज आप कितना आगे बढ़ गए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday によると、今日あなたはどれくらいの距離を移動しましたか。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejszy dystans zarejestrowany przez Whereday."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quão longe você avançou hoje, de acordo com o Whereday."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как далеко вы продвинулись сегодня, по данным Whereday."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据 Whereday 的数据，您今天走了多远。"
          }
        }
      }
    },
    "How long the current Whereday tracking session has been running.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما هي مدة تشغيل جلسة تتبع Whereday الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমান Whereday ট্র্যাকিং সেশন কতক্ষণ ধরে চলছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How long the current Whereday tracking session has been running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto tiempo lleva ejecutándose la sesión de seguimiento actual de Whereday."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis combien de temps la session de suivi Whereday actuelle est-elle en cours d'exécution ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान Whereday ट्रैकिंग सत्र कितने समय से चल रहा है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在の Whereday 追跡セッションが実行されている時間。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak długo trwa bieżąca sesja śledzenia Whereday."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há quanto tempo a sessão atual de rastreamento Whereday está em execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Как долго длится текущий сеанс отслеживания Whereday."
