    "Cancel in Apple subscription settings at least 24 hours before renewal." : {
      "comment" : "Subscription cancellation instruction. Preserve Apple subscription settings and the at-least-24-hours-before-renewal requirement.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ألغِ الاشتراك من إعدادات اشتراكات Apple قبل موعد التجديد بـ٢٤ ساعة على الأقل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নবায়নের অন্তত ২৪ ঘণ্টা আগে Apple-এর সাবস্ক্রিপশন সেটিংস থেকে বাতিল করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancel in Apple subscription settings at least 24 hours before renewal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancela en los ajustes de suscripciones de Apple al menos 24 horas antes de la renovación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annulez dans les réglages des abonnements Apple au moins 24 heures avant le renouvellement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "नवीनीकरण से कम से कम 24 घंटे पहले Apple की सदस्यता सेटिंग्स में रद्द करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更新の24時間前までに、Appleのサブスクリプション設定でキャンセルしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anuluj w ustawieniach subskrypcji Apple co najmniej 24 godziny przed odnowieniem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cancele nos ajustes de assinaturas da Apple pelo menos 24 horas antes da renovação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмените подписку в настройках подписок Apple не менее чем за 24 часа до продления."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请至少在续订前 24 小时于 Apple 订阅设置中取消。"
          }
        }
      }
    },
