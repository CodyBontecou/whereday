          }
        }
      }
    },
    "Tracking is off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع متوقف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento está desactivado."
          }
        },
        "fr": {
          "stringUnit": {
