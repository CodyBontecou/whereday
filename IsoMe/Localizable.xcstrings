    "Automatically save one dated file for each local calendar day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احفظ تلقائيًا ملفًا واحدًا مؤرخًا لكل يوم تقويمي محلي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি স্থানীয় ক্যালেন্ডার দিনের জন্য স্বয়ংক্রিয়ভাবে একটি তারিখযুক্ত ফাইল সংরক্ষণ করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
