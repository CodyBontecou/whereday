    "Watch recordings now include visited places. Open Whereday on your iPhone and tap Sync Now in the Watch app to retry a transfer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن تسجيلات الساعة الآن الأماكن التي زرتها. افتح Whereday على iPhone واضغط «زامن الآن» في تطبيق الساعة لإعادة محاولة النقل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch recordings now include visited places. Open Whereday on your iPhone and tap Sync Now in the Watch app to retry a transfer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las grabaciones del Apple Watch ahora incluyen los lugares visitados. Abre Whereday en tu iPhone y toca Sincronizar en la app del reloj para reintentar una transferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les enregistrements de l’Apple Watch incluent désormais les lieux visités. Ouvrez Whereday sur votre iPhone et touchez Synchroniser dans l’app de la montre pour relancer un transfert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchの記録に訪れた場所が含まれるようになりました。転送を再試行するには、iPhoneでWheredayを開き、Watchアプリで「今すぐ同期」をタップしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As gravações do Watch agora incluem os lugares visitados. Abra o Whereday no iPhone e toque em Sincronizar no app do Watch para tentar a transferência de novo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手表记录现在包含到访过的地点。在 iPhone 上打开 Whereday，然后在手表应用中轻点“立即同步”以重试传输。"
          }
        }
      }
    },
    "Keep completed outings up to date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء النزهات المكتملة محدّثة"
