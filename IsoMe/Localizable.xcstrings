    "Today has gaps when Whereday is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في اليوم فجوات عندما يكون Whereday مغلقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today has gaps when Whereday is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy tiene huecos cuando Whereday está cerrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La journée comporte des trous quand Whereday est fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheredayを閉じている間、今日の記録に空白ができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje tem lacunas quando o Whereday está fechado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday 关闭时，今天的记录会有空缺。"
          }
        }
      }
    },
    "Nothing new is being kept. Your past days, places and exports are all still here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُحفظ شيء جديد. أيامك وأماكنك وملفاتك المصدّرة السابقة كلها لا تزال هنا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing new is being kept. Your past days, places and exports are all still here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se está guardando nada nuevo. Tus días pasados, lugares y exportaciones siguen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rien de nouveau n’est conservé. Vos journées passées, vos lieux et vos exports sont toujours là."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい記録は保存されていません。これまでの日々、場所、書き出しはすべて残っています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada novo está sendo guardado. Seus dias anteriores, lugares e exportações continuam aqui."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前不会保存任何新内容。你过去的日子、地点和导出内容都还在。"
          }
        }
      }
    },
    "Precise Location is off, so stops and routes come from rough positions and some stretches go unrecorded.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموقع الدقيق متوقف، لذا تأتي التوقفات والمسارات من مواضع تقريبية وتبقى بعض المقاطع غير مسجّلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Precise Location is off, so stops and routes come from rough positions and some stretches go unrecorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubicación exacta está desactivada, así que las paradas y rutas proceden de posiciones aproximadas y algunos tramos no se registran."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La position exacte est désactivée : les arrêts et les trajets proviennent de positions approximatives et certains passages ne sont pas enregistrés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「正確な位置情報」がオフのため、立ち寄りやルートはおおよその位置から作られ、記録されない区間もあります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Localização Precisa está desativada, então paradas e trajetos vêm de posições aproximadas e alguns trechos ficam sem registro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "精确位置已关闭，因此停留和路线来自粗略位置，部分行程不会被记录。"
          }
        }
      }
    },
    "Allow Always so the day records around the clock, even in your pocket.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «دائمًا» ليُسجَّل اليوم على مدار الساعة، حتى والهاتف في جيبك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Always so the day records around the clock, even in your pocket."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Siempre para que el día se registre a todas horas, incluso con el teléfono en el bolsillo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Toujours pour que la journée s’enregistre en continu, même téléphone en poche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に」を許可すると、ポケットの中でも1日中記録できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita Sempre para o dia ser registrado o tempo todo, mesmo no seu bolso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“始终”，让这一天全天候记录，即使手机在口袋里。"
          }
        }
      }
    },
