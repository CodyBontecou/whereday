    "Every day\nis a page.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل يوم\nصفحة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day\nis a page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día\nes una página."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour\nest une page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日が、\n1ページ。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia\né uma página."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一天，\n都是一页。"
          }
        }
      }
    },
    "Whereday quietly writes down where you were, so you can look back at any day, place or trip.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدوّن Whereday بهدوء أين كنت، لتعود إلى أي يوم أو مكان أو رحلة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday quietly writes down where you were, so you can look back at any day, place or trip."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday anota en silencio dónde estuviste, para que puedas volver a cualquier día, lugar o viaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday note discrètement où vous étiez, pour que vous puissiez revoir n’importe quel jour, lieu ou voyage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Wheredayはあなたがいた場所を静かに書き留めます。どの日、どの場所、どの旅もいつでも振り返れます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Whereday anota, em silêncio, onde você esteve, para você rever qualquer dia, lugar ou viagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday 默默记下你去过的地方，让你可以回顾任何一天、任何地点或任何一次旅程。"
          }
        }
      }
    },
    "It stays\non this phone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى\nعلى هذا الهاتف."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It stays\non this phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se queda\nen este teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste\nsur ce téléphone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録は、\nこのiPhoneの中に。"
          }
        },
        "pt-BR": {
