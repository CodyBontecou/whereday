    "Shortcuts warns about overlapping visits. Enable Allow Overlap only when you want to keep both records.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذّر الاختصارات من الزيارات المتداخلة. فعّل «السماح بالتداخل» فقط عندما تريد الاحتفاظ بالسجلين."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts warns about overlapping visits. Enable Allow Overlap only when you want to keep both records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos avisa de las visitas solapadas. Activa Permitir solapamiento solo si quieres conservar ambos registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts signale les visites qui se chevauchent. N’activez Autoriser le chevauchement que si vous souhaitez conserver les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは訪問の重複を警告します。両方の記録を残したい場合のみ「重複を許可」をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Atalhos avisam sobre visitas sobrepostas. Ative Permitir sobreposição só quando quiser manter os dois registros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷指令会提醒到访重叠。只有想保留两条记录时，才启用“允许重叠”。"
          }
        }
      }
    },
