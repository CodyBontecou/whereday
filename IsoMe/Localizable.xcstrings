          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除到访后，详情页面现在会正确关闭。"
          }
        }
      }
    },
    "Deleting the app or buying Lifetime does not cancel an existing subscription. Manage it in Apple Account settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يؤدي حذف التطبيق أو شراء مدى الحياة إلى إلغاء الاشتراك الحالي. قم بإدارته في إعدادات Apple Account ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ মুছে ফেলা বা লাইফটাইম কেনা একটি বিদ্যমান সাবস্ক্রিপশন বাতিল করে না। Apple Account সেটিংসে এটি পরিচালনা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting the app or buying Lifetime does not cancel an existing subscription. Manage it in Apple Account settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar la aplicación o comprar Lifetime no cancela una suscripción existente. Administrelo en la configuración Apple Account ."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suppression de l'application ou l'achat de Lifetime n'annule pas un abonnement existant. Gérez-le dans les paramètres Apple Account ."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप को हटाने या लाइफटाइम खरीदने से मौजूदा सदस्यता रद्द नहीं होती है। इसे Apple Account सेटिंग में प्रबंधित करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリを削除したり、ライフタイムを購入したりしても、既存のサブスクリプションはキャンセルされません。 Apple Account設定で管理します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usunięcie aplikacji lub zakup Lifetime nie powoduje anulowania istniejącej subskrypcji. Zarządzaj nim w ustawieniach Apple Account ."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Excluir o app ou comprar o plano vitalício não cancela uma assinatura existente. Gerencie-a nos ajustes da Conta Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаление приложения или покупка Lifetime не отменяет существующую подписку. Управляйте этим в настройках Apple Account ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "删除应用程序或购买终身不会取消现有订阅。在Apple Account设置中进行管理。"
          }
        }
      }
    },
    "Delivery sends your location data to a server you configure." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل التسليم بيانات موقعك إلى خادم تُعدّه أنت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেলিভারি আপনার অবস্থানের ডেটা আপনার কনফিগার করা সার্ভারে পাঠায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivery sends your location data to a server you configure."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío manda tus datos de ubicación a un servidor que tú configuras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi transmet vos données de localisation à un serveur que vous configurez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीवरी आपका स्थान डेटा आपके कॉन्फ़िगर किए सर्वर पर भेजती है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信を有効にすると、設定したサーバーに位置データが送信されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłanie przekazuje dane o lokalizacji na skonfigurowany przez Ciebie serwer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio manda seus dados de localização para um servidor que você configura."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При доставке данные о местоположении отправляются на настроенный вами сервер."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投递会将你的位置数据发送到你配置的服务器。"
          }
        }
      }
    },
    "Delivery sends your location data to a server you configure. Whereday has no access to that server or what it receives." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل التسليم بيانات موقعك إلى خادم تُعدّه أنت. لا يملك Whereday أي وصول إلى ذلك الخادم أو إلى ما يستقبله."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ডেলিভারি আপনার অবস্থানের ডেটা আপনার কনফিগার করা সার্ভারে পাঠায়। সেই সার্ভারে বা সেটি কী পায় তাতে Whereday-এর কোনো অ্যাক্সেস নেই।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delivery sends your location data to a server you configure. Whereday has no access to that server or what it receives."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío manda tus datos de ubicación a un servidor que tú configuras. Whereday no tiene acceso a ese servidor ni a lo que recibe."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’envoi transmet vos données de localisation à un serveur que vous configurez. Whereday n’a accès ni à ce serveur ni à ce qu’il reçoit."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डिलीवरी आपका स्थान डेटा आपके कॉन्फ़िगर किए सर्वर पर भेजती है। Whereday की उस सर्वर या उसे मिलने वाले डेटा तक कोई पहुँच नहीं है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配信を有効にすると、設定したサーバーに位置データが送信されます。Wheredayはそのサーバーや受信内容にアクセスできません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłanie przekazuje dane o lokalizacji na skonfigurowany przez Ciebie serwer. Whereday nie ma dostępu do tego serwera ani do odbieranych przez niego danych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O envio manda seus dados de localização para um servidor que você configura. O Whereday não tem acesso a esse servidor nem ao que ele recebe."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При доставке данные о местоположении отправляются на настроенный вами сервер. У Whereday нет доступа к этому серверу и к тому, что он получает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "投递会将你的位置数据发送到你配置的服务器。Whereday 无法访问该服务器及其接收的内容。"
          }
        }
      }
    },
