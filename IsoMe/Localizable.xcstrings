    "Sync your Watch visits": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "زامن زيارات الساعة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync your Watch visits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincroniza las visitas del reloj"
          }
        },
        "fr": {
