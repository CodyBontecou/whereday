      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على أي أنشطة تجارية قريبة. حاول مرة أخرى، أو قم بتحرير اسم الزيارة يدويًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আশেপাশের কোনো ব্যবসা খুঁজে পাওয়া যায়নি। আবার চেষ্টা করুন, অথবা ম্যানুয়ালি ভিজিটের নাম সম্পাদনা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No nearby businesses found. Try again, or edit the visit name manually."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron negocios cercanos. Inténtelo de nuevo o edite el nombre de la visita manualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune entreprise à proximité trouvée. Réessayez ou modifiez le nom de la visite manuellement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आस-पास कोई व्यवसाय नहीं मिला. पुनः प्रयास करें, या विज़िट का नाम मैन्युअल रूप से संपादित करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "近くのお店は見つかりませんでした。再試行するか、訪問名を手動で編集してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono żadnych firm w pobliżu. Spróbuj ponownie lub zmień nazwę wizyty ręcznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma empresa próxima encontrada. Tente novamente ou edite o nome da visita manualmente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Близлежащих предприятий не найдено. Повторите попытку или измените название посещения вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有找到附近的企业。请重试，或手动编辑访问名称。"
          }
        }
      }
    },
    "No nearby businesses match “%@”.": {
