            "value": "Le suivi est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡はオフです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie jest wyłączone."
          }
        },
        "pt-BR": {
