          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図をタップして、思いどおりの位置にピンを置きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij mapę, aby umieścić pinezkę w wybranym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
