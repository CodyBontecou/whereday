            "state": "translated",
            "value": "Quanto ele\ndeve lembrar?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要记录\n多少细节？"
          }
        }
      }
    },
    "Match photos to places": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطابقة الصور مع الأماكن"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match photos to places"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asociar fotos a lugares"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Associer les photos aux lieux"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を場所に照合"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Associar fotos a lugares"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将照片与地点匹配"
          }
        }
      }
    },
    "Shows your iPhone photos on the days and places they were taken. Photos stay in your library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض صور iPhone في الأيام والأماكن التي التُقطت فيها. تبقى الصور في مكتبتك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows your iPhone photos on the days and places they were taken. Photos stay in your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra las fotos de tu iPhone en los días y lugares en que se tomaron. Las fotos se quedan en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche vos photos iPhone aux jours et aux lieux où elles ont été prises. Les photos restent dans votre photothèque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneの写真を、撮影した日と場所に表示します。写真はライブラリに残ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra as fotos do seu iPhone nos dias e lugares em que foram tiradas. As fotos ficam na sua fototeca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在拍摄的日期和地点显示你的 iPhone 照片。照片仍保留在你的图库中。"
          }
        }
      }
    },
    "Allow Always so Whereday records when it's closed. You can change this anytime.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر «دائمًا» ليسجّل Whereday حتى عندما يكون مغلقًا. يمكنك تغيير ذلك في أي وقت."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Always so Whereday records when it's closed. You can change this anytime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Siempre para que Whereday grabe aunque esté cerrada. Puedes cambiarlo cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Toujours pour que Whereday enregistre même lorsqu’il est fermé. Vous pouvez modifier ce choix à tout moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「常に」を許可すると、Wheredayを閉じていても記録できます。いつでも変更できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita Sempre para o Whereday gravar mesmo fechado. Você pode mudar isso quando quiser."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择“始终”允许，让 Whereday 在关闭时也能记录。你可以随时更改。"
          }
        }
      }
    },
    "Location access is off. Turn it on in iPhone Settings → Whereday → Location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الموقع متوقف. فعّله من إعدادات iPhone → Whereday → الموقع."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location access is off. Turn it on in iPhone Settings → Whereday → Location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso a la ubicación está desactivado. Actívalo en Ajustes del iPhone → Whereday → Ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à la position est désactivé. Activez-le dans Réglages de l’iPhone → Whereday → Position."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置情報へのアクセスがオフです。iPhoneの設定 → Whereday → 位置情報でオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso à localização está desativado. Ative em Ajustes do iPhone → Whereday → Localização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置访问已关闭。请在 iPhone 设置 → Whereday → 位置中开启。"
          }
        }
      }
    },
