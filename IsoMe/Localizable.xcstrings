    "Choose a plan to track. Your existing records remain available to view and export." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر خطة للتتبع. تبقى سجلاتك الحالية متاحة للعرض والتصدير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্র্যাক করতে একটি প্ল্যান বেছে নিন। আপনার বিদ্যমান রেকর্ড দেখা ও রপ্তানির জন্য উপলব্ধ থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a plan to track. Your existing records remain available to view and export."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige un plan para usar el seguimiento. Tus registros existentes siguen disponibles para ver y exportar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une formule pour le suivi. Vos données existantes restent consultables et exportables."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ट्रैक करने के लिए प्लान चुनें। आपके मौजूदा रिकॉर्ड देखने और निर्यात करने के लिए उपलब्ध रहेंगे।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追跡するにはプランを選んでください。これまでの記録は引き続き閲覧・書き出しができます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz plan, aby śledzić. Istniejące zapisy nadal możesz przeglądać i eksportować."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um plano para rastrear. Seus registros existentes continuam disponíveis para consulta e exportação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите план для отслеживания. Существующие записи останутся доступны для просмотра и экспорта."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择方案以继续追踪。你现有的记录仍可查看和导出。"
          }
        }
      }
    },
    "Choose a saved location for a past visit, or save a newly selected place so it is ready next time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر موقعًا محفوظًا لزيارة سابقة، أو احفظ المكان المحدد حديثًا حتى يكون جاهزًا في المرة القادمة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি অতীত পরিদর্শনের জন্য একটি সংরক্ষিত অবস্থান চয়ন করুন, বা একটি নতুন নির্বাচিত স্থান সংরক্ষণ করুন যাতে এটি পরের বার প্রস্তুত হয়৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a saved location for a past visit, or save a newly selected place so it is ready next time."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija una ubicación guardada para una visita anterior o guarde un lugar recién seleccionado para que esté listo la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un emplacement enregistré pour une visite précédente ou enregistrez un lieu nouvellement sélectionné afin qu'il soit prêt la prochaine fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पिछली यात्रा के लिए कोई सहेजा गया स्थान चुनें, या किसी नए चयनित स्थान को सहेजें ताकि वह अगली बार तैयार हो।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去に訪れたときに保存した場所を選択するか、新しく選択した場所を保存して次回使えるようにします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz zapisaną lokalizację dla poprzedniej wizyty lub zapisz nowo wybrane miejsce, aby było gotowe następnym razem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha um local salvo para uma visita anterior ou salve um local recém-selecionado para que esteja pronto na próxima vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сохраненное место для прошлого посещения или сохраните вновь выбранное место, чтобы оно было готово в следующий раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择过去访问的已保存位置，或保存新选择的地点以便下次使用。"
          }
        }
      }
    },
    "Choose a saved location or request a fresh accurate current location." : {
      "localizations" : {
        "ar" : {
