        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे दोबारा इस्तेमाल होने वाला स्थान हट जाएगा। आपकी पिछली विज़िट बनी रहेंगी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
