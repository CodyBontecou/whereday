        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "প্রতি সপ্তাহে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"
