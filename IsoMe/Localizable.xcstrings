          "stringUnit": {
            "state": "translated",
            "value": "Whereday can’t record today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday no puede grabar hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday ne peut pas enregistrer aujourd’hui."
          }
        },
