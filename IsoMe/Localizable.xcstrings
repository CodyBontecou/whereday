          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "おでかけエクスポート"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EKSPORT PODRÓŻY"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "EXPORTAÇÃO DE PASSEIO"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ЭКСПОРТ ПРОГУЛКИ"
          }
