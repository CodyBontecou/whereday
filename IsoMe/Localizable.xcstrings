    "Sort your outing history and show or hide inferred historical outings so the timeline matches how you want to review trips." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بفرز سجل الرحلات الخاصة بك وإظهار أو إخفاء الرحلات التاريخية المستنتجة حتى يتطابق المخطط الزمني مع الطريقة التي تريد بها مراجعة الرحلات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার আউটিংয়ের ইতিহাস বাছাই করুন এবং অনুমান করা পুরোনো আউটিং দেখান বা লুকান, যাতে ট্রিপগুলো যেভাবে দেখতে চান টাইমলাইন সেভাবেই মেলে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sort your outing history and show or hide inferred historical outings so the timeline matches how you want to review trips."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordene su historial de salidas y muestre u oculte salidas históricas inferidas para que la línea de tiempo coincida con la forma en que desea revisar los viajes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Triez votre historique de sorties et affichez ou masquez les sorties historiques déduites afin que la chronologie corresponde à la façon dont vous souhaitez revoir les voyages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने सैर-सपाटे के इतिहास को क्रमबद्ध करें और अनुमानित ऐतिहासिक सैर-सपाटे को दिखाएँ या छिपाएँ ताकि समयरेखा मेल खाए कि आप यात्राओं की समीक्षा कैसे करना चाहते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイムラインが旅行のレビュー方法に一致するように、外出履歴を並べ替え、推定される過去の外出を表示または非表示にします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sortuj historię podróży i pokazuj lub ukrywaj oszacowane podróże z przeszłości, aby dopasować oś czasu do swoich potrzeb."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Classifique seu histórico de passeios e mostre ou oculte passeios históricos inferidos para que a linha do tempo corresponda à forma como você deseja revisar as viagens."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сортируйте историю прогулок и показывайте или скрывайте предполагаемые прошлые прогулки, чтобы хронология соответствовала тому, как вы хотите их просматривать."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对您的外出历史进行排序，并显示或隐藏推断的历史外出，以便时间线符合您想要回顾旅行的方式。"
          }
        }
      }
    },
