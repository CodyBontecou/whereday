            "state": "translated",
            "value": "Establezca el nombre de la salida Whereday que se está grabando actualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez le nom de la sortie Whereday en cours d'enregistrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान में रिकॉर्ड किए जा रहे Whereday आउटिंग का नाम सेट करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在記録されている Whereday 外出の名前を設定します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
