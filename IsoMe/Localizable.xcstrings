        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ট্র্যাকার বিনামূল্যে। আপনার বিদ্যমান আজীবন রপ্তানি কেনাকাটা দিয়ে CSV রপ্তানি করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The tracker is free. Export CSV with your existing lifetime export purchase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El seguimiento es gratuito. Exporta a CSV con tu compra de exportación de por vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le suivi est gratuit. Exportez en CSV grâce à votre achat à vie de l’exportation."
