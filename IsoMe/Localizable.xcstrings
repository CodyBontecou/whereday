          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las recetas guardadas aparecen encima de la frase. Toca una para cargar sus opciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les recettes enregistrées apparaissent au-dessus de la phrase. Touchez-en une pour charger ses choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई रेसिपी वाक्य के ऊपर दिखती हैं। उसके विकल्प लोड करने के लिए किसी पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
