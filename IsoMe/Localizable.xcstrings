    "Travel days count in both countries. %lld days have no record — tap one to add a stay.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحتسب أيام السفر في الدولتين. %lld يوم بلا سجل — اضغط أحدها لإضافة إقامة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Travel days count in both countries. %lld days have no record — tap one to add a stay."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días de viaje cuentan en ambos países. Hay %lld días sin registro: toca uno para añadir una estancia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours de voyage comptent dans les deux pays. %lld jours sans données — touchez-en un pour ajouter un séjour."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動日は両方の国で数えます。記録のない日が%lld日あります。タップして滞在を追加できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dias de viagem contam nos dois países. %lld dias não têm registro — toque em um para adicionar uma estadia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旅行日会同时计入两个国家。有 %lld 天没有记录——轻点其中一天即可添加停留。"
          }
        }
      }
    },
    "Countries appear as you record. Identify countries in your earlier history or add a manual stay to fill the year.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الدول أثناء التسجيل. حدّد الدول في سجلك الأقدم أو أضف إقامة يدوية لملء العام."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countries appear as you record. Identify countries in your earlier history or add a manual stay to fill the year."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los países aparecen a medida que grabas. Identifica los países de tu historial anterior o añade una estancia manual para completar el año."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pays apparaissent au fil de vos enregistrements. Identifiez les pays de votre historique antérieur ou ajoutez un séjour manuel pour compléter l’année."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "国は記録するにつれて表示されます。以前の履歴で国を特定するか、手動で滞在を追加して1年を埋めましょう。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os países aparecem conforme você grava. Identifique países no seu histórico anterior ou adicione uma estadia manual para completar o ano."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "国家会随着你的记录出现。识别早期历史中的国家，或手动添加停留来填满这一年。"
          }
        }
      }
    },
