    "Finish an open manual visit. Choose a visit when more than one is open." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أنهِ زيارة يدوية مفتوحة. اختر زيارة عند وجود أكثر من زيارة مفتوحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি চলমান ম্যানুয়াল ভিজিট শেষ করুন। একাধিক চলমান থাকলে একটি ভিজিট বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finish an open manual visit. Choose a visit when more than one is open."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Finaliza una visita manual abierta. Elige una visita si hay más de una abierta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Terminez une visite manuelle en cours. Choisissez une visite lorsque plusieurs sont ouvertes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "खुली मैन्युअल विज़िट पूरी करें। एक से ज़्यादा खुली हों तो विज़िट चुनें।"
