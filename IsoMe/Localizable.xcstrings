    "Map, timeline and calendar of where you've been." : {
      "comment" : "Carousel paywall.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خريطة وخط زمني وتقويم للأماكن التي زرتها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যেখানে গেছেন তার মানচিত্র, টাইমলাইন আর ক্যালেন্ডার।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Map, timeline and calendar of where you've been."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapa, línea de tiempo y calendario de dónde has estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Carte, chronologie et calendrier de vos lieux."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप जहाँ-जहाँ गए, उसका नक्शा, टाइमलाइन और कैलेंडर।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪れた場所をマップ、タイムライン、カレンダーで。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
