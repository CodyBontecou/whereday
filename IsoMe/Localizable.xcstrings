          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vea registros de actividad de la aplicación o chatee con la comunidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez les journaux d'activité des applications ou discutez avec la communauté."
          }
        },
        "hi" : {
          "stringUnit" : {
