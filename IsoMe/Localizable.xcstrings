        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu caminho em movimento, em silêncio quando parado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动时记录路径，静止时保持安静。"
          }
