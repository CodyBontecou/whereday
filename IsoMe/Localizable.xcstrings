    "Drop a precise map pin or enter exact coordinates to save any location." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع دبوسًا دقيقًا على الخريطة أو أدخل إحداثيات دقيقة لحفظ أي موقع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেকোনো অবস্থান সংরক্ষণ করতে মানচিত্রে নিখুঁত পিন বসান বা সঠিক স্থানাঙ্ক লিখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drop a precise map pin or enter exact coordinates to save any location."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca un pin preciso en el mapa o introduce coordenadas exactas para guardar cualquier ubicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Placez un repère précis sur la carte ou saisissez des coordonnées exactes pour enregistrer n’importe quel lieu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "किसी भी स्थान को सहेजने के लिए मानचित्र पर सटीक पिन लगाएँ या सटीक निर्देशांक दर्ज करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地図に正確なピンを置くか座標を入力すれば、どんな場所でも保存できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umieść pinezkę na mapie lub wpisz dokładne współrzędne, aby zapisać dowolną lokalizację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solte um alfinete preciso no mapa ou digite coordenadas exatas para salvar qualquer local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
