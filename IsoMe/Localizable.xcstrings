    "No GPS points were saved for this outing yet.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم حفظ أي نقاط GPS لهذه النزهة حتى الآن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই আউটিংয়ের জন্য এখনও কোনও GPS পয়েন্ট সংরক্ষণ করা হয়নি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No GPS points were saved for this outing yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se han guardado puntos GPS para esta salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun point GPS n'a encore été enregistré pour cette sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आउटिंग के लिए अभी तक कोई GPS पॉइंट सहेजा नहीं गया था।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この外出のGPSポイントはまだ保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tej podróży nie zapisano jeszcze żadnych punktów GPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum ponto GPS foi salvo para este passeio ainda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой прогулки еще не сохранено ни одной точки GPS ."
