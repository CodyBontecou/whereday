    "Analysis stopped because network geocoding is disabled.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف التحليل لأن تحديد المواقع الجغرافية عبر الشبكة معطّل."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis stopped because network geocoding is disabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo porque la geocodificación en red está desactivada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse interrompue, car le géocodage réseau est désactivé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークジオコーディングがオフのため、分析を停止しました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza została zatrzymana, ponieważ geokodowanie przez sieć jest wyłączone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A análise parou porque a geocodificação pela rede está desativada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于网络地理编码已关闭，分析已停止。"
          }
        }
      }
    },
    "Analysis stopped. Completed results are saved; analyze again to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف التحليل. حُفظت النتائج المكتملة؛ حلّل مجددًا للمتابعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis stopped. Completed results are saved; analyze again to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El análisis se detuvo. Los resultados completados se han guardado; vuelve a analizar para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse interrompue. Les résultats obtenus sont enregistrés ; relancez l’analyse pour continuer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分析を停止しました。完了した結果は保存されています。続けるにはもう一度分析してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza zatrzymana. Gotowe wyniki zostały zapisane; uruchom analizę ponownie, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Análise interrompida. Os resultados concluídos foram salvos; analise novamente para continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析已停止。已完成的结果已保存；再次分析即可继续。"
          }
        }
      }
    },
    "Analyze saved locations": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحليل المواقع المحفوظة"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze saved locations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar ubicaciones guardadas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyser les positions enregistrées"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した位置を分析"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizuj zapisane lokalizacje"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analisar locais salvos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析已保存的位置"
          }
        }
      }
    },
    "Analyze saved locations or add a manual stay. Try All time to see older records.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّل المواقع المحفوظة أو أضف إقامة يدوية. جرّب «كل الوقت» لرؤية السجلات الأقدم."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze saved locations or add a manual stay. Try All time to see older records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza las ubicaciones guardadas o añade una estancia manual. Prueba con «Todo el tiempo» para ver registros más antiguos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez les positions enregistrées ou ajoutez un séjour manuel. Choisissez Tout le temps pour voir les données plus anciennes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した位置を分析するか、手動で滞在を追加してください。古い記録を見るには「すべての期間」をお試しください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeanalizuj zapisane lokalizacje lub dodaj pobyt ręcznie. Wybierz „Cały okres”, aby zobaczyć starsze wpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise os locais salvos ou adicione uma estadia manual. Experimente Todo o tempo para ver registros mais antigos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析已保存的位置或手动添加停留。尝试“所有时间”以查看更早的记录。"
          }
        }
      }
    },
    "Analyze saved locations with saved progress, stopping and resuming, and clearer messages when country lookup is unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حلّل المواقع المحفوظة مع حفظ التقدّم، وإمكانية الإيقاف والاستئناف، ورسائل أوضح عند تعذّر البحث عن الدولة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyze saved locations with saved progress, stopping and resuming, and clearer messages when country lookup is unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza las ubicaciones guardadas con progreso guardado, pausa y reanudación, y mensajes más claros cuando la búsqueda de países no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysez les positions enregistrées avec progression sauvegardée, possibilité d’interrompre et de reprendre, et des messages plus clairs quand la recherche de pays est indisponible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した位置の分析で進捗が保存され、停止と再開ができるようになりました。国の特定ができないときのメッセージもわかりやすくなりました。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizuj zapisane lokalizacje z zapisywaniem postępu, zatrzymywaniem i wznawianiem oraz czytelniejszymi komunikatami, gdy ustalanie kraju jest niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Analise os locais salvos com progresso salvo, pausa e retomada, e mensagens mais claras quando a busca de país não estiver disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析已保存的位置时可保存进度、随时停止和继续，国家查询不可用时提示也更清晰。"
          }
        }
      }
    },
