    "“Are you here?”" : {
      "comment" : "Layer and help title for current-place suggestions.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«هل أنت هنا؟»"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“আপনি কি এখানে?”"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Are you here?”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«¿Estás aquí?»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Vous êtes ici ? »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“क्या आप यहाँ हैं?”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ここにいますか？」"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Jesteś tu?”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Você está aqui?”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Вы здесь?»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“你在这里吗？”"
          }
        }
      }
    },
    "“Hey Siri, how far have I gone with %@?”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«يا Siri، كم قطعت من مسافة في %@؟»"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“হেই Siri, %@ অনুযায়ী আমি কতদূর গেছি?”"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, how far have I gone with %@?”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Oye Siri, ¿qué distancia he recorrido con %@?»"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Dis Siri, quelle distance ai-je parcourue avec %@ ? »"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Hey Siri, %@ में मैं कितना चला?”"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「Hey Siri、%@でどれくらい移動した？」"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Hej Siri, jaki dystans pokonałem w %@?”"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“E aí Siri, quanto já percorri no %@?”"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Привет, Siri, сколько я прошёл в %@?»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“嘿 Siri，用 %@ 查看我走了多远？”"
          }
        }
      }
    },
