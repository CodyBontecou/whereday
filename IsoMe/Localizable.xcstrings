    "OwnTracks format works with Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), and Traccar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل تنسيق OwnTracks مع Dawarich (api/v1/owntracks/points)، ومسجل OwnTracks (/pub)، وTraccar."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks ফরম্যাট Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), এবং Traccar-এর সাথে কাজ করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OwnTracks format works with Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub), and Traccar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El formato OwnTracks funciona con Dawarich (api/v1/owntracks/points), OwnTracks Recorder (/pub) y Traccar."
          }
        },
        "fr": {
          "stringUnit": {
