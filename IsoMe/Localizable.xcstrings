    "Ready for your\nnext chapter.": {
      "comment": "Final onboarding headline. An inviting next chapter, not a sales slogan; prefer gender-neutral phrasing where possible.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء جاهز\nلفصلك القادم."
