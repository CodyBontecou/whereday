    "Pay only the difference from Individual Lifetime": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع فقط فرق السعر عن «مدى الحياة للفرد»"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্ডিভিজুয়াল লাইফটাইম থেকে শুধু দামের পার্থক্যটুকু দিন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay only the difference from Individual Lifetime"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paga solo la diferencia respecto a Individual de por vida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez uniquement la différence avec Individuel à vie"
          }
