    "Your changes to this saved location have not been saved.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تُحفظ تغييراتك على هذا الموقع المحفوظ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your changes to this saved location have not been saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en esta ubicación guardada no se han guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos modifications de ce lieu enregistré n’ont pas été enregistrées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この保存した場所への変更は保存されていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany tej lokalizacji nie zostały zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas alterações neste local salvo não foram salvas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你对此已保存地点的更改尚未保存。"
          }
        }
      }
    },
    "Your existing purchase includes complimentary lifetime access to myself.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتضمن شراؤك الحالي وصولًا مجانيًا مدى الحياة إلى myself.md."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing purchase includes complimentary lifetime access to myself.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu compra incluye acceso de por vida gratuito a myself.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre achat existant inclut un accès à vie offert à myself.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ご購入済みのプランには、myself.mdの無料の永久アクセスが含まれます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dotychczasowy zakup obejmuje bezpłatny dożywotni dostęp do myself.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua compra inclui acesso vitalício gratuito ao myself.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现有的购买包含 myself.md 的免费终身权限。"
          }
        }
      }
    },
    "Your export access is permanent.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمكانية التصدير لديك دائمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার এক্সপোর্ট অ্যাক্সেস স্থায়ী।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your export access is permanent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso de exportación es permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès à l’export est permanent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका एक्सपोर्ट एक्सेस स्थायी है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し機能は無期限です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój dostęp do eksportu jest stały."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso à exportação é permanente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к экспорту бессрочный."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的导出权限永久有效。"
          }
        }
      }
    },
    "Your export access is permanent. Upgrade once to share it through Apple Family Sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إمكانية التصدير لديك دائمة. رقِّها مرة واحدة لمشاركتها عبر المشاركة العائلية من Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার এক্সপোর্ট অ্যাক্সেস স্থায়ী। Apple ফ্যামিলি শেয়ারিংয়ের মাধ্যমে শেয়ার করতে একবার আপগ্রেড করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your export access is permanent. Upgrade once to share it through Apple Family Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu acceso de exportación es permanente. Mejora una vez para compartirlo mediante En familia de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès à l’export est permanent. Effectuez une mise à niveau unique pour le partager via le partage familial Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका एक्सपोर्ट एक्सेस स्थायी है। Apple फ़ैमिली शेयरिंग से शेयर करने के लिए एक बार अपग्रेड करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き出し機能は無期限です。一度アップグレードするとAppleのファミリー共有で共有できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masz stały dostęp do eksportu. Przejdź jednorazowo na wyższy plan, aby udostępniać go przez Chmurę rodzinną Apple."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso à exportação é permanente. Faça um único upgrade para compartilhá-lo pelo Compartilhamento Familiar da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к экспорту бессрочный. Оплатите улучшение один раз, чтобы поделиться им через Семейный доступ Apple."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的导出权限永久有效。只需升级一次，即可通过 Apple 家人共享与家人共享。"
          }
        }
      }
    },
    "Your places,\nautomatically.": {
      "comment": "Location-permission headline: visited places are recorded automatically once access is granted. Calm and personal, without implying permission is already granted.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكنك،\nتُسجَّل تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যেখানে যান,\nআপনা থেকেই নথিভুক্ত।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your places,\nautomatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lugares,\nde forma automática."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos lieux,\nnotés automatiquement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी जगहें,\nअपने-आप दर्ज।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪れた場所を、\n自動で記録。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje miejsca.\nZapisują się same."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus lugares,\nautomaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши места —\nзапишутся сами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "走过的地方，\n自动为你记下。"
          }
        }
      }
    },
    "Your places.\nYour photographs.": {
      "comment": "Optional Photos headline. Two short, parallel phrases connecting personal places and photographs; keep the quiet, travel-journal tone.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أماكنك.\nصورك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার জায়গাগুলো।\nআপনার ছবিগুলো।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your places.\nYour photographs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus lugares.\nTus fotografías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos lieux.\nVos photographies."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी जगहें।\nआपकी तस्वीरें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪れた場所。\nあなたの写真。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje miejsca.\nTwoje zdjęcia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus lugares.\nSuas fotografias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши места.\nВаши фотографии."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你去过的地方。\n你拍下的照片。"
          }
        }
      }
    },
