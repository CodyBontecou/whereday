    "Identified %lld of %lld locations. Unavailable lookups can be retried after an hour.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تحديد %lld من %lld موقع. يمكن إعادة محاولة عمليات البحث غير المتاحة بعد ساعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identified %lld of %lld locations. Unavailable lookups can be retried after an hour."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se identificaron %lld de %lld ubicaciones. Las búsquedas no disponibles se pueden reintentar al cabo de una hora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld positions identifiées sur %lld. Les recherches indisponibles pourront être relancées dans une heure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld件の場所を特定しました（全%lld件）。特定できなかったものは1時間後に再試行できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznano %lld z %lld lokalizacji. Nieudane próby można ponowić po godzinie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld de %lld locais identificados. Buscas indisponíveis podem ser repetidas depois de uma hora."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已识别 %lld 个位置，共 %lld 个。不可用的查询可在一小时后重试。"
          }
        }
      }
    },
