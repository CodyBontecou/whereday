    "Shows your iPhone photos on the days and places they were taken. Photos stay in your library." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض صور iPhone في الأيام والأماكن التي التُقطت فيها. تبقى الصور في مكتبتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার iPhone-এর ছবি যে দিনে ও যে জায়গায় তোলা, সেখানে দেখায়। ছবি আপনার লাইব্রেরিতেই থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows your iPhone photos on the days and places they were taken. Photos stay in your library."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra las fotos de tu iPhone en los días y lugares en que se tomaron. Las fotos se quedan en tu fototeca."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche vos photos iPhone aux jours et aux lieux où elles ont été prises. Les photos restent dans votre photothèque."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी iPhone फ़ोटो उन दिनों और जगहों पर दिखाता है जहाँ वे ली गईं। फ़ोटो आपकी लाइब्रेरी में ही रहती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iPhoneの写真を、撮影した日と場所に表示します。写真はライブラリに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje zdjęcia z iPhone’a w dniach i miejscach, w których zostały zrobione. Zdjęcia pozostają w Twojej bibliotece."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra as fotos do seu iPhone nos dias e lugares em que foram tiradas. As fotos ficam na sua fototeca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает фото с iPhone в те дни и в тех местах, где они были сделаны. Фото остаются в вашей медиатеке."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在拍摄的日期和地点显示你的 iPhone 照片。照片仍保留在你的图库中。"
          }
        }
      }
    },
