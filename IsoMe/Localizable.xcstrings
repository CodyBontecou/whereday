            "state": "translated",
            "value": "Export à vie actif"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइफ़टाइम एक्सपोर्ट चालू है"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りの書き出しが有効です"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dożywotni eksport aktywny"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportação vitalícia ativa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бессрочный экспорт активен"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身导出已启用"
          }
        }
      }
    },
    "Lifetime plans are one-time purchases charged to your Apple ID. Family plans require Apple Family Sharing and Purchase Sharing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطط مدى الحياة هي عمليات شراء لمرة واحدة تُحتسب على حساب Apple الخاص بك. تتطلب الخطط العائلية المشاركة العائلية ومشاركة المشتريات من Apple."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লাইফটাইম প্ল্যান Apple ID-তে চার্জ করা এককালীন কেনাকাটা। ফ্যামিলি প্ল্যানের জন্য Apple ফ্যামিলি শেয়ারিং ও পারচেজ শেয়ারিং প্রয়োজন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifetime plans are one-time purchases charged to your Apple ID. Family plans require Apple Family Sharing and Purchase Sharing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes de por vida son compras únicas que se cobran a tu Apple ID. Los planes Familiares requieren En familia y Compartir compras de Apple."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les formules à vie sont des achats uniques facturés à votre identifiant Apple. Les formules Famille nécessitent le partage familial et le partage des achats Apple."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइफ़टाइम प्लान आपके Apple ID से ली जाने वाली एकमुश्त खरीद हैं। फ़ैमिली प्लान के लिए Apple फ़ैमिली शेयरिंग और परचेज़ शेयरिंग ज़रूरी है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "買い切りプランはApple IDに請求される1回限りの購入です。ファミリープランにはAppleのファミリー共有と「購入アイテムの共有」が必要です。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plany dożywotnie kupujesz jednorazowo za pomocą swojego konta Apple. Plany rodzinne wymagają Chmury rodzinnej Apple i włączonego udostępniania zakupów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os planos vitalícios são compras únicas cobradas no seu ID Apple. Os planos Família exigem Compartilhamento Familiar e Compartilhamento de Compras da Apple."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Бессрочные планы оплачиваются один раз через Apple ID. Для семейных планов нужны Семейный доступ Apple и общий доступ к покупкам."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "终身方案是通过 Apple ID 支付的一次性购买。家庭方案需要开启 Apple 家人共享和购买项目共享。"
          }
        }
      }
    },
