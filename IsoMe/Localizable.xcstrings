    "%@ (%@–%@) falls inside this stop, so it can’t be trimmed. Review the times, or save to keep both visits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقع %@ (%@–%@) داخل هذا التوقف، لذا لا يمكن قصّه. راجع الأوقات، أو احفظ للإبقاء على الزيارتين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) এই থামার ভেতরে পড়ে, তাই এটি ছাঁটা যাবে না। সময়গুলো দেখে নিন, অথবা দুটি ভিজিট রাখতে সংরক্ষণ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) falls inside this stop, so it can’t be trimmed. Review the times, or save to keep both visits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) está dentro de esta parada, así que no se puede recortar. Revisa las horas o guarda para conservar ambas visitas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) se situe dans cet arrêt et ne peut donc pas être raccourci. Vérifiez les heures, ou enregistrez pour conserver les deux visites."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) इस पड़ाव के अंदर आता है, इसलिए इसे छोटा नहीं किया जा सकता। समय जाँचें, या दोनों विज़िट रखने के लिए सहेजें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@–%@）はこの立ち寄りの時間内にあるため、短縮できません。時刻を確認するか、保存して両方の訪問を残してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) mieści się w całości w tym postoju, więc nie można jej przyciąć. Sprawdź godziny lub zapisz, aby zachować obie wizyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ (%@–%@) fica dentro desta parada, então não é possível ajustar o horário. Revise os horários ou salve para manter as duas visitas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посещение %@ (%@–%@) целиком попадает в эту остановку, поэтому его нельзя обрезать. Проверьте время или сохраните, чтобы оставить оба посещения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@（%@–%@）位于此次停留时间之内，因此无法裁剪。请检查时间，或保存以保留两次到访。"
          }
        }
      }
    },
