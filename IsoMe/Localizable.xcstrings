    "Exports will use the share sheet instead of saving directly to a folder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستستخدم عمليات التصدير ورقة المشاركة بدلاً من حفظها مباشرةً في مجلد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "রপ্তানি একটি ফোল্ডারে সরাসরি সংরক্ষণ করার পরিবর্তে শেয়ার শীট ব্যবহার করবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports will use the share sheet instead of saving directly to a folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones utilizarán la hoja compartida en lugar de guardarse directamente en una carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exportations utiliseront la feuille de partage au lieu d'être enregistrées directement dans un dossier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात किसी फ़ोल्डर में सीधे सहेजने के बजाय शेयर शीट का उपयोग करेगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートでは、フォルダーに直接保存するのではなく、共有シートを使用します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksporty będą korzystać z arkusza udostępniania zamiast zapisywać bezpośrednio w folderze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exportações usarão a planilha de compartilhamento em vez de serem salvas diretamente em uma pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
