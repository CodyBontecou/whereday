    "An illustration of half a year of days, each colored by place": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "رسم توضيحي لنصف عام من الأيام، كل يوم بلون مكانه"}},
        "bn": {"stringUnit": {"state": "translated", "value": "ছয় মাসের দিনগুলোর একটি চিত্র, প্রতিটি দিন জায়গা অনুযায়ী রঙিন"}},
        "en": {"stringUnit": {"state": "translated", "value": "An illustration of half a year of days, each colored by place"}},
        "es": {"stringUnit": {"state": "translated", "value": "Una ilustración de medio año de días, cada uno coloreado según el lugar"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Une illustration de six mois de journées, chacune colorée selon le lieu"}},
        "hi": {"stringUnit": {"state": "translated", "value": "आधे साल के दिनों का चित्र, हर दिन जगह के हिसाब से रंगा"}},
        "ja": {"stringUnit": {"state": "translated", "value": "半年分の日々のイラスト。日ごとに場所の色で塗られています"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ilustracja pół roku dni, każdy w kolorze miejsca"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Uma ilustração de meio ano de dias, cada um colorido pelo lugar"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Иллюстрация полугода, каждый день окрашен цветом места"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "半年日子的示意图，每天按地点着色"}}
      }
    },
    "Your last 26 weeks, each day colored by the place you spent most time at": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "آخر ٢٦ أسبوعًا، كل يوم بلون المكان الذي قضيت فيه معظم وقتك"}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার শেষ ২৬ সপ্তাহ, প্রতিটি দিন সবচেয়ে বেশি সময় কাটানো জায়গার রঙে"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your last 26 weeks, each day colored by the place you spent most time at"}},
        "es": {"stringUnit": {"state": "translated", "value": "Tus últimas 26 semanas, cada día coloreado según el lugar donde más tiempo pasaste"}},
        "fr": {"stringUnit": {"state": "translated", "value": "Vos 26 dernières semaines, chaque jour coloré selon le lieu où vous avez passé le plus de temps"}},
        "hi": {"stringUnit": {"state": "translated", "value": "आपके पिछले 26 हफ़्ते, हर दिन उस जगह के रंग में जहाँ आपने सबसे ज़्यादा समय बिताया"}},
        "ja": {"stringUnit": {"state": "translated", "value": "直近26週間。日ごとに一番長く過ごした場所の色で表示"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Ostatnie 26 tygodni, każdy dzień w kolorze miejsca, w którym spędziłeś najwięcej czasu"}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Suas últimas 26 semanas, cada dia colorido pelo lugar onde você passou mais tempo"}},
        "ru": {"stringUnit": {"state": "translated", "value": "Последние 26 недель, каждый день — цветом места, где вы провели больше всего времени"}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "最近 26 周，每天按停留最久的地点着色"}}
      }
