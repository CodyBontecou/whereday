            "state": "translated",
            "value": "Usuario ingresado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateur entré"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगकर्ता प्रविष्ट हुआ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーが入力しました"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowadzona ręcznie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuário inserido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пользователь вошел"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户输入"
          }
        }
      }
    },
    "Uses Apple Maps routes to bend sparse GPS gaps onto nearby roads when possible, instead of drawing rough point-to-point lines.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم مسارات Apple Maps لسد فجوات GPS المتفرقة على الطرق القريبة عندما يكون ذلك ممكنًا، بدلاً من رسم خطوط تقريبية من نقطة إلى نقطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মোটামুটি পয়েন্ট-টু-পয়েন্ট লাইন আঁকার পরিবর্তে, সম্ভব হলে কাছের রাস্তায় বিক্ষিপ্ত GPS ফাঁক বাঁকানোর জন্য Apple Maps রুট ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses Apple Maps routes to bend sparse GPS gaps onto nearby roads when possible, instead of drawing rough point-to-point lines."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza rutas Apple Maps para doblar los escasos espacios GPS hacia carreteras cercanas cuando sea posible, en lugar de dibujar líneas toscas de punto a punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise les itinéraires Apple Maps pour combler les lacunes GPS clairsemées sur les routes à proximité lorsque cela est possible, au lieu de tracer des lignes approximatives point à point."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी संभव हो, खुरदरी बिंदु-से-बिंदु रेखाएँ खींचने के बजाय, आस-पास की सड़कों पर विरल GPS अंतराल को मोड़ने के लिए Apple Maps मार्गों का उपयोग करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Mapsルートを使用して、大まかなポイント間の線を描くのではなく、可能であれば近くの道路にまばらなGPSギャップを曲げます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopasowuje trasę do pobliskich dróg przy użyciu Map Apple, gdy między punktami GPS są luki, zamiast łączyć punkty prostymi liniami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa rotas Apple Maps para desviar lacunas esparsas GPS em estradas próximas quando possível, em vez de desenhar linhas ásperas ponto a ponto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует маршруты Apple Maps , чтобы по возможности совместить редкие промежутки GPS с близлежащими дорогами, вместо рисования грубых линий из двух точек."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尽可能使用Apple Maps路线将稀疏的GPS间隙弯曲到附近的道路上，而不是绘制粗糙的点对点线。"
          }
        }
      }
    },
    "Uses photo GPS when available, otherwise matches timestamps to nearby route points or visits.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم GPS للصور عندما يكون متاحًا، وإلا فإنه يطابق الطوابع الزمنية لنقاط الطريق أو الزيارات القريبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উপলব্ধ হলে ফটো GPS ব্যবহার করে, অন্যথায় কাছাকাছি রুট পয়েন্ট বা ভিজিটের সাথে টাইমস্ট্যাম্প মেলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses photo GPS when available, otherwise matches timestamps to nearby route points or visits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliza GPS fotográfico cuando está disponible; de ​​lo contrario, compara marcas de tiempo con puntos de ruta o visitas cercanas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise GPS photo lorsqu'il est disponible, sinon fait correspondre les horodatages aux points d'itinéraire ou aux visites à proximité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपलब्ध होने पर फोटो GPS उपयोग करता है, अन्यथा पास के मार्ग बिंदुओं या यात्राओं के टाइमस्टैम्प का मिलान करता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能な場合は写真GPSを使用し、そうでない場合はタイムスタンプを近くのルート ポイントまたは訪問先と照合します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa danych GPS zdjęcia, a jeśli ich brakuje — dopasowuje czas wykonania do pobliskich punktów trasy lub wizyt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa GPS fotográfico quando disponível, caso contrário, combina carimbos de data/hora com pontos de rota ou visitas próximos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использует фото GPS если таковой имеется, в противном случае сопоставляет временные метки с близлежащими точками маршрута или посещениями."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果可用，则使用照片GPS ，否则将时间戳与附近的路线点或访问进行匹配。"
          }
        }
      }
    },
    "Uses small dots instead of photo images or camera pins. Larger dots represent grouped photos. Tap a dot to browse; previews load only when you open the photos. Turn this off to restore your image or pin preference.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم نقاطًا صغيرة بدلًا من صور أو دبابيس كاميرا. تمثّل النقاط الأكبر صورًا مجمّعة. اضغط نقطة للتصفح؛ لا تُحمَّل المعاينات إلا عند فتح الصور. أوقفه لاستعادة تفضيلك للصور أو الدبابيس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses small dots instead of photo images or camera pins. Larger dots represent grouped photos. Tap a dot to browse; previews load only when you open the photos. Turn this off to restore your image or pin preference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa puntos pequeños en lugar de imágenes o pines de cámara. Los puntos más grandes representan fotos agrupadas. Toca un punto para explorar; las vistas previas solo se cargan al abrir las fotos. Desactívalo para recuperar tu preferencia de imágenes o pines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise de petits points au lieu des images ou des repères appareil photo. Les points plus gros représentent des photos regroupées. Touchez un point pour parcourir ; les aperçus ne se chargent qu’à l’ouverture des photos. Désactivez cette option pour revenir à votre préférence images ou repères."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の画像やカメラピンの代わりに小さなドットで表示します。大きいドットは写真のグループです。ドットをタップして閲覧でき、プレビューは写真を開いたときだけ読み込まれます。オフにすると画像またはピンの設定に戻ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używa małych punktów zamiast miniatur zdjęć lub pinezek z ikoną aparatu. Większe punkty oznaczają grupy zdjęć. Stuknij punkt, aby je przeglądać; podglądy są wczytywane dopiero po otwarciu zdjęć. Wyłącz tę opcję, aby przywrócić wcześniejszy wybór miniatur lub pinezek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa pequenos pontos em vez de imagens ou alfinetes de câmera. Pontos maiores representam fotos agrupadas. Toque em um ponto para explorar; as prévias só carregam quando você abre as fotos. Desative para voltar à sua preferência de imagem ou alfinete."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用小圆点代替照片图像或相机图钉。较大的圆点表示成组的照片。轻点圆点即可浏览；只有打开照片时才会载入预览。关闭后将恢复你的图像或图钉偏好。"
          }
        }
      }
    },
