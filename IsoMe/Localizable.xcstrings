    "You keep coming back here. Save it to name its future visits and follow its rhythm." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود إلى هنا باستمرار. احفظه لتسمية زياراته المستقبلية ومتابعة إيقاعه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি বারবার এখানে ফিরে আসেন। ভবিষ্যৎ ভিজিটের নাম দিতে ও এর ছন্দ অনুসরণ করতে এটি সংরক্ষণ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You keep coming back here. Save it to name its future visits and follow its rhythm."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelves aquí una y otra vez. Guárdalo para poner nombre a sus próximas visitas y seguir su ritmo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous revenez souvent ici. Enregistrez ce lieu pour nommer ses futures visites et suivre son rythme."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप यहाँ बार-बार आते हैं। इसकी भविष्य की विज़िट को नाम देने और इसकी लय देखने के लिए इसे सहेजें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何度もここに来ています。保存すると今後の訪問に名前が付き、訪れるリズムもわかります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciągle tu wracasz. Zapisz to miejsce, aby nadawać nazwę przyszłym wizytom i śledzić jego rytm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você sempre volta aqui. Salve para dar nome às próximas visitas e acompanhar o ritmo delas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы возвращаетесь сюда снова и снова. Сохраните место, чтобы называть будущие посещения и следить за их ритмом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你常常回到这里。保存它，为今后的到访命名，并了解你来这里的规律。"
          }
        }
      }
    },
