    "Every mode also notes the places you stop and large moves, even when Whereday is closed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدوّن كل وضع أيضًا الأماكن التي تتوقف فيها والتنقلات الكبيرة، حتى عندما يكون Whereday مغلقًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every mode also notes the places you stop and large moves, even when Whereday is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los modos anotan también los lugares donde paras y los desplazamientos largos, incluso con Whereday cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mode note aussi les lieux où vous vous arrêtez et les grands déplacements, même lorsque Whereday est fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのモードでも、Wheredayを閉じていても立ち寄った場所と大きな移動は記録されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os modos também anotam os lugares onde você para e os deslocamentos grandes, mesmo com o Whereday fechado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每种模式都会记下你停留的地点和较大的移动，即使 Whereday 已关闭。"
          }
        }
      }
    },
    "FINE-TUNE": {
      "localizations": {
        "ar": {
