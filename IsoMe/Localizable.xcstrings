    "Export will create one file per selected format. Add {format} to the file path if you want each filename to include its format." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي التصدير إلى إنشاء ملف واحد لكل تنسيق محدد. أضف {format} إلى مسار الملف إذا كنت تريد أن يتضمن كل اسم ملف تنسيقه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রপ্তানি নির্বাচিত বিন্যাস প্রতি একটি ফাইল তৈরি করবে। ফাইল পাথে {format} যোগ করুন যদি আপনি প্রতিটি ফাইলের নাম তার ফর্ম্যাট অন্তর্ভুক্ত করতে চান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Export will create one file per selected format. Add {format} to the file path if you want each filename to include its format."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La exportación creará un archivo por formato seleccionado. Agregue {format} a la ruta del archivo si desea que cada nombre de archivo incluya su formato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'exportation créera un fichier par format sélectionné. Ajoutez {format} au chemin du fichier si vous souhaitez que chaque nom de fichier inclue son format."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्यात प्रत्येक चयनित प्रारूप में एक फ़ाइल बनाएगा। यदि आप चाहते हैं कि प्रत्येक फ़ाइल नाम में उसका प्रारूप शामिल हो, तो फ़ाइल पथ में {format} जोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポートでは、選択した形式ごとに 1 つのファイルが作成されます。各ファイル名にその形式を含める場合は、ファイル パスに{format}を追加します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksport utworzy jeden plik na wybrany format. Dodaj {format} do ścieżki pliku, jeśli chcesz, aby każda nazwa pliku zawierała swój format."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A exportação criará um arquivo por formato selecionado. Adicione {format} ao caminho do arquivo se desejar que cada nome de arquivo inclua seu formato."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При экспорте будет создан один файл для каждого выбранного формата. Добавьте {format} к пути к файлу, если вы хотите, чтобы каждое имя файла включало его формат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导出将为每种选定的格式创建一个文件。如果您希望每个文件名包含其格式，请将{format}添加到文件路径。"
          }
        }
      }
    },
