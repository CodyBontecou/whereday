    "%@ charged once to your Apple Account. No subscription." : {
      "comment" : "Lifetime or Family-upgrade charge. %@ is StoreKit's localized price, inserted unchanged. One payment, no recurring subscription.",
      "localizations" : {
        "ar" : {
