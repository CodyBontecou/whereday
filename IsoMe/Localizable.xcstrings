            "value": "Użyj lokalizacji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar localização"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать местоположение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用地点"
          }
        }
      }
    },
    "Use name, latitude, longitude, address, and radius_meters columns. Address and radius are optional; the default radius is 150 meters. You can review the locations before importing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم الأعمدة name وlatitude وlongitude وaddress وradius_meters. العنوان والنطاق اختياريان؛ النطاق الافتراضي 150 مترًا. يمكنك مراجعة المواقع قبل الاستيراد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use name, latitude, longitude, address, and radius_meters columns. Address and radius are optional; the default radius is 150 meters. You can review the locations before importing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las columnas name, latitude, longitude, address y radius_meters. La dirección y el radio son opcionales; el radio predeterminado es de 150 metros. Puedes revisar las ubicaciones antes de importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les colonnes name, latitude, longitude, address et radius_meters. L’adresse et le rayon sont facultatifs ; le rayon par défaut est de 150 mètres. Vous pourrez vérifier les lieux avant l’importation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "name、latitude、longitude、address、radius_metersの列を使います。addressとradiusは任意で、半径の既定値は150メートルです。インポートする前に場所を確認できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj kolumn name, latitude, longitude, address i radius_meters. Adres i promień są opcjonalne; domyślny promień to 150 metrów. Przed importem możesz sprawdzić lokalizacje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as colunas name, latitude, longitude, address e radius_meters. Endereço e raio são opcionais; o raio padrão é de 150 metros. Você pode revisar os locais antes de importar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 name、latitude、longitude、address 和 radius_meters 列。address 和 radius 为可选项；默认半径为 150 米。导入前可以先检查这些地点。"
          }
        }
      }
    },
    "Use your default navigation app": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم تطبيق الملاحة الافتراضي"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your default navigation app"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar tu app de navegación predeterminada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser votre app de navigation par défaut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定のナビアプリを使う"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj domyślnej aplikacji nawigacyjnej"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar seu app de navegação padrão"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用默认导航应用"
          }
        }
      }
    },
    "Use {title} or {name} in export paths, and Whereday keeps one-file-per-outing exports distinct automatically.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم {title} أو {name} في مسارات التصدير، وسيحافظ Whereday على تمييز عمليات التصدير لكل ملف واحد تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট পাথগুলিতে {title} বা {name} ব্যবহার করুন, এবং Whereday এক-ফাইল-প্রতি-আউটিং এক্সপোর্টগুলিকে স্বয়ংক্রিয়ভাবে আলাদা করে রাখে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {title} or {name} in export paths, and Whereday keeps one-file-per-outing exports distinct automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilice {title} o {name} en las rutas de exportación e Whereday mantiene diferenciadas automáticamente las exportaciones de un archivo por salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez {title} ou {name} dans les chemins d'exportation, et Whereday conserve automatiquement les exportations d'un fichier par sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात पथों में {title} या {name} उपयोग करें, और Whereday एक-फ़ाइल-प्रति-आउटिंग निर्यात को स्वचालित रूप से अलग रखता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポート パスで{title}または{name}を使用すると、 Whereday出力ごとに 1 つのファイルのエクスポートを自動的に区別します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj {title} lub {name} w ścieżkach eksportu, a Whereday automatycznie rozróżnia eksporty jednego pliku na wyjście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use {title} ou {name} nos caminhos de exportação e Whereday mantém as exportações de um arquivo por saída distintas automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте {title} или {name} в путях экспорта, и Whereday автоматически разделит экспорт по одному файлу на каждый исходящий файл."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在导出路径中使用{title}或{name} ， Whereday会自动保持每次导出一个文件的导出不同。"
          }
        }
      }
    },
    "User entered": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دخل المستخدم"
          }
        },
        "bn": {
