    "Your plan starts on %@ at %@. Cancel in Apple settings before then if you don't want to continue." : {
      "comment" : "Carousel paywall.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبدأ خطتك في %@ بسعر %@. ألغِ من إعدادات Apple قبل ذلك إن لم ترغب في المتابعة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার প্ল্যান %@ তারিখে %@ দামে শুরু হবে। চালিয়ে যেতে না চাইলে তার আগেই Apple সেটিংসে বাতিল করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your plan starts on %@ at %@. Cancel in Apple settings before then if you don't want to continue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu plan empieza el %@ por %@. Cancela antes en los ajustes de Apple si no quieres continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre formule commence le %@ au prix de %@. Annulez dans les réglages Apple avant cette date si vous ne souhaitez pas continuer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका प्लान %@ को %@ की कीमत पर शुरू होगा। अगर आप जारी नहीं रखना चाहते, तो उससे पहले Apple सेटिंग्स में रद्द करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プランは%@に%@で開始します。続けない場合は、それまでにAppleの設定で解約してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twój plan zaczyna się %@ w cenie %@. Jeśli nie chcesz go kontynuować, anuluj wcześniej w ustawieniach Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu plano começa em %@ por %@. Cancele antes nos ajustes da Apple se não quiser continuar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подписка начнётся %@ по цене %@. Если не хотите продолжать, отмените её заранее в настройках Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的方案将于 %@ 开始，价格为 %@。如不想继续，请在此之前于 Apple 设置中取消。"
          }
        }
      }
    },
