    "Visits and routes log in the background. No check-ins." : {
      "comment" : "Carousel paywall.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُسجَّل الزيارات والمسارات في الخلفية. دون تسجيل وصول يدوي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভিজিট আর রুট ব্যাকগ্রাউন্ডে রেকর্ড হয়। চেক-ইন লাগে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visits and routes log in the background. No check-ins."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las visitas y rutas se registran en segundo plano. Sin check-ins."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visites et trajets sont enregistrés en arrière-plan. Sans check-in."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "विज़िट और रूट बैकग्राउंड में रिकॉर्ड होते हैं। चेक-इन की ज़रूरत नहीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪問先とルートをバックグラウンドで記録。チェックインは不要です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wizyty i trasy zapisują się w tle. Bez meldowania się."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visitas e rotas são registradas em segundo plano. Sem check-ins."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посещения и маршруты записываются в фоне. Без отметок вручную."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到访和路线在后台记录，无需签到。"
          }
        }
      }
    },
