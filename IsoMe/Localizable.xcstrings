    "Where you stop. Lightest on battery.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حيث تتوقف. الأخف على البطارية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where you stop. Lightest on battery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dónde paras. El que menos batería gasta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Là où vous vous arrêtez. Le plus économe en batterie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ち寄った場所を記録。バッテリー消費が最も少ない設定です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Onde você para. O mais leve para a bateria."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录你停留的地方。最省电。"
          }
        }
      }
    },
    "Your path while moving, quiet when still.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مسارك أثناء الحركة، وهدوء عند السكون."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your path while moving, quiet when still."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu recorrido en movimiento, en reposo cuando estás quieto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre parcours en mouvement, en veille à l’arrêt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動中は経路を記録し、止まっている間は休みます。"
          }
