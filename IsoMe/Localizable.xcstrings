    "%@ per week, automatically renewing until canceled." : {
      "comment" : "Weekly subscription with no trial. %@ is StoreKit's localized price; preserve weekly billing and automatic renewal until cancellation.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ أسبوعيًا، مع تجديد تلقائي حتى الإلغاء."
