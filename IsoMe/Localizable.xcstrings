          "stringUnit": {
            "state": "translated",
            "value": "无需账户，无需注册。"
          }
        }
      }
    },
    "No server keeps a copy of where you've been.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتفظ أي خادم بنسخة من الأماكن التي كنت فيها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No server keeps a copy of where you've been."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún servidor guarda una copia de dónde has estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur ne garde de copie des lieux où vous êtes allé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの行き先をサーバーが保存することはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum servidor guarda uma cópia de onde você esteve."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何服务器保存你的行踪副本。"
          }
        }
      }
    },
    "Export it anytime, in open formats. The code is open too.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صدّره متى شئت، بتنسيقات مفتوحة. والشيفرة مفتوحة أيضًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Export it anytime, in open formats. The code is open too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expórtalo cuando quieras, en formatos abiertos. El código también es abierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exportez à tout moment, dans des formats ouverts. Le code est ouvert, lui aussi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オープンな形式でいつでも書き出せます。コードもオープンです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
