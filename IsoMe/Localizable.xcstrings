    "Files are processed locally on this device. Import does not sign into Google, upload your history, or look up place names.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُعالَج الملفات محليًا على هذا الجهاز. لا يسجّل الاستيراد الدخول إلى Google، ولا يرفع سجلّك، ولا يبحث عن أسماء الأماكن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are processed locally on this device. Import does not sign into Google, upload your history, or look up place names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se procesan localmente en este dispositivo. La importación no inicia sesión en Google, no sube tu historial ni busca nombres de lugares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont traités localement sur cet appareil. L’importation ne se connecte pas à Google, n’envoie pas votre historique et ne recherche pas de noms de lieux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルはこのデバイス上で処理されます。インポート時にGoogleへのサインイン、履歴のアップロード、場所名の検索は行いません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos são processados localmente neste dispositivo. A importação não entra na conta Google, não envia seu histórico nem busca nomes de lugares."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件在本设备上本地处理。导入不会登录 Google、上传你的历史记录或查询地点名称。"
          }
        }
      }
    },
    "Fill missing days. Overlapping stays and recorded days are counted only once.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "املأ الأيام الناقصة. تُحتسب الإقامات المتداخلة والأيام المسجّلة مرة واحدة فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill missing days. Overlapping stays and recorded days are counted only once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena los días que faltan. Las estancias solapadas y los días registrados se cuentan una sola vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Complétez les jours manquants. Les séjours qui se chevauchent et les jours enregistrés ne sont comptés qu’une fois."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足りない日を補います。重なる滞在や記録済みの日は1回だけ数えます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzupełnij brakujące dni. Nakładające się pobyty i zarejestrowane dni są liczone tylko raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Preencha os dias que faltam. Estadias sobrepostas e dias registrados contam apenas uma vez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填补缺失的日期。重叠的停留和已记录的日期只计一次。"
          }
        }
      }
    },
