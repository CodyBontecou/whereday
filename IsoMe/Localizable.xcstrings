    "Hides date, layer, and fit controls.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يخفي عناصر التحكم في التاريخ والطبقة والملاءمة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ, স্তর এবং ফিট কন্ট্রোল লুকায়।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hides date, layer, and fit controls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta los controles de fecha, capa y ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masque les contrôles de date, de calque et d’ajustement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिनांक, परत और फ़िट नियंत्रण छुपाता है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付、レイヤー、およびフィットのコントロールを非表示にします。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrywa elementy sterujące datą, warstwą i dopasowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oculta controles de data, camada e ajuste."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывает элементы управления датой, слоем и подгонкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏日期、图层和适合控件。"
          }
        }
      }
    },
