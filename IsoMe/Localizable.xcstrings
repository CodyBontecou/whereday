    "Checking your Photos library for pictures taken during this outing.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التحقق من مكتبة الصور الخاصة بك بحثًا عن الصور التي تم التقاطها خلال هذه النزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ভ্রমণের সময় তোলা ছবিগুলির জন্য আপনার ফটো লাইব্রেরি পরীক্ষা করা হচ্ছে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your Photos library for pictures taken during this outing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisando su biblioteca de fotos para ver fotografías tomadas durante esta excursión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de votre bibliothèque de photos pour les photos prises lors de cette sortie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सैर के दौरान ली गई तस्वीरों के लिए अपनी फ़ोटो लाइब्रेरी की जाँच कर रहा हूँ।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この外出中に撮った写真がないか写真ライブラリを確認しています。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzam bibliotekę Zdjęć pod kątem zdjęć zrobionych podczas tej podróży."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando sua biblioteca de fotos em busca de fotos tiradas durante este passeio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверяю вашу библиотеку фотографий на предмет фотографий, сделанных во время этой прогулки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查您的照片库中是否有这次郊游期间拍摄的照片。"
          }
        }
      }
