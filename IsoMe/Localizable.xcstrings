    "Waiting points won't be sent. Your saved location history stays on this iPhone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن تُرسَل النقاط المنتظرة. يبقى سجل مواقعك المحفوظ على هذا الـ iPhone."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অপেক্ষমাণ পয়েন্ট পাঠানো হবে না। আপনার সংরক্ষিত লোকেশন হিস্ট্রি এই iPhone-এই থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting points won't be sent. Your saved location history stays on this iPhone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos en espera no se enviarán. Tu historial de ubicaciones guardado permanece en este iPhone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points en attente ne seront pas envoyés. Votre historique de localisation enregistré reste sur cet iPhone."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रतीक्षारत पॉइंट नहीं भेजे जाएँगे। आपका सहेजा गया स्थान इतिहास इसी iPhone पर रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "送信待ちのポイントは送信されません。保存済みの位置履歴はこのiPhoneに残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekujące punkty nie zostaną wysłane. Zapisana historia lokalizacji pozostanie na tym iPhonie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pontos pendentes não serão enviados. Seu histórico de localização salvo continua neste iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидающие точки не будут отправлены. Сохранённая история местоположений останется на этом iPhone."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待中的位置点将不会发送。你已保存的位置历史仍保留在此 iPhone 上。"
          }
        }
      }
    },
