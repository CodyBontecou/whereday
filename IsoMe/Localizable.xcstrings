    "Photos are read on this iPhone and never copied.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُقرأ الصور على هذا الـ iPhone ولا تُنسخ أبدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos are read on this iPhone and never copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fotos se leen en este iPhone y nunca se copian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les photos sont lues sur cet iPhone et jamais copiées."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はこのiPhone上で読み取られ、コピーされることはありません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fotos são lidas neste iPhone e nunca copiadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片只在此 iPhone 上读取，绝不复制。"
          }
        }
      }
    },
    "Use a saved place, enter coordinates, or your current location when permission allows.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم مكانًا محفوظًا، أو أدخل إحداثيات، أو موقعك الحالي عندما يسمح الإذن بذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a saved place, enter coordinates, or your current location when permission allows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un lugar guardado, introduce coordenadas o usa tu ubicación actual si tienes permiso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un lieu enregistré, des coordonnées ou votre position actuelle si l’autorisation le permet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した場所を使うか、座標を入力するか、許可があれば現在地を使ってください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um lugar salvo, digite coordenadas ou use sua localização atual quando houver permissão."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已保存的地点、输入坐标，或在权限允许时使用当前位置。"
          }
        }
      }
    },
    "Shortcuts warns about overlaps. Turn on Allow Overlap only when you want both records.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحذّر الاختصارات من التداخل. فعّل «السماح بالتداخل» فقط عندما تريد السجلين معًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts warns about overlaps. Turn on Allow Overlap only when you want both records."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Atajos avisa de los solapamientos. Activa Permitir solapamiento solo si quieres conservar ambos registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts signale les chevauchements. N’activez Autoriser le chevauchement que si vous voulez garder les deux."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは重複を警告します。両方の記録を残したい場合のみ「重複を許可」をオンにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Atalhos avisam sobre sobreposições. Ative Permitir sobreposição só quando quiser os dois registros."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷指令会提醒重叠。只有想保留两条记录时，才打开“允许重叠”。"
          }
        }
      }
    },
    "Links can open Check In, Add Past Visit, or a visit's details.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للروابط فتح «تسجيل الوصول» أو «إضافة زيارة سابقة» أو تفاصيل زيارة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Links can open Check In, Add Past Visit, or a visit's details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los enlaces pueden abrir Registrar llegada, Agregar visita anterior o los detalles de una visita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les liens peuvent ouvrir Enregistrer l’arrivée, Ajouter une visite passée ou les détails d’une visite."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リンクから「チェックイン」「過去の訪問を追加」、または訪問の詳細を開けます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Links podem abrir Check-in, Adicionar visita anterior ou os detalhes de uma visita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接可以打开签到、添加过去的到访或某次到访的详情。"
          }
        }
      }
    },
    "Watch sync and smoother maps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مزامنة الساعة وخرائط أسلس"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch sync and smoother maps"
          }
        },
        "es": {
