    "A calm, private timeline of where your day takes you — always on-device and in your control." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جدول زمني هادئ وخاص للمكان الذي يأخذك إليه يومك - دائمًا على الجهاز وتحت سيطرتك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার দিনটি আপনাকে কোথায় নিয়ে যায় তার একটি শান্ত, ব্যক্তিগত টাইমলাইন — সর্বদা ডিভাইসে এবং আপনার নিয়ন্ত্রণে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A calm, private timeline of where your day takes you — always on-device and in your control."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una línea de tiempo tranquila y privada de hacia dónde te lleva tu día, siempre en el dispositivo y bajo tu control."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
