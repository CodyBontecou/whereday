    "Add Whereday to supported watch faces for quick tracking status and today’s totals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف Whereday إلى وجوه الساعة المدعومة للتتبع السريع لحالة وإجماليات اليوم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "দ্রুত ট্র্যাকিং স্ট্যাটাস এবং আজকের মোটের জন্য সমর্থিত ঘড়ির মুখগুলিতে Whereday যোগ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add Whereday to supported watch faces for quick tracking status and today’s totals."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregue Whereday a las esferas de reloj compatibles para ver de un vistazo el estado del seguimiento y los totales de hoy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez Whereday aux cadrans de montre pris en charge pour un suivi rapide de l'état et des totaux du jour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "त्वरित ट्रैकिंग स्थिति और आज के कुल योग के लिए समर्थित वॉच फेस में Whereday जोड़ें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サポートされているウォッチフェイスにWheredayを追加すると、ステータスと今日の合計を簡単に追跡できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodaj Whereday do obsługiwanych tarcz zegarka, aby uzyskać szybki status śledzenia i dzisiejsze sumy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione Whereday aos mostradores de relógio compatíveis para rastrear rapidamente o status e os totais de hoje."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавьте Whereday в список поддерживаемых циферблатов, чтобы быстро отслеживать статус и текущие итоги."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将Whereday添加到支持的表盘，以快速跟踪状态和今天的总数。"
          }
        }
      }
    },
    "Add, edit, or import reusable places for future visit suggestions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أماكن قابلة لإعادة الاستخدام أو عدّلها أو استوردها لاقتراحات الزيارات المستقبلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভবিষ্যতের ভিজিট পরামর্শের জন্য পুনর্ব্যবহারযোগ্য জায়গা যোগ, সম্পাদনা বা আমদানি করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add, edit, or import reusable places for future visit suggestions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade, edita o importa lugares reutilizables para futuras sugerencias de visita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez, modifiez ou importez des lieux réutilisables pour les futures suggestions de visite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "भविष्य के विज़िट सुझावों के लिए दोबारा इस्तेमाल होने वाली जगहें जोड़ें, बदलें या आयात करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後の訪問の提案に使う場所を追加・編集・インポートできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj, edytuj lub importuj miejsca do wykorzystania w przyszłych sugestiach wizyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione, edite ou importe lugares reutilizáveis para futuras sugestões de visita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте, изменяйте или импортируйте места для будущих подсказок посещений."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加、编辑或导入可重复使用的地点，用于今后的到访建议。"
          }
        }
      }
    },
    "Add, edit, search, and delete reusable locations. Your past visits stay unchanged." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف المواقع القابلة لإعادة الاستخدام وعدّلها وابحث فيها واحذفها. تبقى زياراتك السابقة دون تغيير."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পুনর্ব্যবহারযোগ্য অবস্থান যোগ, সম্পাদনা, খোঁজ ও মুছে ফেলুন। আপনার আগের ভিজিট অপরিবর্তিত থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add, edit, search, and delete reusable locations. Your past visits stay unchanged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade, edita, busca y elimina ubicaciones reutilizables. Tus visitas pasadas no cambian."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez, modifiez, recherchez et supprimez des lieux réutilisables. Vos visites passées restent inchangées."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दोबारा इस्तेमाल होने वाले स्थान जोड़ें, बदलें, खोजें और हटाएँ। आपकी पिछली विज़िट नहीं बदलतीं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再利用する場所を追加・編集・検索・削除できます。過去の訪問は変わりません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dodawaj, edytuj, wyszukuj i usuwaj zapisane lokalizacje. Wcześniejsze wizyty pozostają bez zmian."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione, edite, busque e exclua locais reutilizáveis. Suas visitas anteriores não mudam."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Добавляйте, изменяйте, ищите и удаляйте сохранённые места. Прошлые посещения не изменятся."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "添加、编辑、搜索和删除可重复使用的地点。过去的到访保持不变。"
          }
        }
      }
    },
