    "That saved place no longer exists. Choose another place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هذا المكان المحفوظ موجودًا. اختر مكانًا آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "সংরক্ষিত জায়গাটি আর নেই। অন্য জায়গা বেছে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That saved place no longer exists. Choose another place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese lugar guardado ya no existe. Elige otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce lieu enregistré n’existe plus. Choisissez un autre lieu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वह सहेजी गई जगह अब मौजूद नहीं है। दूसरी जगह चुनें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その保存済みの場所は存在しません。別の場所を選んでください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To zapisane miejsce już nie istnieje. Wybierz inne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse lugar salvo não existe mais. Escolha outro lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сохранённое место больше не существует. Выберите другое."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该已存地点已不存在。请选择其他地点。"
          }
        }
      }
    },
    "That visit is already checked out or is not a manual visit." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل المغادرة من هذه الزيارة بالفعل أو أنها ليست زيارة يدوية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই পরিদর্শন থেকে ইতিমধ্যে চেক আউট হয়েছে অথবা এটি ম্যানুয়াল পরিদর্শন নয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "That visit is already checked out or is not a manual visit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya se registró la salida de esa visita o no es una visita manual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette visite est déjà terminée ou n’est pas une visite manuelle."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस विज़िट से पहले ही चेक आउट हो चुका है या यह मैन्युअल विज़िट नहीं है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この訪問はチェックアウト済みか、手動訪問ではありません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
