    "Double-tap to toggle this map layer. Touch and hold for an explanation." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر نقرًا مزدوجًا لتبديل طبقة الخريطة هذه. المس مع الاستمرار للحصول على شرح."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই মানচিত্র স্তর টগল করতে ডবল-ট্যাপ করুন৷ একটি ব্যাখ্যার জন্য স্পর্শ করুন এবং ধরে রাখুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Double-tap to toggle this map layer. Touch and hold for an explanation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para alternar esta capa de mapa. Toque y mantenga presionado para obtener una explicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez deux fois pour basculer cette couche de carte. Touchez et maintenez pour une explication."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस मानचित्र परत को टॉगल करने के लिए डबल-टैप करें। स्पष्टीकरण के लिए स्पर्श करके रखें."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダブルタップしてこのマップ レイヤーを切り替えます。ロングタッチすると説明が表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij dwukrotnie, aby przełączyć tę warstwę mapy. Dotknij i przytrzymaj, aby wyświetlić wyjaśnienie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
