    "Links can open Check In, Add Past Visit, or a visit's details." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للروابط فتح «تسجيل الوصول» أو «إضافة زيارة سابقة» أو تفاصيل زيارة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লিংক দিয়ে চেক ইন, অতীত ভিজিট যোগ, বা কোনো ভিজিটের বিবরণ খোলা যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links can open Check In, Add Past Visit, or a visit's details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces pueden abrir Registrar llegada, Agregar visita anterior o los detalles de una visita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens peuvent ouvrir Enregistrer l’arrivée, Ajouter une visite passée ou les détails d’une visite."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक से चेक इन, पिछली विज़िट जोड़ें, या किसी विज़िट का विवरण खुल सकता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクから「チェックイン」「過去の訪問を追加」、または訪問の詳細を開けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linki mogą otwierać Rozpocznij wizytę, Dodaj wcześniejszą wizytę lub szczegóły wizyty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links podem abrir Check-in, Adicionar visita anterior ou os detalhes de uma visita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылки могут открывать «Отметить прибытие», «Добавить прошлое посещение» или подробности посещения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接可以打开签到、添加过去的到访或某次到访的详情。"
          }
        }
      }
    },
    "Links can open Check In, Add Past Visit, or a visit's details. Review the place and times before saving." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن للروابط فتح «تسجيل الوصول» أو «إضافة زيارة سابقة» أو تفاصيل زيارة. راجع المكان والأوقات قبل الحفظ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "লিংক দিয়ে চেক ইন, অতীত ভিজিট যোগ, বা কোনো ভিজিটের বিবরণ খোলা যায়। সংরক্ষণের আগে জায়গা ও সময় দেখে নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links can open Check In, Add Past Visit, or a visit's details. Review the place and times before saving."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los enlaces pueden abrir Registrar llegada, Agregar visita anterior o los detalles de una visita. Revisa el lugar y las horas antes de guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les liens peuvent ouvrir Enregistrer l’arrivée, Ajouter une visite passée ou les détails d’une visite. Vérifiez le lieu et les heures avant d’enregistrer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "लिंक से चेक इन, पिछली विज़िट जोड़ें, या किसी विज़िट का विवरण खुल सकता है। सहेजने से पहले जगह और समय जाँच लें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リンクから「チェックイン」「過去の訪問を追加」、または訪問の詳細を開けます。保存する前に場所と時刻を確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Linki mogą otwierać Rozpocznij wizytę, Dodaj wcześniejszą wizytę lub szczegóły wizyty. Przed zapisaniem sprawdź miejsce i godziny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Links podem abrir Check-in, Adicionar visita anterior ou os detalhes de uma visita. Revise o lugar e os horários antes de salvar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ссылки могут открывать «Отметить прибытие», «Добавить прошлое посещение» или подробности посещения. Проверьте место и время перед сохранением."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "链接可以打开签到、添加过去的到访或某次到访的详情。保存前请检查地点和时间。"
          }
        }
      }
    },
