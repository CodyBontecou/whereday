    "This file contains too many records. Import files with up to 250,000 visits and points." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتوي هذا الملف على سجلات كثيرة جدًا. استورد ملفات تحتوي على 250,000 زيارة ونقطة كحد أقصى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
