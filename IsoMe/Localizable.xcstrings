    "Unable to access the export folder. Please reselect it.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على الوصول إلى مجلد التصدير. يرجى إعادة تحديده."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক্সপোর্ট ফোল্ডার অ্যাক্সেস করতে অক্ষম. এটি পুনরায় নির্বাচন করুন."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to access the export folder. Please reselect it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede acceder a la carpeta de exportación. Vuelva a seleccionarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'accéder au dossier d'exportation. Veuillez le resélectionner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "निर्यात फ़ोल्डर तक पहुँचने में असमर्थ. कृपया इसे पुनः चुनें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エクスポートフォルダーにアクセスできません。再選択してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można uzyskać dostępu do folderu eksportu. Wybierz ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível acessar a pasta de exportação. Selecione-o novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно получить доступ к папке экспорта. Пожалуйста, выберите его повторно."
