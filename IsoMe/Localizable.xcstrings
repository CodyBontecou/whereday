          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota paradas y registra puntos de ruta aproximadamente cada 100 m. Continúa hasta hacer una pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note les arrêts et enregistre les points d'itinéraire tous les 100 m environ. Continue jusqu'à ce que vous fassiez une pause."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक 100 मीटर पर स्टॉप को नोट करता है और मार्ग बिंदुओं को रिकॉर्ड करता है। जब तक आप रुकते नहीं तब तक जारी रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes は約 100 メートルごとに停止し、ルート ポイントを記録します。一時停止するまで継続します。"
          }
        },
        "pl" : {
          "stringUnit" : {
