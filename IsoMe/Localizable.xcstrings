    "Latitude must be a number from -90 to 90.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون خط العرض رقمًا بين -90 و90."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Latitude must be a number from -90 to 90."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitud debe ser un número entre -90 y 90."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La latitude doit être un nombre compris entre -90 et 90."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "緯度は-90〜90の数値で入力してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szerokość geograficzna musi być liczbą od -90 do 90."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A latitude deve ser um número de -90 a 90."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纬度必须是 -90 到 90 之间的数字。"
          }
        }
      }
    },
    "Let Whereday automatically show iPhone photos on your map and outings. Photos stay in your Photos library.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح لـ Whereday بعرض صور iPhone تلقائيًا على خريطتك ونزهاتك. تبقى الصور في مكتبة الصور الخاصة بك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday স্বয়ংক্রিয়ভাবে আপনার মানচিত্র এবং আউটিং-এ iPhone ফটোগুলি দেখাতে দিন। ফটোগুলি আপনার ফটো লাইব্রেরিতে থাকে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let Whereday automatically show iPhone photos on your map and outings. Photos stay in your Photos library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deje que Whereday muestre automáticamente fotos iPhone en su mapa y salidas. Las fotos permanecen en tu biblioteca de fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez Whereday afficher automatiquement les photos iPhone sur votre carte et vos sorties. Les photos restent dans votre bibliothèque de photos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday स्वचालित रूप से आपके मानचित्र और सैर पर iPhone फ़ोटो दिखाने दें। तस्वीरें आपकी फ़ोटो लाइब्रेरी में रहती हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Whereday使用すると、 iPhone写真が地図や外出先上に自動的に表示されます。写真は写真ライブラリに残ります。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozwól Whereday automatycznie pokazywać zdjęcia z iPhone’a na mapie i w podróżach. Zdjęcia pozostają w bibliotece Zdjęć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe Whereday mostrar automaticamente as fotos iPhone no seu mapa e passeios. As fotos permanecem na sua biblioteca de fotos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите Whereday автоматически показывать фотографии iPhone на вашей карте и во время прогулок. Фотографии остаются в вашей библиотеке фотографий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让Whereday自动在您的地图和郊游中显示iPhone照片。照片保留在您的照片库中。"
          }
        }
      }
    },
    "Lifetime Export active": {
      "localizations": {
        "ar": {
          "stringUnit": {
