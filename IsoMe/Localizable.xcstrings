            "state": "translated",
            "value": "इंडिविजुअल लाइफ़टाइम से केवल कीमत का अंतर चुकाएँ"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "個人向け買い切り版との差額のみを支払い"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
