          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の一章を、\nここから。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas na Twój\nkolejny rozdział."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
