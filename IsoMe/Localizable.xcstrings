      }
    },
    "Wait for the outing path to be matched to roads." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتظر حتى تتم مطابقة مسار النزهة مع الطرق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আউটিং পাথ রাস্তার সাথে মিলে যাওয়ার জন্য অপেক্ষা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wait for the outing path to be matched to roads."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Espere a que la ruta de la salida se ajuste a las calles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attendez que le parcours de sortie soit adapté aux routes."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सैर के रास्ते के सड़कों से मेल खाने की प्रतीक्षा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出の経路が道路に合わせられるまでお待ちください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poczekaj, aż trasa podróży zostanie dopasowana do dróg."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguarde até que o caminho do passeio corresponda às estradas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подождите, пока путь прогулки будет привязан к дорогам."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "等待出行路径与道路匹配。"
          }
        }
      }
    },
    "Waiting before the next country lookup… You can stop and continue later." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في انتظار البحث التالي عن الدولة… يمكنك الإيقاف والمتابعة لاحقًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "পরের দেশ খোঁজার আগে অপেক্ষা করা হচ্ছে… আপনি থামিয়ে পরে চালিয়ে যেতে পারেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Waiting before the next country lookup… You can stop and continue later."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esperando antes de la siguiente búsqueda de país… Puedes detenerla y continuar más tarde."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attente avant la prochaine recherche de pays… Vous pouvez arrêter et reprendre plus tard."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अगली देश जानकारी से पहले इंतज़ार… आप रोककर बाद में जारी रख सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "次の国の特定まで待機中… 停止して後で続けることもできます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oczekiwanie przed kolejnym ustaleniem kraju… Możesz zatrzymać analizę i kontynuować później."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aguardando antes da próxima busca de país… Você pode parar e continuar depois."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ожидание перед следующим определением страны… Можно остановить и продолжить позже."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "正在等待下一次国家查询… 你可以停止，稍后再继续。"
          }
        }
      }
    },
