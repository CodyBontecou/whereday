    "Check the destination, file names, counts, warnings, and contents before writing or sharing your location history.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من الوجهة وأسماء الملفات والأعداد والتحذيرات والمحتويات قبل كتابة سجل المواقع الخاص بك أو مشاركته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থানের ইতিহাস লেখা বা শেয়ার করার আগে গন্তব্য, ফাইলের নাম, গণনা, সতর্কতা এবং বিষয়বস্তু পরীক্ষা করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the destination, file names, counts, warnings, and contents before writing or sharing your location history."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique el destino, los nombres de los archivos, los recuentos, las advertencias y el contenido antes de escribir o compartir su historial de ubicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la destination, les noms de fichiers, les décomptes, les avertissements et le contenu avant d'écrire ou de partager votre historique de localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना स्थान इतिहास लिखने या साझा करने से पहले गंतव्य, फ़ाइल नाम, संख्या, चेतावनियाँ और सामग्री की जाँच करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ロケーション履歴を書き込んだり共有したりする前に、送信先、ファイル名、数、警告、内容を確認してください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed zapisaniem lub udostępnieniem historii lokalizacji sprawdź miejsce docelowe, nazwy plików, liczbę, ostrzeżenia i zawartość."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique o destino, os nomes dos arquivos, as contagens, os avisos e o conteúdo antes de escrever ou compartilhar seu histórico de localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте место назначения, имена файлов, количество, предупреждения и содержимое, прежде чем писать или делиться своей историей местоположений."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在写入或共享您的位置历史记录之前，请检查目的地、文件名、计数、警告和内容。"
          }
        }
      }
    },
