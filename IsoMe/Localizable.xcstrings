    "Use {title} or {name} in export paths, and Whereday keeps one-file-per-outing exports distinct automatically." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم {title} أو {name} في مسارات التصدير، وسيحافظ Whereday على تمييز عمليات التصدير لكل ملف واحد تلقائيًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এক্সপোর্ট পাথগুলিতে {title} বা {name} ব্যবহার করুন, এবং Whereday এক-ফাইল-প্রতি-আউটিং এক্সপোর্টগুলিকে স্বয়ংক্রিয়ভাবে আলাদা করে রাখে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use {title} or {name} in export paths, and Whereday keeps one-file-per-outing exports distinct automatically."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice {title} o {name} en las rutas de exportación e Whereday mantiene diferenciadas automáticamente las exportaciones de un archivo por salida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez {title} ou {name} dans les chemins d'exportation, et Whereday conserve automatiquement les exportations d'un fichier par sortie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "निर्यात पथों में {title} या {name} उपयोग करें, और Whereday एक-फ़ाइल-प्रति-आउटिंग निर्यात को स्वचालित रूप से अलग रखता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エクスポート パスで{title}または{name}を使用すると、Wheredayは外出ごとに 1 つのファイルのエクスポートを自動的に区別します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj {title} lub {name} w ścieżkach eksportu, a Whereday automatycznie rozróżni pliki przy eksporcie jednego pliku na podróż."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use {title} ou {name} nos caminhos de exportação e o Whereday mantém distintas automaticamente as exportações de um arquivo por passeio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте {title} или {name} в путях экспорта, и Whereday автоматически сделает имена файлов разными при экспорте по одному файлу на прогулку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在导出路径中使用{title}或{name} ， Whereday会自动保持每次导出一个文件的导出不同。"
          }
        }
      }
    },
    "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم / للمجلدات. الرموز: %@ . {title} / {name} استخدم عنوان النزهة عندما يكون متاحًا، وإلا نوع البيانات. تتم إضافة ملحق التنسيق إذا تم حذفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফোল্ডারের জন্য / ব্যবহার করুন। টোকেন: %@ । {title} / {name} উপলভ্য হলে আউটিং শিরোনাম ব্যবহার করুন, অন্যথায় ডেটা টাইপ। বাদ দিলে ফরম্যাট এক্সটেনশন যোগ করা হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use / for folders. Tokens: %@. {title}/{name} use the outing title when available, otherwise the data type. The format extension is added if omitted."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilice / para carpetas. Tokens: %@. {title}/{name} usan el título de la salida cuando está disponible; de lo contrario, el tipo de datos. La extensión de formato se agrega si se omite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez / pour les dossiers. Jetons : %@ . {title} / {name} utilise le titre de la sortie lorsqu'il est disponible, sinon le type de données. L'extension de format est ajoutée si elle est omise."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोल्डरों के लिए / का उपयोग करें. टोकन: %@ . {title} / {name} उपलब्ध होने पर आउटिंग शीर्षक का उपयोग करें, अन्यथा डेटा प्रकार का। यदि छोड़ा गया है तो प्रारूप एक्सटेंशन जोड़ा जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダーには / を使用します。トークン: %@ 。 {title} / {name}利用可能な場合は外出のタイトルを使用し、それ以外の場合はデータ型を使用します。省略した場合はフォーマット拡張子が付加されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj / dla folderów. Tokeny: %@. {title} / {name} używają tytułu podróży, jeśli jest dostępny, a w przeciwnym razie typu danych. W przypadku pominięcia dodawane jest rozszerzenie formatu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use / para pastas. Tokens: %@. {title}/{name} usam o título do passeio quando disponível; caso contrário, o tipo de dados. A extensão do formato é adicionada se for omitida."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте / для папок. Токены: %@. {title}/{name} подставляют название прогулки, если оно есть, иначе — тип данных. Расширение формата добавляется, если оно не указано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 / 表示文件夹。占位符：%@。{title}/{name} 在有出行标题时使用该标题，否则使用数据类型。如果省略格式扩展名，将自动添加。"
          }
        }
      }
    },
    "Use a saved place, enter coordinates, or request your current location when permission allows." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم مكانًا محفوظًا، أو أدخل إحداثيات، أو اطلب موقعك الحالي عندما يسمح الإذن بذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সংরক্ষিত জায়গা ব্যবহার করুন, স্থানাঙ্ক লিখুন, বা অনুমতি থাকলে আপনার বর্তমান অবস্থান নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a saved place, enter coordinates, or request your current location when permission allows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un lugar guardado, introduce coordenadas o solicita tu ubicación actual si tienes permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un lieu enregistré, saisissez des coordonnées ou demandez votre position actuelle si l’autorisation le permet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई जगह का उपयोग करें, निर्देशांक दर्ज करें, या अनुमति हो तो अपना वर्तमान स्थान माँगें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所を使うか、座標を入力するか、許可があれば現在地を取得してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj zapisanego miejsca, wpisz współrzędne lub poproś o bieżącą lokalizację, jeśli pozwalają na to uprawnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use um lugar salvo, digite coordenadas ou solicite sua localização atual quando houver permissão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите сохранённое место, введите координаты или запросите текущее местоположение, если есть разрешение."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用已保存的地点、输入坐标，或在权限允许时请求当前位置。"
          }
        }
      }
    },
    "Use a saved place, enter coordinates, or your current location when permission allows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم مكانًا محفوظًا، أو أدخل إحداثيات، أو موقعك الحالي عندما يسمح الإذن بذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি সংরক্ষিত জায়গা ব্যবহার করুন, স্থানাঙ্ক লিখুন, বা অনুমতি থাকলে আপনার বর্তমান অবস্থান নিন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a saved place, enter coordinates, or your current location when permission allows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un lugar guardado, introduce coordenadas o usa tu ubicación actual si tienes permiso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un lieu enregistré, des coordonnées ou votre position actuelle si l’autorisation le permet."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सहेजी गई जगह का उपयोग करें, निर्देशांक दर्ज करें, या अनुमति हो तो अपना वर्तमान स्थान।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "保存した場所を使うか、座標を入力するか、許可があれば現在地を使ってください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj zapisanego miejsca, wpisz współrzędne lub użyj bieżącej lokalizacji, jeśli pozwalają na to uprawnienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
