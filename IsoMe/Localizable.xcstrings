    "See visits, distance, location points, current location, and remaining session time right on the watch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شاهد الزيارات والمسافة ونقاط الموقع والموقع الحالي ووقت الجلسة المتبقي مباشرة على الساعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরাসরি ঘড়িতে ভিজিট, দূরত্ব, অবস্থান পয়েন্ট, বর্তমান অবস্থান এবং অবশিষ্ট সেশনের সময় দেখুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See visits, distance, location points, current location, and remaining session time right on the watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vea visitas, distancia, puntos de ubicación, ubicación actual y tiempo restante de la sesión directamente en el reloj."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les visites, la distance, les points de localisation, la position actuelle et la durée restante de la session directement sur la montre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीधे घड़ी पर विज़िट, दूरी, स्थान बिंदु, वर्तमान स्थान और शेष सत्र का समय देखें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問数、距離、ロケーションポイント、現在位置、セッションの残り時間を時計上で確認できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz wizyty, dystans, punkty lokalizacji, bieżącą lokalizację i pozostały czas sesji bezpośrednio na zegarku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Veja visitas, distância, pontos de localização, localização atual e tempo restante da sessão diretamente no relógio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте посещения, расстояние, точки местоположения, текущее местоположение и оставшееся время сеанса прямо на часах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接在手表上查看访问次数、距离、位置点、当前位置和剩余会话时间。"
          }
        }
      }
    },
    "Select a date range with at least two path points.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد نطاقًا زمنيًا يشتمل على نقطتي مسار على الأقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কমপক্ষে দুটি পাথ পয়েন্ট সহ একটি তারিখ ব্যাপ্তি নির্বাচন করুন৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a date range with at least two path points."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione un rango de fechas con al menos dos puntos de ruta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une plage de dates avec au moins deux points de chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम दो पथ बिंदुओं वाली दिनांक सीमा चुनें."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "少なくとも 2 つのパス ポイントがある日付範囲を選択します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zakres dat zawierający co najmniej dwa punkty ścieżki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um período com pelo menos dois pontos de caminho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите диапазон дат, в котором есть хотя бы две точки пути."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择至少包含两个路径点的日期范围。"
          }
        }
      }
    },
    "Select one or many formats. OwnTracks and Overland only carry GPS fixes; other selected formats use the selected data type.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد تنسيقًا واحدًا أو أكثر. يحمل OwnTracks و Overland فقط إصلاحات GPS )؛ تستخدم التنسيقات الأخرى المحددة نوع البيانات المحدد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক বা একাধিক ফরম্যাট নির্বাচন করুন। OwnTracks এবং Overland শুধুমাত্র GPS ফিক্স বহন করে; অন্যান্য নির্বাচিত বিন্যাস নির্বাচিত ডেটা প্রকার ব্যবহার করে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one or many formats. OwnTracks and Overland only carry GPS fixes; other selected formats use the selected data type."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione uno o varios formatos. OwnTracks y Overland solo ofrecen conexiones GPS ; otros formatos seleccionados utilizan el tipo de datos seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ou plusieurs formats. OwnTracks et Overland ne proposent que des repères GPS ; les autres formats sélectionnés utilisent le type de données sélectionné."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अनेक प्रारूप चुनें. OwnTracks और Overland केवल GPS सुधार होते हैं; अन्य चयनित प्रारूप चयनित डेटा प्रकार का उपयोग करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つまたは複数の形式を選択します。 OwnTracksとOverland GPS修正のみを提供します。選択した他の形式では、選択したデータ型が使用されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jeden lub więcej formatów. OwnTracks i Overland zawierają tylko pozycje GPS; pozostałe formaty używają wybranego typu danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um ou vários formatos. OwnTracks e Overland carregam apenas correções GPS ; outros formatos selecionados usam o tipo de dados selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один или несколько форматов. OwnTracks и Overland содержат только координаты GPS ; другие выбранные форматы используют выбранный тип данных."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种或多种格式。 OwnTracks和Overland仅提供GPS定位；其他选定的格式使用选定的数据类型。"
          }
        }
      }
    },
    "Select one or many formats. OwnTracks and Overland outing exports contain the outing route's GPS fixes; visit rows and outing notes are not represented.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حدد تنسيقًا واحدًا أو أكثر. تحتوي صادرات OwnTracks وOwnTracks على إصلاحات نظام تحديد المواقع Overland GPS لمسار النزهة؛ لا يتم تمثيل صفوف الزيارة وملاحظات النزهة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এক বা একাধিক ফরম্যাট নির্বাচন করুন। OwnTracks এবং Overland আউটিং এক্সপোর্ট আউটিং রুট এর GPS ফিক্স ধারণ করে; ভিজিট সারি এবং আউটিং নোট প্রতিনিধিত্ব করা হয় না."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select one or many formats. OwnTracks and Overland outing exports contain the outing route's GPS fixes; visit rows and outing notes are not represented."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccione uno o varios formatos. Las exportaciones de salidas OwnTracks y Overland contienen las posiciones GPS de la ruta de salida; Las filas de visitas y las notas de salidas no están representadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un ou plusieurs formats. Les exportations de sorties OwnTracks et Overland contiennent les coordonnées GPS de l'itinéraire de sortie ; les lignes de visite et les notes de sortie ne sont pas représentées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक या अनेक प्रारूप चुनें. OwnTracks और Overland आउटिंग निर्यात में आउटिंग रूट के GPS फिक्स शामिल हैं; विज़िट पंक्तियाँ और आउटिंग नोट्स प्रस्तुत नहीं किए गए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つまたは複数の形式を選択します。 OwnTracksおよびOverland外出エクスポートには、外出ルートのGPS修正が含まれています。訪問行や外出メモは表示されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz jeden lub więcej formatów. Eksporty podróży OwnTracks i Overland zawierają pozycje GPS z trasy, bez wizyt i notatek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um ou vários formatos. As exportações de passeios OwnTracks e Overland contêm as correções GPS da rota de passeio; as linhas de visita e as notas de saída não são representadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите один или несколько форматов. Экспорт маршрутов OwnTracks и Overland содержит координаты GPS маршрута; строки посещений и заметки о поездках не представлены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一种或多种格式。 OwnTracks和Overland郊游导出包含郊游路线的GPS修正；访问行和郊游笔记没有体现。"
          }
        }
      }
    },
