        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "উদ্ধৃতিচিহ্ন পুরো ফিল্ডকে ঘিরে থাকতে হবে; ভেতরের উদ্ধৃতিচিহ্ন দুটি উদ্ধৃতিচিহ্ন দিয়ে এস্কেপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quotation marks must enclose the whole field; escape an inner quote with two quotation marks."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las comillas deben abarcar todo el campo; para incluir una comilla interna, escríbela dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les guillemets doivent entourer tout le champ ; échappez un guillemet interne en le doublant."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "उद्धरण चिह्नों में पूरा फ़ील्ड होना चाहिए; अंदर के उद्धरण चिह्न को दो उद्धरण चिह्नों से एस्केप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引用符はフィールド全体を囲む必要があります。フィールド内の引用符は2つ重ねてエスケープしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cudzysłowy muszą obejmować całe pole; cudzysłów wewnątrz pola zapisz podwójnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As aspas devem envolver o campo inteiro; para usar aspas dentro dele, escreva duas aspas seguidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кавычки должны охватывать всё поле; кавычку внутри поля экранируйте двумя кавычками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引号必须包住整个字段；字段内的引号请用两个引号转义。"
          }
        }
      }
    },
