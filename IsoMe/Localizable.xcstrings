    "One-time payment, no subscription": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدفع لمرة واحدة، بدون اشتراك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এককালীন অর্থপ্রদান, কোন সাবস্ক্রিপশন নেই"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One-time payment, no subscription"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pago único, sin suscripción"
          }
        },
        "fr": {
