    "Dates that already have records won't be counted twice. You'll see these days outlined in the Atlas.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التواريخ التي لها سجلات بالفعل لن تُحتسب مرتين. سترى هذه الأيام محدّدة بإطار في الأطلس."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates that already have records won't be counted twice. You'll see these days outlined in the Atlas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas que ya tienen registros no se contarán dos veces. Verás estos días resaltados en el Atlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates qui ont déjà des données ne seront pas comptées deux fois. Ces jours apparaîtront encadrés dans l’Atlas."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに記録がある日付は二重に数えません。これらの日はアトラスで枠線付きで表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Datas que já têm registros não serão contadas duas vezes. Esses dias aparecerão contornados no Atlas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有记录的日期不会重复计算。这些日期会在地图集中以轮廓标出。"
          }
        }
      }
    },
    "Dates that already have records won't be counted twice. You'll see this day outlined in the Atlas.": {
