      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "٧ أيام مجانًا، ثم %@ أسبوعيًا، مع تجديد تلقائي حتى الإلغاء."}},
        "bn": {"stringUnit": {"state": "translated", "value": "৭ দিন বিনামূল্যে, তারপর প্রতি সপ্তাহে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"}},
