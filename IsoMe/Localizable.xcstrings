    "Photos you take while Whereday records are matched to your stops by time and place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطابَق الصور التي تلتقطها أثناء تسجيل Whereday مع توقفاتك حسب الوقت والمكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday রেকর্ড করার সময় তোলা ছবি সময় ও জায়গা মিলিয়ে আপনার থামাগুলোর সঙ্গে যুক্ত হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Photos you take while Whereday records are matched to your stops by time and place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las fotos que tomas mientras Whereday graba se asocian a tus paradas por hora y lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les photos prises pendant l’enregistrement de Whereday sont associées à vos arrêts par heure et lieu."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday के रिकॉर्ड करते समय ली गई फ़ोटो समय और जगह के आधार पर आपके पड़ावों से मिलाई जाती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wheredayの記録中に撮った写真は、時間と場所で立ち寄りと照合されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zdjęcia zrobione podczas rejestrowania przez Whereday są dopasowywane do Twoich postojów po czasie i miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As fotos que você tira enquanto o Whereday grava são associadas às suas paradas por hora e lugar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фото, снятые во время записи Whereday, сопоставляются с вашими остановками по времени и месту."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Whereday 记录期间拍摄的照片会按时间和地点匹配到你的停留。"
          }
        }
      }
    },
