        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি %@ এর জন্য ট্র্যাক করছেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You've been tracking for %@."
          }
