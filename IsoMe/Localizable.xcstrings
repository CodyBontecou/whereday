    "Draws your GPS trail for the selected date range. Turn it off to focus on visits, pins, or the live session." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم مسار GPS الخاص بك للنطاق الزمني المحدد. قم بإيقاف تشغيله للتركيز على الزيارات أو الدبابيس أو الجلسة المباشرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নির্বাচিত তারিখ ব্যাপ্তির জন্য আপনার GPS ট্রেল আঁকে। ভিজিট, পিন বা লাইভ সেশনে ফোকাস করতে এটি বন্ধ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws your GPS trail for the selected date range. Turn it off to focus on visits, pins, or the live session."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja su ruta GPS para el rango de fechas seleccionado. Desactívalo para centrarte en las visitas, los pines o la sesión en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dessine votre trace GPS pour la plage de dates sélectionnée. Désactivez-le pour vous concentrer sur les visites, les épingles ou la session en direct."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चयनित दिनांक सीमा के लिए आपका GPS ट्रेल खींचता है। विज़िट, पिन या लाइव सत्र पर ध्यान केंद्रित करने के लिए इसे बंद करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した日付範囲のGPS軌跡を描画します。訪問、ピン、またはライブセッションに集中するには、これをオフにします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje ślad GPS dla wybranego zakresu dat. Wyłącz tę opcję, aby skupić się na wizytach, pinach lub sesji na żywo."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha sua trilha GPS para o intervalo de datas selecionado. Desligue-o para se concentrar nas visitas, nos pins ou na sessão ao vivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует GPS след для выбранного диапазона дат. Выключите его, чтобы сосредоточиться на посещениях, закреплениях или сеансе в реальном времени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绘制所选日期范围内的GPS轨迹。将其关闭以专注于访问、图钉或实时会话。"
          }
        }
      }
    },
    "Draws your path when you're out, sleeps when you're still." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسم مسارك عندما تخرج، ويهدأ عندما تسكن."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাইরে থাকলে আপনার পথ আঁকে, স্থির থাকলে ঘুমিয়ে থাকে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws your path when you're out, sleeps when you're still."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dibuja tu recorrido cuando sales y descansa cuando estás quieto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trace votre parcours quand vous sortez, se met en veille quand vous ne bougez pas."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाहर होने पर आपका रास्ता बनाता है, रुकने पर सो जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出中は経路を描き、止まっている間は休みます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rysuje Twoją trasę, gdy jesteś w drodze, i usypia, gdy stoisz w miejscu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desenha seu caminho quando você sai e descansa quando você está parado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рисует ваш путь, когда вы в дороге, и засыпает, когда вы на месте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外出时绘制路径，静止时休眠。"
          }
        }
      }
    },
