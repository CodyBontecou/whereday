    "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض معاينات الصور المصغرة داخل علامات الصور. قم بإيقاف تشغيل هذا لاستخدام دبابيس الكاميرا المدمجة مع الحفاظ على الصور متاحة على الخريطة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ফটো মার্কারগুলির ভিতরে থাম্বনেইল পূর্বরূপ দেখায়। ম্যাপে ফটো উপলব্ধ রাখার সময় কমপ্যাক্ট ক্যামেরা পিন ব্যবহার করতে এটি বন্ধ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra vistas previas en miniatura dentro de los marcadores de fotografías. Desactívelo para usar pines de cámara compactos y mantener las fotos disponibles en el mapa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche des aperçus miniatures à l’intérieur des marqueurs de photo. Désactivez cette option pour utiliser les repères d'appareil photo compact tout en conservant les photos disponibles sur la carte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फोटो मार्कर के अंदर थंबनेल पूर्वावलोकन दिखाता है। फ़ोटो को मानचित्र पर उपलब्ध रखते हुए कॉम्पैक्ट कैमरा पिन का उपयोग करने के लिए इसे बंद करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真マーカー内にサムネイル プレビューを表示します。これをオフにすると、マップ上で写真を利用可能なままにしてコンパクト カメラ ピンを使用できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje miniatury wewnątrz znaczników zdjęć. Wyłącz tę opcję, aby używać małych pinezek z ikoną aparatu i zachować dostęp do zdjęć na mapie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra visualizações em miniatura dentro de marcadores de fotos. Desative esta opção para usar pinos de câmera compactos enquanto mantém as fotos disponíveis no mapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает миниатюры внутри маркеров фотографий. Отключите эту функцию, чтобы использовать компактные закрепления камеры, сохраняя при этом фотографии доступными на карте."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在照片标记内显示缩略图预览。关闭此功能可使用紧凑型相机图钉，同时保持照片在地图上可用。"
          }
        }
      }
    },
    "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map. Photo dots override this setting without changing it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض معاينات مصغّرة داخل علامات الصور. أوقفه لاستخدام دبابيس كاميرا مدمجة مع إبقاء الصور متاحة على الخريطة. يتجاوز خيار «نقاط الصور» هذا الإعداد دون تغييره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ছবির চিহ্নের ভেতরে থাম্বনেইল প্রিভিউ দেখায়। এটি বন্ধ করলে মানচিত্রে ছবি থাকবে, তবে ছোট ক্যামেরা পিন দেখাবে। “ছবির বিন্দু” এই সেটিং না বদলেই এর ওপর প্রাধান্য পায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shows thumbnail previews inside photo markers. Turn this off to use compact camera pins while keeping photos available on the map. Photo dots override this setting without changing it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muestra miniaturas dentro de los marcadores de fotos. Desactívalo para usar pines de cámara compactos sin dejar de ver las fotos en el mapa. Los puntos de fotos anulan este ajuste sin cambiarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affiche des miniatures dans les repères photo. Désactivez cette option pour utiliser des repères appareil photo compacts tout en gardant les photos sur la carte. Les points photo remplacent ce réglage sans le modifier."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फ़ोटो मार्करों के अंदर थंबनेल पूर्वावलोकन दिखाता है। इसे बंद करने पर छोटे कैमरा पिन दिखेंगे, फ़ोटो मानचित्र पर फिर भी उपलब्ध रहेंगी। फ़ोटो बिंदु इस सेटिंग को बदले बिना उसकी जगह लागू होते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真マーカー内にサムネイルを表示します。オフにすると、地図上で写真を利用できるまま、コンパクトなカメラピンで表示します。「写真のドット」はこの設定を変えずに優先されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokazuje miniatury wewnątrz znaczników zdjęć. Wyłącz tę opcję, aby używać małych pinezek z ikoną aparatu i zachować dostęp do zdjęć na mapie. Punkty zdjęć mają pierwszeństwo przed tą opcją, ale nie zmieniają jej ustawienia."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra miniaturas dentro dos marcadores de fotos. Desative para usar alfinetes de câmera compactos, mantendo as fotos disponíveis no mapa. Pontos de fotos substituem este ajuste sem alterá-lo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Показывает миниатюры внутри меток фото. Выключите, чтобы использовать компактные значки камеры; фото останутся доступны на карте. Режим «Фото точками» переопределяет этот параметр, не меняя его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在照片标记内显示缩略图预览。关闭后将使用紧凑的相机图钉，照片仍可在地图上查看。“照片圆点”会覆盖此设置，但不会更改它。"
          }
        }
      }
    },
