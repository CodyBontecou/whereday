    "Fill missing days. Overlapping stays and recorded days are counted only once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "املأ الأيام الناقصة. تُحتسب الإقامات المتداخلة والأيام المسجّلة مرة واحدة فقط."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাদ পড়া দিন পূরণ করুন। ওভারল্যাপ করা অবস্থানকাল ও রেকর্ড করা দিন একবারই গণনা হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fill missing days. Overlapping stays and recorded days are counted only once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rellena los días que faltan. Las estancias solapadas y los días registrados se cuentan una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Complétez les jours manquants. Les séjours qui se chevauchent et les jours enregistrés ne sont comptés qu’une fois."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "छूटे दिन भरें। ओवरलैप होते ठहराव और रिकॉर्ड किए गए दिन सिर्फ़ एक बार गिने जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "足りない日を補います。重なる滞在や記録済みの日は1回だけ数えます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uzupełnij brakujące dni. Nakładające się pobyty i zarejestrowane dni są liczone tylko raz."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preencha os dias que faltam. Estadias sobrepostas e dias registrados contam apenas uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполняйте пропущенные дни. Пересекающиеся пребывания и записанные дни учитываются только один раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填补缺失的日期。重叠的停留和已记录的日期只计一次。"
          }
        }
      }
    },
