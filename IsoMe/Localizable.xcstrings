    "Open the photo you intended, even when nearby dots or route markers overlap." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح الصورة التي تقصدها، حتى عند تداخل النقاط القريبة أو علامات المسار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কাছাকাছি বিন্দু বা রুট চিহ্ন ওভারল্যাপ করলেও আপনি যে ছবিটি চান সেটিই খুলুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the photo you intended, even when nearby dots or route markers overlap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre la foto que buscas, aunque haya puntos o marcadores de ruta cercanos superpuestos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez la photo voulue, même quand des points ou des repères de trajet se chevauchent à proximité."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वही फ़ोटो खोलें जो आप चाहते थे, भले ही पास के बिंदु या रूट मार्कर ओवरलैप हों।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのドットやルートマーカーが重なっていても、目的の写真を開けます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otwieraj wybrane zdjęcie także wtedy, gdy pobliskie punkty lub znaczniki trasy nakładają się na siebie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a foto que você queria, mesmo quando pontos próximos ou marcadores do trajeto se sobrepõem."
          }
        },
        "ru" : {
