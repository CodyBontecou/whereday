    "Set a default folder to save exports without the share sheet." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بتعيين مجلد افتراضي لحفظ ملفات التصدير بدون ورقة المشاركة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শেয়ার শীট ছাড়া রপ্তানি সংরক্ষণ করতে একটি ডিফল্ট ফোল্ডার সেট করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a default folder to save exports without the share sheet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establezca una carpeta predeterminada para guardar las exportaciones sin la hoja para compartir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un dossier par défaut pour enregistrer les exportations sans la feuille de partage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शेयर शीट के बिना निर्यात सहेजने के लिए एक डिफ़ॉल्ट फ़ोल्डर सेट करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有シートを使用せずにエクスポートを保存するデフォルトのフォルダーを設定します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw domyślny folder do zapisywania eksportów bez arkusza udostępniania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina uma pasta padrão para salvar as exportações sem o menu de compartilhamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задайте папку по умолчанию, чтобы сохранять экспорт без меню «Поделиться»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置默认文件夹以保存导出，无需共享表。"
          }
        }
      }
    },
    "Set arrival and departure times. After you save, the map jumps to the visit and its date range." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضبط أوقات الوصول والمغادرة. بعد الحفظ، تنتقل الخريطة إلى الزيارة ونطاقها الزمني."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আগমন এবং প্রস্থানের সময় সেট করুন। আপনি সংরক্ষণ করার পরে, মানচিত্রটি ভিজিট এবং এর তারিখের পরিসরে চলে যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set arrival and departure times. After you save, the map jumps to the visit and its date range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer horarios de llegada y salida. Después de guardar, el mapa salta a la visita y su rango de fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fixez les heures d’arrivée et de départ. Après avoir enregistré, la carte passe à la visite et à sa plage de dates."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आगमन और प्रस्थान का समय निर्धारित करें. आपके द्वारा सहेजने के बाद, मानचित्र विज़िट और उसकी तिथि सीमा पर पहुंच जाता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到着時刻と出発時刻を設定します。保存すると、マップは訪問とその日付範囲にジャンプします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ustaw godziny przyjazdu i wyjazdu. Po zapisaniu mapa przeskakuje do wizyty i jej zakresu dat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina horários de chegada e partida. Depois de salvar, o mapa salta para a visita e seu intervalo de datas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установите время прибытия и отбытия. После сохранения на карте отображается посещение и диапазон дат."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "设置到达和出发时间。保存后，地图会跳转到访问及其日期范围。"
          }
        }
      }
    },
