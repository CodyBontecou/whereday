    },
    "Import visits or points from JSON, CSV, or Markdown. KML, GPX, and GeoJSON are one-way map exports.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد الزيارات أو النقاط من JSON أو CSV أو Markdown. KML و GPX و GeoJSON هي عمليات تصدير للخرائط أحادية الاتجاه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON , CSV বা মার্কডাউন থেকে ভিজিট বা পয়েন্ট আমদানি করুন। KML , GPX , এবং GeoJSON হল একমুখী মানচিত্র রপ্তানি৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import visits or points from JSON, CSV, or Markdown. KML, GPX, and GeoJSON are one-way map exports."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa visitas o puntos desde JSON , CSV o Markdown. KML , GPX y GeoJSON son exportaciones de mapas unidireccionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez des visites ou des points depuis JSON , CSV ou Markdown. KML , GPX et GeoJSON sont des exportations de cartes unidirectionnelles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON , CSV , या Markdown से विज़िट या पॉइंट आयात करें। KML , GPX और GeoJSON एकतरफा मानचित्र निर्यात हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON 、 CSV 、または Markdown から訪問またはポイントをインポートします。 KML 、 GPX 、およびGeoJSONは一方向のマップ エクスポートです。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj wizyty lub punkty z JSON, CSV lub Markdown. KML, GPX i GeoJSON to jednokierunkowe eksporty map."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importe visitas ou pontos de JSON , CSV ou Markdown. KML , GPX e GeoJSON são exportações de mapas unidirecionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импортируйте посещения или баллы из JSON , CSV или Markdown. KML , GPX и GeoJSON — это односторонний экспорт карт."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从JSON 、 CSV或 Markdown 导入访问或积分。 KML 、 GPX和GeoJSON是单向地图导出。"
          }
        }
      }
    },
