    "Explore all matching photos in each group, or use Browse Photo Places to find locations beyond the markers currently shown on the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استكشف كل الصور المتطابقة في كل مجموعة، أو استخدم «تصفّح أماكن الصور» للعثور على مواقع غير العلامات الظاهرة حاليًا على الخريطة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore all matching photos in each group, or use Browse Photo Places to find locations beyond the markers currently shown on the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora todas las fotos asociadas de cada grupo o usa «Explorar lugares con fotos» para encontrar ubicaciones más allá de los marcadores que se muestran en el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez toutes les photos correspondantes de chaque groupe, ou utilisez Parcourir les lieux photo pour trouver des lieux au-delà des repères affichés sur la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各グループの一致する写真をすべて見るか、「写真のある場所を見る」で地図上のマーカー以外の場所も探せます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj wszystkie pasujące zdjęcia w każdej grupie lub otwórz listę miejsc ze zdjęciami, aby znaleźć lokalizacje poza znacznikami widocznymi na mapie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore todas as fotos associadas em cada grupo ou use Explorar lugares com fotos para encontrar locais além dos marcadores exibidos no mapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览每组中所有匹配的照片，或使用“浏览照片地点”查找地图当前标记以外的位置。"
          }
        }
      }
    },
