    },
    "No account. Nothing to sign up for.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا حساب. لا شيء للتسجيل فيه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account. Nothing to sign up for."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta. Sin registros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte. Aucune inscription."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウントも登録も不要です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conta. Nenhum cadastro."
          }
