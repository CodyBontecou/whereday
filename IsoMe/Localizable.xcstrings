    "Move, resize, change the kind of, or delete this saved place." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقل هذا المكان المحفوظ أو غيّر حجمه أو نوعه أو احذفه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই সংরক্ষিত জায়গা সরান, আকার বদলান, ধরন বদলান বা মুছে ফেলুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move, resize, change the kind of, or delete this saved place."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mueve, cambia el tamaño o el tipo, o elimina este lugar guardado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Déplacez, redimensionnez, changez le type ou supprimez ce lieu enregistré."
