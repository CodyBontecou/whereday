    "Notes stops and records route points about every 25 m. Continues until you pause." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يلاحظ التوقفات ويسجل نقاط الطريق كل 25 مترًا تقريبًا. يستمر حتى تتوقف."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "নোট স্টপ এবং প্রতি 25 মিটার রুট পয়েন্ট রেকর্ড. আপনি বিরতি না হওয়া পর্যন্ত চালিয়ে যান।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes stops and records route points about every 25 m. Continues until you pause."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toma nota de las paradas y registra los puntos de la ruta aproximadamente cada 25 m. Continúa hasta hacer una pausa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note les arrêts et enregistre les points d'itinéraire tous les 25 m environ. Continue jusqu'à ce que vous fassiez une pause."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "प्रत्येक 25 मीटर पर स्टॉप को नोट करता है और मार्ग बिंदुओं को रिकॉर्ड करता है। जब तक आप रुकते नहीं तब तक जारी रहता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes は約 25 メートルごとに停止し、ルート ポイントを記録します。一時停止するまで継続します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje przystanki i punkty trasy mniej więcej co 25 m. Kontynuuje, dopóki nie zrobisz pauzy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota paradas e registra pontos de rota a cada 25 m. Continua até você fazer uma pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает остановки и записывает точки маршрута примерно через каждые 25 метров. Продолжается до тех пор, пока вы не сделаете паузу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约每 25 m 记录一次停靠点并记录路线点。继续直到您暂停。"
          }
        }
      }
    },
    "Notes stops and records route points about every 100 m. Continues until you pause." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
