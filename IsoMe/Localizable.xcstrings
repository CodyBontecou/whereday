            "value" : "Registrar puntos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Points"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पॉइंट रिकॉर्ड करें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ポイントの記録"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuj punkty"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrar pontos"
          }
        },
