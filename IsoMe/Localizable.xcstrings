    "Unsupported file format. KML, GPX, GeoJSON, OwnTracks and Overland exports are one-way map files.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق ملف غير مدعوم. ملفات KML وGPX وGeoJSON وOwnTracks وOverland المصدّرة هي ملفات خرائط باتجاه واحد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported file format. KML, GPX, GeoJSON, OwnTracks and Overland exports are one-way map files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de archivo no compatible. Las exportaciones KML, GPX, GeoJSON, OwnTracks y Overland son archivos de mapa de solo exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format de fichier non pris en charge. Les exports KML, GPX, GeoJSON, OwnTracks et Overland sont des fichiers cartographiques à sens unique."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応していないファイル形式です。KML、GPX、GeoJSON、OwnTracks、Overlandの書き出しは一方向の地図ファイルです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de arquivo incompatível. Exportações KML, GPX, GeoJSON, OwnTracks e Overland são arquivos de mapa de mão única."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的文件格式。KML、GPX、GeoJSON、OwnTracks 和 Overland 导出文件是单向地图文件。"
          }
        }
      }
    },
