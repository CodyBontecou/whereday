    "7 days free, then %@ per week, automatically renewing until canceled." : {
      "comment" : "Seven-day free trial followed by a weekly auto-renewing subscription. %@ is StoreKit's localized price. Preserve trial length, weekly price, and renewal terms.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ أيام مجانًا، ثم %@ أسبوعيًا، مع تجديد تلقائي حتى الإلغاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "৭ দিন বিনামূল্যে, তারপর প্রতি সপ্তাহে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 days free, then %@ per week, automatically renewing until canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 días gratis, después %@ por semana, con renovación automática hasta que canceles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis %@ par semaine, avec renouvellement automatique jusqu’à résiliation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 दिन मुफ़्त, फिर प्रति सप्ताह %@, रद्द करने तक अपने-आप नवीनीकरण होगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間無料、その後は週額%@。キャンセルするまで自動更新されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 dni bez opłat, potem %@ za tydzień, z automatycznym odnawianiem do czasu anulowania."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 dias grátis, depois %@ por semana, com renovação automática até o cancelamento."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 дней бесплатно, затем %@ в неделю с автоматическим продлением до отмены."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费试用 7 天，之后每周 %@，自动续订，直至取消。"
          }
        }
      }
    },
    "7 days free, then %@ per year, automatically renewing until canceled." : {
      "comment" : "Seven-day free trial followed by a yearly auto-renewing subscription. %@ is StoreKit's localized price. Preserve trial length, annual price, and renewal terms.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "٧ أيام مجانًا، ثم %@ سنويًا، مع تجديد تلقائي حتى الإلغاء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "৭ দিন বিনামূল্যে, তারপর প্রতি বছরে %@, বাতিল না করা পর্যন্ত স্বয়ংক্রিয়ভাবে নবায়ন হবে।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 days free, then %@ per year, automatically renewing until canceled."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 días gratis, después %@ al año, con renovación automática hasta que canceles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 jours gratuits, puis %@ par an, avec renouvellement automatique jusqu’à résiliation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 दिन मुफ़्त, फिर प्रति वर्ष %@, रद्द करने तक अपने-आप नवीनीकरण होगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7日間無料、その後は年額%@。キャンセルするまで自動更新されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "7 dni bez opłat, potem %@ za rok, z automatycznym odnawianiem do czasu anulowania."
          }
        },
