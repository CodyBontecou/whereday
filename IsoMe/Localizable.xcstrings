    "Use name, latitude, longitude, address, and radius_meters columns. Address and radius are optional; the default radius is 150 meters. You can review the locations before importing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الأعمدة name وlatitude وlongitude وaddress وradius_meters. العنوان والنطاق اختياريان؛ النطاق الافتراضي 150 مترًا. يمكنك مراجعة المواقع قبل الاستيراد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "name, latitude, longitude, address ও radius_meters কলাম ব্যবহার করুন। ঠিকানা ও ব্যাসার্ধ ঐচ্ছিক; ডিফল্ট ব্যাসার্ধ 150 মিটার। আমদানির আগে অবস্থানগুলো পর্যালোচনা করতে পারবেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use name, latitude, longitude, address, and radius_meters columns. Address and radius are optional; the default radius is 150 meters. You can review the locations before importing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa las columnas name, latitude, longitude, address y radius_meters. La dirección y el radio son opcionales; el radio predeterminado es de 150 metros. Puedes revisar las ubicaciones antes de importar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les colonnes name, latitude, longitude, address et radius_meters. L’adresse et le rayon sont facultatifs ; le rayon par défaut est de 150 mètres. Vous pourrez vérifier les lieux avant l’importation."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "name, latitude, longitude, address और radius_meters कॉलम का उपयोग करें। पता और दायरा वैकल्पिक हैं; डिफ़ॉल्ट दायरा 150 मीटर है। आयात से पहले आप स्थानों की समीक्षा कर सकते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "name、latitude、longitude、address、radius_metersの列を使います。addressとradiusは任意で、半径の既定値は150メートルです。インポートする前に場所を確認できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj kolumn name, latitude, longitude, address i radius_meters. Adres i promień są opcjonalne; domyślny promień to 150 metrów. Przed importem możesz sprawdzić lokalizacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use as colunas name, latitude, longitude, address e radius_meters. Endereço e raio são opcionais; o raio padrão é de 150 metros. Você pode revisar os locais antes de importar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте столбцы name, latitude, longitude, address и radius_meters. Адрес и радиус необязательны; радиус по умолчанию — 150 метров. Перед импортом места можно проверить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 name、latitude、longitude、address 和 radius_meters 列。address 和 radius 为可选项；默认半径为 150 米。导入前可以先检查这些地点。"
          }
        }
      }
    },
