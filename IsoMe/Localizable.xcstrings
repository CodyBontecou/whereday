    "Send now posts the waiting points. Clear queue discards them without sending. Send all history posts all saved location data to the endpoint." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«إرسال الآن» يرسل النقاط المنتظرة. «مسح الطابور» يتجاهلها دون إرسال. «إرسال كل السجل» يرسل كل بيانات المواقع المحفوظة إلى نقطة النهاية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“এখনই পাঠান” অপেক্ষমাণ পয়েন্টগুলো পাঠায়। “কিউ খালি করুন” সেগুলো না পাঠিয়েই বাদ দেয়। “সব ইতিহাস পাঠান” সব সংরক্ষিত অবস্থানের ডেটা এন্ডপয়েন্টে পাঠায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send now posts the waiting points. Clear queue discards them without sending. Send all history posts all saved location data to the endpoint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar ahora envía los puntos en espera. Vaciar cola los descarta sin enviarlos. Enviar todo el historial envía todos los datos de ubicación guardados al endpoint."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoyer transmet les points en attente. Vider la file les supprime sans les envoyer. Envoyer tout l’historique transmet toutes les données de localisation enregistrées au point de terminaison."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"अभी भेजें\" प्रतीक्षारत पॉइंट भेजता है। \"कतार खाली करें\" उन्हें बिना भेजे हटा देता है। \"पूरा इतिहास भेजें\" सारा सहेजा गया स्थान डेटा एंडपॉइंट पर भेजता है।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今すぐ送信」で送信待ちのポイントを送ります。「キューを消去」は送信せずに破棄します。「すべての履歴を送信」は保存済みのすべての位置データをエンドポイントに送ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyślij teraz przesyła oczekujące punkty. Wyczyść kolejkę odrzuca je bez wysyłania. Wyślij całą historię przesyła wszystkie zapisane dane lokalizacji do punktu końcowego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar agora envia os pontos pendentes. Limpar fila descarta-os sem enviar. Enviar todo o histórico envia todos os dados de localização salvos ao endpoint."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Отправить сейчас» отправляет ожидающие точки. «Очистить очередь» удаляет их без отправки. «Отправить всю историю» отправляет все сохранённые данные о местоположении на конечную точку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“立即发送”会发布等待中的位置点。“清空队列”会直接丢弃它们而不发送。“发送全部历史”会将所有已保存的位置数据发布到端点。"
          }
        }
      }
    },
