    "Dates use the local time zone of each place. Unknown gaps stay empty — nothing is guessed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم التواريخ المنطقة الزمنية المحلية لكل مكان. تبقى الفجوات المجهولة فارغة — لا شيء يُخمَّن."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates use the local time zone of each place. Unknown gaps stay empty — nothing is guessed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fechas usan la zona horaria local de cada lugar. Los huecos desconocidos quedan vacíos: no se supone nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les dates suivent le fuseau horaire local de chaque lieu. Les périodes inconnues restent vides — rien n’est deviné."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付は各場所の現地時間で表示します。不明な空白は空のままで、推測はしません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As datas usam o fuso horário local de cada lugar. Lacunas desconhecidas ficam vazias — nada é presumido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期使用各地点的当地时区。未知的空缺保持为空——不做任何猜测。"
          }
        }
      }
    },
