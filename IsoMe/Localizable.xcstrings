            "value": "Enlaza un Apple Watch para grabar salidas desde tu muñeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez une Apple Watch pour enregistrer des sorties depuis votre poignet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手首から外出を記録するには、Apple Watchをペアリングしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
