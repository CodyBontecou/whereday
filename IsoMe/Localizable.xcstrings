    "Travel days count in both countries. %lld days have no record — tap one to add a stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُحتسب أيام السفر في الدولتين. %lld يوم بلا سجل — اضغط أحدها لإضافة إقامة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ভ্রমণের দিন দুই দেশেই গণনা হয়। %lld দিনের কোনো রেকর্ড নেই — অবস্থানকাল যোগ করতে একটিতে ট্যাপ করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Travel days count in both countries. %lld days have no record — tap one to add a stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los días de viaje cuentan en ambos países. Hay %lld días sin registro: toca uno para añadir una estancia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les jours de voyage comptent dans les deux pays. %lld jours sans données — touchez-en un pour ajouter un séjour."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यात्रा के दिन दोनों देशों में गिने जाते हैं। %lld दिनों का कोई रिकॉर्ड नहीं है — ठहराव जोड़ने के लिए किसी पर टैप करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "移動日は両方の国で数えます。記録のない日が%lld日あります。タップして滞在を追加できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dni w drodze liczą się w obu krajach. Dni bez zapisu: %lld — dotknij jednego, aby dodać pobyt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dias de viagem contam nos dois países. %lld dias não têm registro — toque em um para adicionar uma estadia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дни в пути учитываются в обеих странах. Дней без записи: %lld — коснитесь любого, чтобы добавить пребывание."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "旅行日会同时计入两个国家。有 %lld 天没有记录——轻点其中一天即可添加停留。"
          }
        }
      }
    },
