    "Start tracking from the Map tab or your Shortcuts automation. Visits and movement sessions will appear here by day.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ التتبع من علامة تبويب الخريطة أو من خلال أتمتة Shortcuts . ستظهر هنا جلسات الزيارات والحركة يوميًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মানচিত্র ট্যাব বা আপনার Shortcuts অটোমেশন থেকে ট্র্যাকিং শুরু করুন। পরিদর্শন এবং আন্দোলনের সেশনগুলি দিনে দিনে এখানে উপস্থিত হবে৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tracking from the Map tab or your Shortcuts automation. Visits and movement sessions will appear here by day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comience a rastrear desde la pestaña Mapa o la automatización de sus Shortcuts . Las visitas y sesiones de movimiento aparecerán aquí durante el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le suivi à partir de l'onglet Carte ou de votre automatisation Shortcuts . Des visites et des séances de déplacement apparaîtront ici de jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानचित्र टैब या अपने Shortcuts स्वचालन से ट्रैकिंग प्रारंभ करें। दौरे और आंदोलन सत्र यहां दिन-ब-दिन दिखाई देंगे।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "[マップ] タブまたはShortcutsオートメーションから追跡を開始します。訪問や移動セッションは日ごとにここに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij śledzenie na karcie Mapa lub przez automatyzację w Skrótach. Wizyty i przemieszczenia pojawią się tutaj w podziale na dni."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Comece o rastreamento na guia Mapa ou na automação Shortcuts . Visitas e sessões de movimento aparecerão aqui durante o dia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начните отслеживание на вкладке «Карта» или с помощью автоматизации Shortcuts . Днём здесь будут появляться посещения и сеансы движения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“地图”选项卡或Shortcuts ”自动化开始跟踪。参观和活动会议每天都会出现在这里。"
          }
        }
      }
    },
