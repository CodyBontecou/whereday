          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où la visite a eu lieu. Votre position GPS actuelle ne sera pas utilisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यात्रा कहाँ हुई। आपके वर्तमान GPS स्थान का उपयोग नहीं किया जाएगा."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "訪問が行われた場所を選択してください。現在のGPS位置情報は使用されません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz miejsce, w którym odbyła się wizyta. Twoja bieżąca lokalizacja GPS nie zostanie użyta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha onde a visita aconteceu. Sua localização GPS atual não será usada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите, где произошел визит. Ваше текущее местоположение GPS не будет использоваться."
          }
