    "Your existing free tracking access is preserved. Choose a plan to unlock export.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُحتفظ بوصولك المجاني الحالي إلى التتبع. اختر خطة لفتح التصدير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your existing free tracking access is preserved. Choose a plan to unlock export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservas tu acceso gratuito al seguimiento. Elige un plan para desbloquear la exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre accès gratuit au suivi est conservé. Choisissez une formule pour débloquer l’exportation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでの無料の追跡はそのまま使えます。書き出しを使うにはプランを選んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu acesso gratuito ao rastreamento foi mantido. Escolha um plano para liberar a exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现有的免费追踪权限会保留。选择方案以解锁导出。"
          }
        }
      }
    },
    "Choose a plan to track. Your existing records remain available to view and export.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر خطة للتتبع. تبقى سجلاتك الحالية متاحة للعرض والتصدير."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a plan to track. Your existing records remain available to view and export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un plan para usar el seguimiento. Tus registros existentes siguen disponibles para ver y exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une formule pour le suivi. Vos données existantes restent consultables et exportables."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡するにはプランを選んでください。これまでの記録は引き続き閲覧・書き出しができます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um plano para rastrear. Seus registros existentes continuam disponíveis para consulta e exportação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择方案以继续追踪。你现有的记录仍可查看和导出。"
          }
        }
      }
    },
