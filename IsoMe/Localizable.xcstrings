    "This permanently deletes all visits, location points, outings, saved places, photo matches and manual country stays. It can't be undone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف كل الزيارات ونقاط الموقع والنزهات والأماكن المحفوظة ومطابقات الصور والإقامات اليدوية في الدول نهائيًا. لا يمكن التراجع عن ذلك."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes all visits, location points, outings, saved places, photo matches and manual country stays. It can't be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán permanentemente todas las visitas, los puntos de ubicación, las salidas, los lugares guardados, las fotos asociadas y las estancias manuales en países. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les visites, points de localisation, sorties, lieux enregistrés, associations de photos et séjours manuels seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての訪問、位置ポイント、外出、保存した場所、写真の照合、手動の国の滞在が完全に削除されます。取り消すことはできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente todas as visitas, pontos de localização, passeios, lugares salvos, fotos associadas e estadias manuais em países. Não pode ser desfeito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将永久删除所有到访、位置点、出行、已保存的地点、照片匹配和手动国家停留。此操作无法撤销。"
          }
        }
      }
    },
    "Erase %@ of days from this iPhone?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محو %@ من الأيام من هذا الـ iPhone؟"
