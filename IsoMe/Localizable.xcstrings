    "%@ for the year. Cancel before then in Apple settings and you won't be charged.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "%@ للسنة. ألغِ قبل ذلك من إعدادات Apple ولن يتم تحصيل أي مبلغ."}},
        "bn": {"stringUnit": {"state": "translated", "value": "বছরে %@। এর আগে Apple সেটিংসে বাতিল করলে কোনো চার্জ হবে না।"}},
        "en": {"stringUnit": {"state": "translated", "value": "%@ for the year. Cancel before then in Apple settings and you won't be charged."}},
        "es": {"stringUnit": {"state": "translated", "value": "%@ al año. Cancela antes en los ajustes de Apple y no se te cobrará."}},
        "fr": {"stringUnit": {"state": "translated", "value": "%@ pour l’année. Annulez avant dans les réglages Apple et vous ne serez pas facturé."}},
        "hi": {"stringUnit": {"state": "translated", "value": "साल के लिए %@। उससे पहले Apple सेटिंग में रद्द करें, कोई शुल्क नहीं लगेगा।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "1年で%@。それまでにAppleの設定で解約すれば請求されません。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "%@ za rok. Anuluj wcześniej w ustawieniach Apple, a nie zostaniesz obciążony."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "%@ por ano. Cancele antes nos ajustes da Apple e você não será cobrado."}},
        "ru": {"stringUnit": {"state": "translated", "value": "%@ в год. Отмените заранее в настройках Apple — и плата не спишется."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "一年 %@。在此之前于 Apple 设置中取消，就不会扣费。"}}
      }
    },
    "Your yearly plan begins. Cancel before then in Apple settings and you won't be charged.": {
      "comment": "Carousel paywall.",
      "localizations": {
        "ar": {"stringUnit": {"state": "translated", "value": "تبدأ خطتك السنوية. ألغِ قبل ذلك من إعدادات Apple ولن يتم تحصيل أي مبلغ."}},
        "bn": {"stringUnit": {"state": "translated", "value": "আপনার বার্ষিক প্ল্যান শুরু হয়। এর আগে Apple সেটিংসে বাতিল করলে কোনো চার্জ হবে না।"}},
        "en": {"stringUnit": {"state": "translated", "value": "Your yearly plan begins. Cancel before then in Apple settings and you won't be charged."}},
        "es": {"stringUnit": {"state": "translated", "value": "Empieza tu plan anual. Cancela antes en los ajustes de Apple y no se te cobrará."}},
        "fr": {"stringUnit": {"state": "translated", "value": "Votre formule annuelle commence. Annulez avant dans les réglages Apple et vous ne serez pas facturé."}},
        "hi": {"stringUnit": {"state": "translated", "value": "आपका वार्षिक प्लान शुरू होता है। उससे पहले Apple सेटिंग में रद्द करें, कोई शुल्क नहीं लगेगा।"}},
        "ja": {"stringUnit": {"state": "translated", "value": "年額プランが始まります。それまでにAppleの設定で解約すれば請求されません。"}},
        "pl": {"stringUnit": {"state": "translated", "value": "Zaczyna się Twój plan roczny. Anuluj wcześniej w ustawieniach Apple, a nie zostaniesz obciążony."}},
        "pt-BR": {"stringUnit": {"state": "translated", "value": "Seu plano anual começa. Cancele antes nos ajustes da Apple e você não será cobrado."}},
        "ru": {"stringUnit": {"state": "translated", "value": "Начинается годовая подписка. Отмените заранее в настройках Apple — и плата не спишется."}},
        "zh-Hans": {"stringUnit": {"state": "translated", "value": "年订阅开始。在此之前于 Apple 设置中取消，就不会扣费。"}}
      }
    },
