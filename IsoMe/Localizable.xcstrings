            "value" : "All data stored locally. Never uploaded to any server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los datos almacenados localmente. Nunca subido a ningún servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les données sont stockées localement. Jamais envoyées à un serveur."
