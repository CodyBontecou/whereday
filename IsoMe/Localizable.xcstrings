    "This will permanently delete all visit data and location points. This action cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف جميع بيانات الزيارة ونقاط الموقع نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি স্থায়ীভাবে সমস্ত ভিজিট ডেটা এবং অবস্থান পয়েন্ট মুছে ফেলবে। এই ক্রিয়াটি পূর্বাবস্থায় ফেরানো যাবে না৷"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all visit data and location points. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto eliminará permanentemente todos los datos de visita y puntos de ubicación. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprimera définitivement toutes les données de visite et tous les points de localisation. Cette action ne peut pas être annulée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सभी विज़िट डेटा और स्थान बिंदुओं को स्थायी रूप से हटा देगा। इस एक्शन को वापस नहीं किया जा सकता।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これにより、すべての訪問データとロケーション ポイントが完全に削除されます。この操作は元に戻すことができません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie wszystkich danych dotyczących wizyt i punktów lokalizacji. Tej akcji nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente todos os dados de visita e pontos de localização. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это приведет к безвозвратному удалению всех данных о посещениях и точках местоположения. Это действие невозможно отменить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将永久删除所有访问数据和位置点。此操作无法撤消。"
          }
        }
      }
    },
    "This will permanently delete all visits, location points, and manual country stays. This action cannot be undone." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى حذف كل الزيارات ونقاط الموقع والإقامات اليدوية في الدول نهائيًا. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটি সব ভিজিট, অবস্থান পয়েন্ট ও দেশে ম্যানুয়াল অবস্থানকাল স্থায়ীভাবে মুছে ফেলবে। এই কাজটি পূর্বাবস্থায় ফেরানো যাবে না।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will permanently delete all visits, location points, and manual country stays. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se eliminarán permanentemente todas las visitas, los puntos de ubicación y las estancias manuales en países. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les visites, les points de localisation et les séjours manuels seront définitivement supprimés. Cette action est irréversible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे सभी विज़िट, स्थान बिंदु और देशों के मैन्युअल ठहराव स्थायी रूप से हट जाएँगे। यह कार्रवाई पूर्ववत नहीं की जा सकती।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての訪問、位置ポイント、手動の国の滞在が完全に削除されます。この操作は取り消せません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spowoduje to trwałe usunięcie wszystkich wizyt, punktów lokalizacji i ręcznie dodanych pobytów w krajach. Tej czynności nie można cofnąć."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso excluirá permanentemente todas as visitas, pontos de localização e estadias manuais em países. Esta ação não pode ser desfeita."
          }
        },
        "ru" : {
          "stringUnit" : {
