    "No qualifying purchase was found. Use the Apple Account that bought this app or its lifetime unlock, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُعثر على شراء مؤهِّل. استخدم حساب Apple الذي اشترى هذا التطبيق أو فتحه مدى الحياة، ثم حاول مجددًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যোগ্য কোনো কেনাকাটা পাওয়া যায়নি। যে Apple অ্যাকাউন্ট দিয়ে এই অ্যাপ বা এর আজীবন আনলক কেনা হয়েছে সেটি ব্যবহার করে আবার চেষ্টা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No qualifying purchase was found. Use the Apple Account that bought this app or its lifetime unlock, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró ninguna compra válida. Usa la cuenta de Apple con la que compraste esta app o su desbloqueo de por vida y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun achat éligible trouvé. Utilisez le compte Apple qui a acheté cette app ou son déblocage à vie, puis réessayez."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कोई योग्य ख़रीदारी नहीं मिली। वही Apple खाता इस्तेमाल करें जिससे यह ऐप या इसका लाइफ़टाइम अनलॉक ख़रीदा गया था, फिर कोशिश करें।"
