    "OUTING EXPORT" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصدير نزهة"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আউটিং এক্সপোর্ট"
          }
        },
        "en" : {
