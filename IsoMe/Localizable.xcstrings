          "stringUnit": {
            "state": "translated",
            "value": "Vuelves aquí una y otra vez. Guárdalo para poner nombre a sus próximas visitas y seguir su ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous revenez souvent ici. Enregistrez ce lieu pour nommer ses futures visites et suivre son rythme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何度もここに来ています。保存すると今後の訪問に名前が付き、訪れるリズムもわかります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você sempre volta aqui. Salve para dar nome às próximas visitas e acompanhar o ritmo delas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你常常回到这里。保存它，为今后的到访命名，并了解你来这里的规律。"
          }
        }
      }
    },
