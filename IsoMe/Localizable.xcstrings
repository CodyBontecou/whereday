    "Tracking is active. New movement will appear here after Whereday saves the first location point.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع نشط. ستظهر حركة جديدة هنا بعد أن يحفظ Whereday نقطة الموقع الأولى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাকিং সক্রিয়. Whereday প্রথম অবস্থান পয়েন্ট সংরক্ষণ করার পরে এখানে নতুন আন্দোলন প্রদর্শিত হবে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is active. New movement will appear here after Whereday saves the first location point."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento está activo. El nuevo movimiento aparecerá aquí después de que Whereday guarde el primer punto de ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi est actif. Un nouveau mouvement apparaîtra ici après Whereday ait enregistré le premier point de localisation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैकिंग सक्रिय है. Whereday पहला स्थान बिंदु सहेजने के बाद नया मूवमेंट यहां दिखाई देगा।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡はアクティブです。 Whereday最初の位置ポイントを保存した後、新しい動きがここに表示されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie jest aktywne. Nowe przemieszczenie pojawi się tutaj, gdy Whereday zapisze pierwszy punkt lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento está ativo. Um novo movimento aparecerá aqui depois que Whereday salvar o primeiro ponto de localização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание активно. Новое движение появится здесь после того, как Whereday сохранит первую точку локации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟踪处于活动状态。 Whereday保存第一个位置点后，新的运动将出现在此处。"
          }
        }
      }
    },
    "Tracking is free and unlimited. Choose an Individual or Family one-time purchase for data export.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع مجاني وغير محدود. اختر شراءً لمرة واحدة للفرد أو العائلة لتصدير البيانات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাকিং বিনামূল্যে ও সীমাহীন। ডেটা এক্সপোর্টের জন্য ইন্ডিভিজুয়াল বা ফ্যামিলি এককালীন কেনাকাটা বেছে নিন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is free and unlimited. Choose an Individual or Family one-time purchase for data export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El seguimiento es gratuito e ilimitado. Elige una compra única Individual o Familiar para exportar datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le suivi est gratuit et illimité. Choisissez un achat unique Individuel ou Famille pour exporter vos données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रैकिंग मुफ़्त और असीमित है। डेटा एक्सपोर्ट के लिए इंडिविजुअल या फ़ैमिली एकमुश्त खरीद चुनें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追跡は無料かつ無制限です。データの書き出しには個人向けまたはファミリー向けの買い切り版を選べます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Śledzenie jest bezpłatne i nieograniczone. Wybierz jednorazowy zakup indywidualny lub rodzinny do eksportu danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rastreamento é gratuito e ilimitado. Escolha uma compra única Individual ou Família para exportar dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отслеживание бесплатно и без ограничений. Для экспорта данных выберите разовую индивидуальную или семейную покупку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "位置记录免费且不限量。数据导出可选择个人或家庭一次性购买。"
          }
        }
      }
    },
    "Tracking is free and unlimited. Unlock data export with a one-time purchase.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التتبع مجاني وغير محدود. فتح تصدير البيانات من خلال عملية شراء لمرة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্র্যাকিং বিনামূল্যে এবং সীমাহীন. এককালীন কেনাকাটার মাধ্যমে ডেটা এক্সপোর্ট আনলক করুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracking is free and unlimited. Unlock data export with a one-time purchase."
          }
        },
        "es": {
