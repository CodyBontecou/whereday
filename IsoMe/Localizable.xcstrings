        }
      }
    },
    "Every day\nhas a story.": {
      "comment": "Welcome headline. Warm, understated travel-journal voice; adapt the line break naturally for each language.",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لكل يوم\nحكاية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি দিনের\nএকটি গল্প আছে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every day\nhas a story."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada día\ncuenta una historia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque jour\nraconte une histoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन की\nएक कहानी है।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日に、\n物語がある。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy dzień\nma swoją historię."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada dia\nconta uma história."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У каждого дня\nсвоя история."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一天，\n都有故事。"
          }
        }
      }
    },
    "Every place is listed here, even outside the visible map. Area annotations group places for rendering; they do not represent one shared location.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل مكان مُدرج هنا، حتى خارج الخريطة الظاهرة. تجمع تعليقات المناطق الأماكن لأغراض العرض؛ ولا تمثّل موقعًا مشتركًا واحدًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every place is listed here, even outside the visible map. Area annotations group places for rendering; they do not represent one shared location."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen todos los lugares, incluso fuera del mapa visible. Las anotaciones de zona agrupan lugares para mostrarlos; no representan una ubicación compartida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les lieux figurent ici, même hors de la zone visible de la carte. Les annotations de zone regroupent des lieux pour l’affichage ; elles ne représentent pas un emplacement commun."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示中の地図の外にあるものも含め、すべての場所をここに表示します。エリアの注釈は表示のために場所をまとめたもので、1つの共通の場所を表すものではありません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj znajdziesz wszystkie miejsca, także poza widocznym obszarem mapy. Znaczniki obszarów grupują miejsca na potrzeby wyświetlania; nie oznaczają jednej wspólnej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os lugares aparecem aqui, mesmo fora da área visível do mapa. As anotações de área agrupam lugares para exibição; elas não representam um único local compartilhado."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有地点都列在这里，包括可见地图以外的地点。区域标注仅用于分组显示地点，并不代表同一个位置。"
          }
        }
      }
    },
    "Existing purchasers can verify their purchase in Settings and sign in to myself.md to claim complimentary lifetime access.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن للمشترين الحاليين التحقق من شرائهم في الإعدادات وتسجيل الدخول إلى myself.md للحصول على وصول مجاني مدى الحياة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing purchasers can verify their purchase in Settings and sign in to myself.md to claim complimentary lifetime access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quienes ya hayan comprado pueden verificar su compra en Ajustes e iniciar sesión en myself.md para obtener acceso de por vida gratuito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les acheteurs existants peuvent vérifier leur achat dans Paramètres et se connecter à myself.md pour obtenir un accès à vie offert."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済みの方は、設定で購入を確認し、myself.mdにサインインすると、無料で永久アクセスを受け取れます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które już dokonały zakupu, mogą zweryfikować go w Ustawieniach i zalogować się do myself.md, aby odebrać bezpłatny dożywotni dostęp."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem já comprou pode verificar a compra nas Configurações e entrar no myself.md para resgatar o acesso vitalício gratuito."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已购买的用户可在设置中验证购买，然后登录 myself.md 领取免费终身权限。"
          }
        }
      }
    },
    "Existing purchasers receive complimentary lifetime access. Verify your purchase, then sign in to myself.md.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحصل المشترون الحاليون على وصول مجاني مدى الحياة. تحقّق من شرائك، ثم سجّل الدخول إلى myself.md."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Existing purchasers receive complimentary lifetime access. Verify your purchase, then sign in to myself.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quienes ya hayan comprado reciben acceso de por vida gratuito. Verifica tu compra y luego inicia sesión en myself.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les acheteurs existants bénéficient d’un accès à vie offert. Vérifiez votre achat, puis connectez-vous à myself.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "購入済みの方は無料で永久アクセスを受け取れます。購入を確認してから、myself.mdにサインインしてください。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osoby, które już dokonały zakupu, otrzymują bezpłatny dożywotni dostęp. Zweryfikuj zakup, a następnie zaloguj się do myself.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quem já comprou recebe acesso vitalício gratuito. Verifique sua compra e entre no myself.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已购买的用户可获得免费终身权限。请先验证购买，然后登录 myself.md。"
          }
        }
      }
    },
    "Expands session details.": {
      "localizations": {
        "ar": {
