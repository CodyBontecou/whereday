    "Review locations, invalid rows, and duplicates before importing. Keep existing locations or update matches." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "راجع المواقع والصفوف غير الصالحة والتكرارات قبل الاستيراد. أبقِ على المواقع الحالية أو حدّث المطابقات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আমদানির আগে অবস্থান, অবৈধ সারি ও ডুপ্লিকেট পর্যালোচনা করুন। বিদ্যমান অবস্থান রাখুন বা মিলগুলো আপডেট করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review locations, invalid rows, and duplicates before importing. Keep existing locations or update matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa ubicaciones, filas no válidas y duplicados antes de importar. Conserva las ubicaciones existentes o actualiza las coincidencias."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez les lieux, les lignes invalides et les doublons avant d’importer. Conservez les lieux existants ou mettez à jour les correspondances."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आयात से पहले स्थान, अमान्य पंक्तियाँ और डुप्लिकेट देखें। मौजूदा स्थान रखें या मिलते स्थान अपडेट करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インポートする前に、場所、無効な行、重複を確認してください。既存の場所を保持するか、一致する場所を更新できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź lokalizacje, nieprawidłowe wiersze i duplikaty przed importem. Zachowaj istniejące lokalizacje lub zaktualizuj dopasowane wpisy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise locais, linhas inválidas e duplicatas antes de importar. Mantenha os locais existentes ou atualize os correspondentes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяйте места, неверные строки и дубликаты перед импортом. Оставьте существующие места или обновите совпадения."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入前检查地点、无效行和重复项。可保留现有地点或更新匹配项。"
          }
        }
      }
    },
    "Review this visit as a calendar event." : {

    },
    "Review visits and movement sessions together by day, with quick controls for today, yesterday, and any date you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بمراجعة الزيارات وجلسات الحركة معًا يوميًا، مع عناصر تحكم سريعة لليوم والأمس وأي تاريخ تختاره."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আজকের, গতকাল এবং আপনার বেছে নেওয়া যেকোন তারিখের জন্য দ্রুত নিয়ন্ত্রণ সহ, দিনে একসাথে ভিজিট এবং মুভমেন্ট সেশন পর্যালোচনা করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Review visits and movement sessions together by day, with quick controls for today, yesterday, and any date you choose."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa juntas visitas y sesiones de movimiento por día, con controles rápidos para hoy, ayer y la fecha que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Passez en revue les visites et les séances de mouvement ensemble par jour, avec des contrôles rapides pour aujourd'hui, hier et toute date de votre choix."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आज, कल और आपके द्वारा चुनी गई किसी भी तारीख के लिए त्वरित नियंत्रण के साथ, दिन-प्रतिदिन विज़िट और मूवमेंट सत्रों की समीक्षा करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日、昨日、および選択した任意の日付のクイック コントロールを使用して、訪問と移動セッションを日ごとにまとめて確認します。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeglądaj wizyty i przemieszczenia razem w podziale na dni. Szybko wybieraj dzisiaj, wczoraj lub dowolną datę."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revise visitas e sessões de movimentação em conjunto por dia, com controles rápidos para hoje, ontem e qualquer data que você escolher."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просматривайте посещения и сеансы движения по дням с быстрым контролем за сегодня, вчера и любую выбранную вами дату."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每天一起查看访问和运动会话，并快速控制今天、昨天和您选择的任何日期。"
          }
        }
      }
    },
