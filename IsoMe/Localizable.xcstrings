    "You can also enter coordinates directly instead of using the map.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك أيضًا إدخال الإحداثيات مباشرةً بدلًا من استخدام الخريطة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can also enter coordinates directly instead of using the map."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "También puedes introducir coordenadas directamente en lugar de usar el mapa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez aussi saisir directement des coordonnées au lieu d’utiliser la carte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図を使わずに座標を直接入力することもできます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz też wpisać współrzędne bezpośrednio zamiast używać mapy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você também pode digitar as coordenadas diretamente em vez de usar o mapa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你也可以直接输入坐标，而不使用地图。"
          }
        }
      }
    },
    "You can grant permission later from the Settings tab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك منح الإذن لاحقًا من علامة التبويب \"الإعدادات\"."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সেটিংস ট্যাব থেকে পরে অনুমতি দিতে পারেন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can grant permission later from the Settings tab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede otorgar permiso más tarde desde la pestaña Configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez accorder l'autorisation ultérieurement à partir de l'onglet Paramètres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बाद में सेटिंग टैब से अनुमति दे सकते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後で [設定] タブから権限を付与できます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz udzielić pozwolenia później na karcie Ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode conceder permissão posteriormente na guia Configurações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете предоставить разрешение позже на вкладке «Настройки»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以稍后从“设置”选项卡授予权限。"
          }
        }
      }
    },
    "You can still add details manually": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال بإمكانك إضافة التفاصيل يدويًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি এখনও ম্যানুয়ালি বিবরণ যোগ করতে পারেন"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can still add details manually"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún puedes agregar detalles manualmente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez toujours ajouter des détails manuellement"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप अभी भी विवरण मैन्युअल रूप से जोड़ सकते हैं"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "詳細を手動で追加することもできます"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadal możesz dodawać szczegóły ręcznie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda pode adicionar detalhes manualmente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы по-прежнему можете добавить детали вручную."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您仍然可以手动添加详细信息"
          }
        }
      }
    },
    "You haven't moved yet today.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت لم تتحرك بعد اليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তুমি আজও সরে যাওনি।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You haven't moved yet today."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no te has movido hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous n'avez pas encore bougé aujourd'hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आज तक अभी तक स्थानांतरित नहीं हुए हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はまだ動いていません。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zarejestrowanego dystansu dzisiaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você ainda não se moveu hoje."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ты сегодня еще не переехал."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天你还没动呢。"
          }
        }
      }
    },
    "You've been tracking for %@.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد قمت بتتبع %@ ."
