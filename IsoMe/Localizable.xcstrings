    "No account. No server copy of where you've been." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بلا حساب. ولا نسخة على أي خادم من الأماكن التي كنت فيها."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো অ্যাকাউন্ট নেই। আপনি কোথায় গেছেন তার কোনো কপি সার্ভারে নেই।"
          }
        },
