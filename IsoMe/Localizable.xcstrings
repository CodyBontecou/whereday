          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota paradas e registra pontos de rota a cada 100 m. Continua até você fazer uma pausa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает остановки и записывает точки маршрута примерно через каждые 100 м. Продолжается до тех пор, пока вы не сделаете паузу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大约每 100 m 记录一次停靠点并记录路线点。继续直到您暂停。"
          }
        }
      }
    },
    "Notes where you stop. No path between. Lightest on battery." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجّل أماكن توقفك. لا مسار بينها. الأخف على البطارية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "যেখানে থামেন তা লিখে রাখে। মাঝের পথ নয়। ব্যাটারিতে সবচেয়ে হালকা।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes where you stop. No path between. Lightest on battery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota dónde paras, sin el recorrido entre medias. El que menos batería gasta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note là où vous vous arrêtez. Aucun tracé entre deux. Le plus économe en batterie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "जहाँ आप रुकते हैं वह दर्ज करता है। बीच का रास्ता नहीं। बैटरी पर सबसे हल्का।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "立ち寄った場所を記録します。間の経路は記録しません。バッテリー消費が最も少ない設定です。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapisuje miejsca postojów. Bez tras pomiędzy nimi. Najoszczędniejszy dla baterii."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anota onde você para. Sem caminho entre as paradas. O mais leve para a bateria."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отмечает, где вы останавливаетесь, без пути между ними. Меньше всего расходует заряд."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录你停留的地方，不记录之间的路径。最省电。"
          }
        }
      }
    },
    "Nothing has been recorded yet. Turn location on to start your first day." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُسجَّل شيء بعد. فعّل الموقع لبدء يومك الأول."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখনো কিছুই রেকর্ড হয়নি। প্রথম দিন শুরু করতে লোকেশন চালু করুন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing has been recorded yet. Turn location on to start your first day."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha registrado nada. Activa la ubicación para empezar tu primer día."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien n’a encore été enregistré. Activez la localisation pour commencer votre première journée."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अभी तक कुछ रिकॉर्ड नहीं हुआ। अपना पहला दिन शुरू करने के लिए स्थान चालू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ何も記録されていません。位置情報をオンにして、最初の1日を始めましょう。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nic jeszcze nie zarejestrowano. Włącz lokalizację, aby rozpocząć swój pierwszy dzień."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada foi registrado ainda. Ative a localização para começar seu primeiro dia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пока ничего не записано. Включите доступ к местоположению, чтобы начать первый день."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未记录任何内容。打开定位，开始你的第一天。"
          }
        }
      }
    },
    "NOTHING IS SAVED UNTIL YOU SAY SO" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يُحفظ شيء حتى تقرّر"
