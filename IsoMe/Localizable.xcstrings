    "GPS dots adjust to the visible map area and zoom level to keep large location histories responsive." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتكيّف نقاط GPS مع منطقة الخريطة الظاهرة ومستوى التكبير لإبقاء سجلات المواقع الكبيرة سريعة الاستجابة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বড় লোকেশন হিস্ট্রিও দ্রুত সাড়া দিতে GPS বিন্দু দৃশ্যমান মানচিত্র এলাকা ও জুম স্তর অনুযায়ী মানিয়ে নেয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GPS dots adjust to the visible map area and zoom level to keep large location histories responsive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puntos GPS se adaptan a la zona visible del mapa y al nivel de zoom para que los historiales de ubicación grandes sigan respondiendo con fluidez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les points GPS s’adaptent à la zone visible et au niveau de zoom pour que les longs historiques restent réactifs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बड़े स्थान इतिहास को तेज़ रखने के लिए GPS बिंदु दिखाई दे रहे मानचित्र क्षेत्र और ज़ूम स्तर के अनुसार बदलते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "大量の位置履歴でも快適に動くよう、GPSのドットが表示範囲とズームに合わせて調整されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Punkty GPS dostosowują się do widocznego obszaru i powiększenia mapy, dzięki czemu nawet duże historie lokalizacji działają płynnie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os pontos GPS se ajustam à área visível e ao nível de zoom do mapa para manter ágeis os históricos de localização grandes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Точки GPS подстраиваются под видимую область карты и масштаб, чтобы большая история местоположений оставалась отзывчивой."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
