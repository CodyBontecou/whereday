        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নির্ধারিত Whereday এক্সপোর্ট চালানোর জন্য আলতো চাপুন যদি এটি সম্পূর্ণ না হয়।"
