    "Its visits, typical stay, and weekly rhythm appear here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظهر هنا زياراته ومدة الإقامة المعتادة وإيقاعه الأسبوعي."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এর ভিজিট, সাধারণ অবস্থানকাল ও সাপ্তাহিক ছন্দ এখানে দেখা যায়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Its visits, typical stay, and weekly rhythm appear here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen sus visitas, la estancia habitual y el ritmo semanal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses visites, son séjour type et son rythme hebdomadaire apparaissent ici."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इसकी विज़िट, सामान्य ठहराव और साप्ताहिक लय यहाँ दिखती हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訪問、いつもの滞在時間、1週間のリズムがここに表示されます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutaj pojawią się jego wizyty, typowy pobyt i tygodniowy rytm."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As visitas, a estadia típica e o ritmo semanal aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Здесь появятся его посещения, обычное пребывание и недельный ритм."
