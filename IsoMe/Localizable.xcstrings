    "Data is only sent when you tap \"Send Now\" below.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتم إرسال البيانات إلا عند النقر على \"إرسال الآن\" أدناه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি নীচে \"এখনই পাঠান\" ট্যাপ করলেই ডেটা পাঠানো হয়৷"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Data is only sent when you tap \"Send Now\" below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos solo se envían cuando tocas \"Enviar ahora\" a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données ne sont envoyées que lorsque vous appuyez sur « Envoyer maintenant » ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेटा केवल तभी भेजा जाता है जब आप नीचे \"अभी भेजें\" पर टैप करते हैं।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "データは、下の「今すぐ送信」をタップした場合にのみ送信されます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane zostaną wysłane dopiero po kliknięciu „Wyślij teraz” poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dados só são enviados quando você toca em \"Enviar agora\" abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные отправляются только тогда, когда вы нажимаете «Отправить сейчас» ниже."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅当您点击下面的“立即发送”时才会发送数据。"
          }
        }
      }
    },
