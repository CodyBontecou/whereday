    "Allow Always" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماح دائمًا"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“সর্বদা” অনুমতি দিন"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Always"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir siempre"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autoriser Toujours"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"हमेशा\" की अनुमति दें"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に」を許可"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zezwól: Zawsze"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permitir Sempre"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешить «Всегда»"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终允许"
          }
        }
      }
    },
    "Allow Always so the day records around the clock, even in your pocket." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «دائمًا» ليُسجَّل اليوم على مدار الساعة، حتى والهاتف في جيبك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“সর্বদা” অনুমতি দিন, যাতে দিনটি চব্বিশ ঘন্টা রেকর্ড হয়, পকেটে থাকলেও।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Always so the day records around the clock, even in your pocket."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Siempre para que el día se registre a todas horas, incluso con el teléfono en el bolsillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Toujours pour que la journée s’enregistre en continu, même téléphone en poche."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"हमेशा\" की अनुमति दें ताकि दिन चौबीसों घंटे रिकॉर्ड हो, जेब में फ़ोन होने पर भी।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「常に」を許可すると、ポケットの中でも1日中記録できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz Zawsze, aby dzień rejestrował się przez całą dobę, nawet gdy telefon jest w kieszeni."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita Sempre para o dia ser registrado o tempo todo, mesmo no seu bolso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите «Всегда», чтобы день записывался круглосуточно, даже когда телефон в кармане."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“始终”，让这一天全天候记录，即使手机在口袋里。"
          }
        }
      }
    },
    "Allow Always so Whereday records when it's closed. You can change this anytime." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر «دائمًا» ليسجّل Whereday حتى عندما يكون مغلقًا. يمكنك تغيير ذلك في أي وقت."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“সর্বদা” অনুমতি দিন, যাতে অ্যাপ বন্ধ থাকলেও Whereday রেকর্ড করে। যেকোনো সময় এটি বদলাতে পারবেন।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allow Always so Whereday records when it's closed. You can change this anytime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite Siempre para que Whereday grabe aunque esté cerrada. Puedes cambiarlo cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez Toujours pour que Whereday enregistre même lorsqu’il est fermé. Vous pouvez modifier ce choix à tout moment."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"हमेशा\" की अनुमति दें ताकि Whereday बंद होने पर भी रिकॉर्ड करे। आप इसे कभी भी बदल सकते हैं।"
          }
        },
