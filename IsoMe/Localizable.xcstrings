          }
        }
      }
    },
    "Tap to retry your scheduled Whereday export.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر لإعادة محاولة تصدير Whereday المجدول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নির্ধারিত Whereday এক্সপোর্ট পুনরায় চেষ্টা করতে আলতো চাপুন।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to retry your scheduled Whereday export."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para volver a intentar su exportación Whereday programada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez pour réessayer votre exportation Whereday programmée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने निर्धारित Whereday निर्यात का पुनः प्रयास करने के लिए टैप करें।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして、スケジュールされたWheredayエクスポートを再試行します。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij, aby ponowić zaplanowaną próbę eksportu Whereday"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para tentar novamente a exportação Whereday agendada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы повторить запланированный экспорт Whereday"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击可重试计划的Whereday导出。"
          }
        }
      }
    },
