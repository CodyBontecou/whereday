    "Preview and import one Google Timeline JSON or Whereday JSON, CSV, or Markdown file. Duplicate visits and points are skipped." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عاين واستورد ملفًا واحدًا بتنسيق Google Timeline JSON أو Whereday JSON أو CSV أو Markdown. تُتخطّى الزيارات والنقاط المكرّرة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি Google Timeline JSON অথবা Whereday JSON, CSV বা Markdown ফাইলের পূর্বরূপ দেখে আমদানি করুন। ডুপ্লিকেট ভিজিট ও পয়েন্ট বাদ দেওয়া হয়।"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preview and import one Google Timeline JSON or Whereday JSON, CSV, or Markdown file. Duplicate visits and points are skipped."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Previsualiza e importa un archivo JSON de Google Timeline o un archivo JSON, CSV o Markdown de Whereday. Las visitas y los puntos duplicados se omiten."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prévisualisez et importez un fichier JSON Google Timeline, ou un fichier JSON, CSV ou Markdown de Whereday. Les visites et points en double sont ignorés."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक Google Timeline JSON या Whereday JSON, CSV या Markdown फ़ाइल का पूर्वावलोकन करें और आयात करें। डुप्लिकेट विज़िट और पॉइंट छोड़ दिए जाते हैं।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "GoogleタイムラインのJSON、またはWheredayのJSON、CSV、Markdownファイルを1つプレビューしてインポートします。重複した訪問とポイントはスキップされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetl podgląd i zaimportuj jeden plik JSON z Google Timeline albo plik JSON, CSV lub Markdown z Whereday. Powtarzające się wizyty i punkty są pomijane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visualize e importe um arquivo JSON do Google Timeline ou um arquivo JSON, CSV ou Markdown do Whereday. Visitas e pontos duplicados são ignorados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Просмотрите и импортируйте один файл Google Timeline JSON или Whereday JSON, CSV или Markdown. Повторяющиеся посещения и точки пропускаются."
          }
        },
