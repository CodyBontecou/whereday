    "Exports save directly to this folder when auto-save is on. Otherwise the share sheet opens.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير الحفظ مباشرة إلى هذا المجلد عند تشغيل الحفظ التلقائي. وإلا سيتم فتح ورقة المشاركة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বয়ংক্রিয়-সংরক্ষণ চালু থাকলে রপ্তানিগুলি সরাসরি এই ফোল্ডারে সংরক্ষণ করে৷ অন্যথায় শেয়ার শীট খোলে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports save directly to this folder when auto-save is on. Otherwise the share sheet opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las exportaciones se guardan directamente en esta carpeta cuando el guardado automático está activado. De lo contrario, se abre la hoja para compartir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exportations sont enregistrées directement dans ce dossier lorsque l'enregistrement automatique est activé. Sinon, la feuille de partage s'ouvre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑटो-सेव चालू होने पर सेव को सीधे इस फ़ोल्डर में निर्यात किया जाता है। अन्यथा शेयर शीट खुल जाती है."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動保存がオンになっている場合、エクスポートはこのフォルダーに直接保存されます。それ以外の場合は、共有シートが開きます。"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksportuje zapis bezpośrednio do tego folderu, gdy włączone jest automatyczne zapisywanie. W przeciwnym razie otworzy się arkusz udostępniania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As exportações são salvas diretamente nesta pasta quando o salvamento automático está ativado. Caso contrário, a planilha de compartilhamento será aberta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспортирует сохранения непосредственно в эту папку, если автосохранение включено. В противном случае откроется лист общего доступа."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当自动保存打开时，导出直接保存到此文件夹。否则共享表将打开。"
          }
        }
      }
    },
    "Exports this outing in the selected format.": {
